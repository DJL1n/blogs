---
import BaseLayout from './BaseLayout.astro';

const { post, headings = [], readingTime = 0, Content, relatedPosts = [] } = Astro.props as {
  post: {
    data: {
      title: string;
      summary: string;
      updated: Date;
      category: string;
      importance: number;
      tags: string[];
      relatedNotes?: string[];
      type: string;
    };
    body: string;
  };
  headings: Array<{ text: string; depth: number; slug: string }>;
  readingTime: number;
  Content: any;
  relatedPosts?: Array<{
    title: string;
    summary: string;
    collection: string;
    slug: string;
    href: string;
  }>;
};

const hasToc = headings.length > 0;
const tocEntries = headings.filter((item) => item.depth > 0 && item.slug);
const bodyForEditor =
  (post.body || '').length > 6000 ? '' : encodeURIComponent(post.body || '');
const editorQuery = bodyForEditor
  ? `&body=${bodyForEditor}&bodyMode=source`
  : '';
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <section class={`post-shell post-layout-grid ${hasToc ? 'has-toc' : ''}`}>
    <article class="article-column reading-shell mx-auto min-w-0">
      <header class="post-hero liquid-panel reveal" data-liquid-panel>
        <div class="post-meta-chips">
          <span class="chip">{post.data.updated.toLocaleDateString('zh-CN')} 更新</span>
          <span class="chip">{post.data.category}</span>
          <span class="chip">{post.data.type}</span>
          <span class="chip">重要性 {post.data.importance}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p>{post.data.summary}</p>
        <div class="post-hero-footer">
          <span class="system-badge">预计 {readingTime} 分钟阅读</span>
          <a
            href={`/editor?type=${post.data.type === 'note' ? 'note' : post.data.type}&title=${encodeURIComponent(post.data.title)}&summary=${encodeURIComponent(post.data.summary)}&category=${encodeURIComponent(post.data.category)}&tags=${encodeURIComponent(post.data.tags.join(', '))}&importance=${encodeURIComponent(String(post.data.importance))}${editorQuery}`}
            class="btn-secondary magnetic"
          >
            进入编辑模式
          </a>
        </div>
        <div class="post-tag-row" aria-label="文章标签">
          {post.data.tags.length > 0 ? (
            post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag.toLowerCase())}`} class="chip">#{tag}</a>)
          ) : (
            <span class="empty-copy">未标注标签</span>
          )}
        </div>
      </header>

      {relatedPosts.length > 0 && (
        <section class="related-panel liquid-panel reveal reveal-delay-1" data-liquid-panel>
          <div class="panel-heading">
            <div>
              <p class="panel-eyebrow">Related</p>
              <h2>论文关联</h2>
            </div>
          </div>
          <ul>
            {relatedPosts.map((item) => (
              <li>
                <a href={item.href}>{item.title}</a>
                <span class="chip">{item.collection}</span>
                <p>{item.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div id="post-content" class="article-prose prose prose-slate dark:prose-invert relative reveal reveal-delay-2">
        <Content />
      </div>
    </article>

    {
      hasToc ? (
        <aside class="post-toc">
          <div class="decoration-sphere" id="decoration-sphere"></div>
          <p class="panel-eyebrow">Outline</p>
          <h2>目录</h2>
          <ul>
            {tocEntries.map((item) => (
              <li class={`${item.depth >= 3 ? 'toc-nested' : ''}`}>
                <a href={`#${item.slug}`} data-toc-link={item.slug}>
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      ) : (
        <aside class="post-toc post-toc--empty" aria-hidden="true">
          <div class="decoration-sphere" id="decoration-sphere"></div>
        </aside>
      )
    }
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const root = document.querySelector('#post-content');
    if (!root) return;

    root.querySelectorAll('pre').forEach((pre) => {
      pre.classList.add('relative');
      if (pre.querySelector('.copy-code-btn')) return;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = '复制';
      btn.className = 'copy-code-btn';
      btn.addEventListener('click', async () => {
        const code = pre.textContent || '';
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = '已复制';
          window.setTimeout(() => (btn.textContent = '复制'), 1100);
        } catch (err) {
          btn.textContent = '复制失败';
          window.setTimeout(() => (btn.textContent = '复制'), 1100);
        }
      });

      pre.appendChild(btn);
    });

    const tocLinks = Array.from(document.querySelectorAll('.post-toc a[data-toc-link]'));
    const headings = Array.from(root.querySelectorAll('h2[id], h3[id], h4[id], h5[id], h6[id]'));
    if (!tocLinks.length || !headings.length) return;

    const linkById = new Map(
      tocLinks.map((link) => [link.getAttribute('data-toc-link'), link])
    );
    let currentId = '';

    function setActive(id) {
      if (id === currentId) return;
      currentId = id;
      tocLinks.forEach((link) => {
        const match = link.getAttribute('data-toc-link') === id;
        link.classList.toggle('is-active', match);
        if (match) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });

      // Scroll TOC to keep active item centered
      const link = linkById.get(id);
      if (link instanceof HTMLElement) {
        const toc = link.closest('.post-toc');
        if (toc instanceof HTMLElement) {
          toc.scrollTop = Math.max(0, link.offsetTop + link.offsetHeight / 2 - toc.clientHeight / 2);
        }
      }
    }

    function onScroll() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = Math.min(1, Math.max(0, scrollTop / docHeight));

      // Map scroll progress to heading index
      const idx = Math.min(headings.length - 1, Math.floor(progress * headings.length));
      setActive(headings[idx].id);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

<script is:inline>
  const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  (async function initSphereCluster() {
    const container = document.getElementById('decoration-sphere');
    if (!container || window.matchMedia('(max-width: 1200px)').matches || rm) return;

    const THREE = await import('three');

    function isDark() { return document.documentElement.classList.contains('dark'); }

    const rect = container.getBoundingClientRect();
    if (rect.width < 50 || rect.height < 50) return;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(40, rect.width / rect.height, 0.1, 20);
    camera.position.set(0, 0.3, 3.6);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(rect.width, rect.height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.0;
    container.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight('#ffffff', 0.5));
    const dir = new THREE.DirectionalLight('#ffffff', 0.8);
    dir.position.set(2, 3, 4); scene.add(dir);
    const back = new THREE.DirectionalLight('#38bdf8', 0.3);
    back.position.set(-2, -1, -3); scene.add(back);

    // ── Sphere cluster (Fibonacci distribution) ──
    const count = 80;
    const clusterR = 1.0;
    const geo = new THREE.SphereGeometry(0.08, 8, 6);
    const spheres: THREE.Mesh[] = [];
    const basePos: { x: number; y: number; z: number }[] = [];

    const phi = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < count; i++) {
      const y = 1 - (i / (count - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const theta = phi * i;
      const p = { x: clusterR * r * Math.cos(theta), y: clusterR * y, z: clusterR * r * Math.sin(theta) };
      basePos.push(p);

      const mat = new THREE.MeshStandardMaterial({
        color: isDark() ? '#4b5563' : '#93c5fd',
        roughness: 0.25, metalness: 0.15,
        transparent: true, opacity: 0.7,
      });
      const m = new THREE.Mesh(geo, mat);
      m.position.set(p.x, p.y, p.z);
      spheres.push(m);
    }

    const group = new THREE.Group();
    spheres.forEach((s) => group.add(s));
    scene.add(group);

    // ── Raycaster hover ──
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();
    let hoverId = -1;

    container.addEventListener('pointermove', (e) => {
      const r = container.getBoundingClientRect();
      pointer.x = ((e.clientX - r.left) / r.width) * 2 - 1;
      pointer.y = -((e.clientY - r.top) / r.height) * 2 + 1;
      raycaster.setFromCamera(pointer, camera);
      const hits = raycaster.intersectObjects(spheres);
      hoverId = hits.length > 0 ? spheres.indexOf(hits[0].object as THREE.Mesh) : -1;
    }, { passive: true });

    container.addEventListener('pointerleave', () => { hoverId = -1; }, { passive: true });

    // ── Observers ──
    const themeObs = new MutationObserver(() => {
      const c = isDark() ? '#4b5563' : '#93c5fd';
      spheres.forEach((s, i) => { if (i !== hoverId) (s.material as THREE.MeshStandardMaterial).color.set(c); });
    });
    themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    const resizeObs = new ResizeObserver(() => {
      const r = container.getBoundingClientRect();
      if (r.width < 50 || r.height < 50) return;
      camera.aspect = r.width / r.height; camera.updateProjectionMatrix();
      renderer.setSize(r.width, r.height);
    });
    resizeObs.observe(container);

    let sceneActive = true;
    const visObs = new IntersectionObserver(([e]) => { sceneActive = e.isIntersecting; }, { threshold: 0.1 });
    visObs.observe(container);

    // ── Animation ──
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      if (!sceneActive) { renderer.render(scene, camera); return; }

      const t = clock.getElapsedTime();
      group.rotation.y += 0.004;
      group.rotation.x = Math.sin(t * 0.08) * 0.08;

      const normalC = isDark() ? '#4b5563' : '#93c5fd';
      spheres.forEach((s, i) => {
        const isHover = i === hoverId;
        const targetScale = isHover ? 2.5 : 1;
        const sc = s.scale.x + (targetScale - s.scale.x) * 0.08;
        s.scale.set(sc, sc, sc);
        (s.material as THREE.MeshStandardMaterial).color.set(isHover ? '#14b8a6' : normalC);
      });

      renderer.render(scene, camera);
    }
    animate();
  })();
</script>

<style>
  .post-layout-grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: minmax(0, 70ch) 16rem;
    justify-content: center;
    align-items: start;
  }

  .article-column {
    display: grid;
    gap: 1.2rem;
  }

  .post-hero {
    padding: clamp(1.2rem, 4vw, 2rem);
  }

  .post-meta-chips,
  .post-tag-row,
  .post-hero-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
  }

  .post-hero h1 {
    margin: 0.85rem 0 0;
    color: rgb(15 23 42);
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    font-weight: 950;
    line-height: 1;
    letter-spacing: 0;
  }

  .post-hero p {
    margin: 1rem 0 0;
    color: rgb(71 85 105);
    font-size: 1rem;
    line-height: 1.85;
  }

  .post-hero-footer {
    justify-content: space-between;
    margin-top: 1.2rem;
  }

  .post-tag-row {
    margin-top: 1rem;
  }

  .article-prose {
    max-width: none;
    padding: 0.25rem 0.1rem 0;
  }

  .related-panel {
    padding: 1.1rem;
  }

  .related-panel ul {
    display: grid;
    gap: 0.82rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-panel li {
    display: grid;
    gap: 0.38rem;
  }

  .related-panel a {
    color: rgb(15 23 42);
    font-size: 0.95rem;
    font-weight: 850;
    text-decoration: none;
  }

  .related-panel a:hover {
    color: rgb(15 118 110);
  }

  .related-panel p {
    margin: 0;
    color: rgb(100 116 139);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  /* ── TOC: slim floating indicator ── */
  .post-toc {
    position: sticky;
    top: 5.5rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    padding: 0.5rem 0;
    background: none;
    border: none;
    box-shadow: none;
    backdrop-filter: none;
    scroll-behavior: smooth;
  }
  .post-toc::-webkit-scrollbar { display: none; }

  .post-toc h2 {
    display: none;
  }

  .post-toc ul {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-toc a {
    display: block;
    padding: 0.25rem 0.3rem 0.25rem 0.6rem;
    color: rgb(148 163 184);
    text-decoration: none;
    border-left: 1.5px solid rgb(226 232 240);
    font-size: 0.78rem;
    font-weight: 400;
    transition: all 0.2s ease;
    line-height: 1.3;
  }

  /* Active: larger, bolder, with accent bar */
  .post-toc a.is-active {
    color: rgb(15 118 110);
    border-left-color: rgb(20 184 166);
    border-left-width: 2.5px;
    font-size: 0.92rem;
    font-weight: 700;
    padding-top: 0.4rem;
    padding-bottom: 0.4rem;
  }

  .toc-nested a {
    padding-left: 1.2rem;
    font-size: 0.7rem;
  }
  .toc-nested a.is-active {
    font-size: 0.82rem;
  }

  .post-toc a:not(.is-active):hover {
    color: rgb(71 85 105);
    border-left-color: rgb(148 163 184);
  }

  /* ── Decoration sphere ── */
  .decoration-sphere {
    width: 100%;
    height: 180px;
    position: relative;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }
  .decoration-sphere canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .post-toc--empty {
    position: sticky;
    top: 5.5rem;
    border: none;
    background: none;
    box-shadow: none;
    padding: 0;
    display: flex;
    align-items: flex-start;
  }

  /* ── Dark mode ── */
  :global(.dark) .post-hero h1,
  :global(.dark) .related-panel a {
    color: rgb(248 250 252);
  }
  :global(.dark) .post-hero p {
    color: rgb(203 213 225);
  }
  :global(.dark) .post-toc a {
    color: rgb(71 85 105);
    border-left-color: rgb(51 65 85);
  }
  :global(.dark) .post-toc a:not(.is-active):hover {
    color: rgb(148 163 184);
    border-left-color: rgb(100 116 139);
  }
  :global(.dark) .post-toc a.is-active {
    color: rgb(94 234 212);
    border-left-color: rgb(94 234 212);
  }
  :global(.dark) .related-panel a:hover {
    color: rgb(94 234 212);
  }
  :global(.dark) .related-panel p {
    color: rgb(148 163 184);
  }

  @media (max-width: 1200px) {
    .post-toc { display: none; }
  }

  @media (max-width: 620px) {
    .post-hero-footer {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
