---
import BaseLayout from './BaseLayout.astro';

const { post, headings = [], readingTime = 0, Content, relatedPosts = [] } = Astro.props as {
  post: {
    data: {
      title: string;
      summary: string;
      updated: Date;
      category: string;
      importance: number;
      tags: string[];
      relatedNotes?: string[];
      type: string;
    };
    body: string;
  };
  headings: Array<{ text: string; depth: number; slug: string }>;
  readingTime: number;
  Content: any;
  relatedPosts?: Array<{
    title: string;
    summary: string;
    collection: string;
    slug: string;
    href: string;
  }>;
};

const hasToc = headings.length > 0;
const tocEntries = headings.filter((item) => item.depth > 0 && item.slug);
const bodyForEditor =
  (post.body || '').length > 6000 ? '' : encodeURIComponent(post.body || '');
const editorQuery = bodyForEditor
  ? `&body=${bodyForEditor}&bodyMode=source`
  : '';
---

<BaseLayout title={post.data.title} description={post.data.summary} shellless>
  <section class={`post-shell post-layout-grid ${hasToc ? 'has-toc' : ''}`}>
    <article class="article-column reading-shell mx-auto min-w-0">
      <header class="post-hero card reveal">
        <div class="post-meta-chips">
          <span class="chip">{post.data.updated.toLocaleDateString('zh-CN')} 更新</span>
          <span class="chip">{post.data.category}</span>
          <span class="chip">{post.data.type}</span>
          <span class="chip">重要性 {post.data.importance}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p>{post.data.summary}</p>
        <div class="post-hero-footer">
          <span class="system-badge">预计 {readingTime} 分钟阅读</span>
          <a
            href={`/editor?type=${post.data.type === 'note' ? 'note' : post.data.type}&title=${encodeURIComponent(post.data.title)}&summary=${encodeURIComponent(post.data.summary)}&category=${encodeURIComponent(post.data.category)}&tags=${encodeURIComponent(post.data.tags.join(', '))}&importance=${encodeURIComponent(String(post.data.importance))}${editorQuery}`}
            class="btn-secondary"
          >
            进入编辑模式
          </a>
        </div>
        <div class="post-tag-row" aria-label="文章标签">
          {post.data.tags.length > 0 ? (
            post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag.toLowerCase())}`} class="chip">#{tag}</a>)
          ) : (
            <span class="empty-copy">未标注标签</span>
          )}
        </div>
      </header>

      {relatedPosts.length > 0 && (
        <section class="related-panel card reveal reveal-delay-1">
          <div class="panel-heading">
            <div>
              <p class="panel-eyebrow">Related</p>
              <h2>论文关联</h2>
            </div>
          </div>
          <ul>
            {relatedPosts.map((item) => (
              <li>
                <a href={item.href}>{item.title}</a>
                <span class="chip">{item.collection}</span>
                <p>{item.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="reading-progress-bar" id="reading-progress" aria-hidden="true"></div>

      <div id="post-content" class="article-prose prose prose-slate dark:prose-invert relative reveal reveal-delay-2">
        <Content />
      </div>
    </article>

    {
      hasToc && (
        <aside class="post-toc">
          <p class="panel-eyebrow">Outline</p>
          <h2>目录</h2>
          <ul>
            {tocEntries.map((item) => (
              <li class={`${item.depth >= 3 ? 'toc-nested' : ''}`}>
                <a href={`#${item.slug}`} data-toc-link={item.slug}>
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const root = document.querySelector('#post-content');
    if (!root) return;

    root.querySelectorAll('pre').forEach((pre) => {
      pre.classList.add('relative');
      if (pre.querySelector('.copy-code-btn')) return;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = '复制';
      btn.className = 'copy-code-btn';
      btn.addEventListener('click', async () => {
        const code = pre.textContent || '';
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = '已复制';
          window.setTimeout(() => (btn.textContent = '复制'), 1100);
        } catch (err) {
          btn.textContent = '复制失败';
          window.setTimeout(() => (btn.textContent = '复制'), 1100);
        }
      });

      pre.appendChild(btn);
    });

    const tocLinks = Array.from(document.querySelectorAll('.post-toc a[data-toc-link]'));
    const headings = Array.from(root.querySelectorAll('h2[id], h3[id], h4[id], h5[id], h6[id]'));
    if (!tocLinks.length || !headings.length) return;

    const linkById = new Map(
      tocLinks.map((link) => [link.getAttribute('data-toc-link'), link])
    );
    let currentId = '';

    function setActive(id) {
      if (id === currentId) return;
      currentId = id;
      tocLinks.forEach((link) => {
        const match = link.getAttribute('data-toc-link') === id;
        link.classList.toggle('is-active', match);
        if (match) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });

      // Scroll TOC to keep active item centered
      const link = linkById.get(id);
      if (link instanceof HTMLElement) {
        const toc = link.closest('.post-toc');
        if (toc instanceof HTMLElement) {
          toc.scrollTop = Math.max(0, link.offsetTop + link.offsetHeight / 2 - toc.clientHeight / 2);
        }
      }
    }

    function onScroll() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = Math.min(1, Math.max(0, scrollTop / docHeight));

      // Update reading progress bar
      const bar = document.getElementById('reading-progress');
      if (bar) bar.style.transform = `scaleX(${progress})`;


      // Map scroll progress to heading index
      const idx = Math.min(headings.length - 1, Math.floor(progress * headings.length));
      setActive(headings[idx].id);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

<style>
  .post-layout-grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: minmax(0, 80ch);
    justify-content: center;
    align-items: start;
  }

  .post-layout-grid.has-toc {
    grid-template-columns: 10rem minmax(0, 80ch) 10rem;
    gap: 0 2.5rem;
  }

  .post-layout-grid.has-toc > .article-column {
    grid-column: 2;
  }

  .post-layout-grid.has-toc > .post-toc {
    grid-column: 3;
  }

  .article-column {
    display: grid;
    gap: 1.2rem;
    max-width: none;
  }

  .post-hero {
    padding: clamp(1rem, 3vw, 1.6rem);
  }

  .post-meta-chips,
  .post-tag-row,
  .post-hero-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  .post-hero h1 {
    margin: 0.7rem 0 0;
    color: #3D404A;
    font-size: clamp(1.5rem, 2.6vw, 2.4rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .post-hero p {
    margin: 0.85rem 0 0;
    color: #8A8F99;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .post-hero-footer {
    justify-content: space-between;
    margin-top: 1rem;
  }

  .post-tag-row {
    margin-top: 0.85rem;
  }

  .article-prose {
    max-width: none;
    padding: 0.25rem 0.1rem 0;
  }

  /* ── Prose typography refinements ── */
  :global(.article-prose) {
    font-size: 1.025rem;
    line-height: 1.82;
  }

  :global(.article-prose h2) {
    margin-top: 2.2rem;
    margin-bottom: 0.6rem;
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1.25;
  }

  :global(.article-prose h3) {
    margin-top: 1.8rem;
    margin-bottom: 0.4rem;
    font-size: 1.15rem;
    font-weight: 750;
    line-height: 1.3;
  }

  :global(.article-prose h4) {
    margin-top: 1.4rem;
    font-size: 1.025rem;
    font-weight: 700;
  }

  :global(.article-prose p) {
    margin-top: 1.1rem;
    margin-bottom: 1.1rem;
  }

  :global(.article-prose ul),
  :global(.article-prose ol) {
    margin-top: 0.8rem;
    margin-bottom: 0.8rem;
    padding-left: 1.4rem;
  }

  :global(.article-prose li) {
    margin-top: 0.3rem;
    margin-bottom: 0.3rem;
  }

  :global(.article-prose table) {
    font-size: 0.9rem;
  }

  .related-panel {
    padding: 1.1rem;
  }

  .related-panel ul {
    display: grid;
    gap: 0.82rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-panel li {
    display: grid;
    gap: 0.38rem;
  }

  .related-panel a {
    color: #3D404A;
    font-size: 0.95rem;
    font-weight: 850;
    text-decoration: none;
  }

  .related-panel a:hover {
    color: #737D73;
  }

  .related-panel p {
    margin: 0;
    color: #8A8F99;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  /* ── TOC: slim floating indicator ── */
  .post-toc {
    position: sticky;
    top: 5.5rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    padding: 0.5rem 0;
    background: none;
    border: none;
    box-shadow: none;
    backdrop-filter: none;
    scroll-behavior: smooth;
  }
  .post-toc::-webkit-scrollbar { display: none; }

  .post-toc h2 {
    display: none;
  }

  .post-toc ul {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-toc a {
    display: block;
    padding: 0.3rem 0.3rem 0.3rem 2rem;
    color: #8A8F99;
    text-decoration: none;
    border-left: 1.5px solid #E0DDD5;
    font-size: 0.78rem;
    font-weight: 400;
    transition: all 0.2s ease;
    line-height: 1.35;
  }

  /* Active: larger, bolder, with accent bar */
  .post-toc a.is-active {
    color: #8E9B8E;
    border-left-color: #8E9B8E;
    border-left-width: 2.5px;
    font-size: 0.92rem;
    font-weight: 700;
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
    padding-left: 1.2rem;
  }

  .toc-nested a {
    padding-left: 2.5rem;
    font-size: 0.7rem;
  }
  .toc-nested a.is-active {
    padding-left: 1.7rem;
    font-size: 0.82rem;
  }

  .post-toc a:not(.is-active):hover {
    color: #3D404A;
    border-left-color: #8A8F99;
  }

  /* ── Dark mode ── */
  :global(.dark) .post-hero h1,
  :global(.dark) .related-panel a {
    color: #E5E5E5;
  }
  :global(.dark) .post-hero p {
    color: #8A8F99;
  }
  :global(.dark) .post-toc a {
    color: #8A8F99;
    border-left-color: #33353B;
  }
  :global(.dark) .post-toc a:not(.is-active):hover {
    color: #E5E5E5;
    border-left-color: #8A8F99;
  }
  :global(.dark) .post-toc a.is-active {
    color: #7A8B7A;
    border-left-color: #7A8B7A;
  }
  :global(.dark) .related-panel a:hover {
    color: #7A8B7A;
  }
  :global(.dark) .related-panel p {
    color: #8A8F99;
  }

  @media (max-width: 1200px) {
    .post-layout-grid.has-toc {
      grid-template-columns: minmax(0, 76ch);
      justify-content: center;
    }
    .post-layout-grid.has-toc > .article-column {
      grid-column: 1;
    }
    .post-toc { display: none; }
  }

  @media (max-width: 620px) {
    .post-hero-footer {
      align-items: stretch;
      flex-direction: column;
    }
  }

  /* ── Reading progress bar ── */
  .reading-progress-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    height: 2px;
    border-radius: 0 2px 2px 0;
    background: linear-gradient(90deg, #8E9B8E, #737D73);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 80ms linear;
    margin-bottom: -2px;
  }

  .dark .reading-progress-bar {
    background: linear-gradient(90deg, #7A8B7A, #8E9B8E);
  }

  /* ── Heading anchor links ── */
  :global(.article-prose h2),
  :global(.article-prose h3),
  :global(.article-prose h4) {
    position: relative;
  }

  :global(.article-prose h2 a),
  :global(.article-prose h3 a),
  :global(.article-prose h4 a) {
    text-decoration: none;
  }

  :global(.article-prose h2:hover::before),
  :global(.article-prose h3:hover::before),
  :global(.article-prose h4:hover::before) {
    content: '#';
    position: absolute;
    right: 100%;
    padding-right: 0.55rem;
    color: #8E9B8E;
    font-size: 0.7em;
    font-weight: 400;
    opacity: 0.5;
    transition: opacity 180ms ease;
  }

  /* ── Blockquote styling ── */
  :global(.prose blockquote) {
    position: relative;
    border-left: 3px solid rgba(142, 155, 142, 0.3);
    background: rgba(255, 255, 255, 0.4);
    border-radius: 0 10px 10px 0;
    padding: 1rem 1.25rem;
    font-style: normal;
    color: #3D404A;
  }

  :global(.dark .prose blockquote) {
    background: rgba(26, 28, 32, 0.3);
    border-left-color: rgba(122, 139, 122, 0.2);
    color: #E5E5E5;
  }

  /* ── Inline code ── */
  :global(.prose code) {
    background: rgb(226 232 240 / 0.65);
    padding: 0.15rem 0.4rem;
    border-radius: 6px;
    font-size: 0.82em;
    font-weight: 600;
    color: rgb(15 23 42);
  }

  :global(.dark .prose code) {
    background: rgb(30 41 59 / 0.7);
    color: rgb(226 232 240);
  }

  :global(.prose code::before),
  :global(.prose code::after) {
    content: none;
  }

  /* ── Code block accent ── */
  :global(.article-prose pre) {
    border-left: 3px solid rgba(142, 155, 142, 0.2);
    border-radius: 0 10px 10px 0;
    padding: 1.1rem 1.15rem;
  }

  :global(.dark .article-prose pre) {
    border-left-color: rgba(122, 139, 122, 0.15);
    background: rgb(8 11 13);
  }

  /* ── Image styling ── */
  :global(.prose img) {
    border-radius: 10px;
    box-shadow:
      0 8px 30px rgba(61, 64, 74, 0.08),
      0 2px 8px rgba(61, 64, 74, 0.06);
  }

  :global(.dark .prose img) {
    box-shadow:
      0 8px 30px rgb(0 0 0 / 0.3),
      0 2px 8px rgb(0 0 0 / 0.2);
  }

  :global(.prose hr) {
    border-color: #E0DDD5;
    margin: 2.5rem 0;
  }

  :global(.dark .prose hr) {
    border-color: #33353B;
  }
</style>
