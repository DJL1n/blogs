---
import BaseLayout from './BaseLayout.astro';

const { post, headings = [], readingTime = 0, Content, relatedPosts = [] } = Astro.props as {
  post: {
    data: {
      title: string;
      summary: string;
      updated: Date;
      category: string;
      importance: number;
      tags: string[];
      relatedNotes?: string[];
      type: string;
    };
    body: string;
  };
  headings: Array<{ text: string; depth: number; slug: string }>;
  readingTime: number;
  Content: any;
  relatedPosts?: Array<{
    title: string;
    summary: string;
    collection: string;
    slug: string;
    href: string;
  }>;
};

const hasToc = headings.length > 0;
const tocEntries = headings.filter((item) => item.depth > 0 && item.slug);
const bodyForEditor =
  (post.body || '').length > 6000 ? '' : encodeURIComponent(post.body || '');
const editorQuery = bodyForEditor
  ? `&body=${bodyForEditor}&bodyMode=source`
  : '';
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <section class={`post-shell post-layout-grid ${hasToc ? 'has-toc' : ''}`}>
    <article class="article-column reading-shell mx-auto min-w-0">
      <header class="post-hero liquid-panel reveal" data-liquid-panel>
        <div class="post-meta-chips">
          <span class="chip">{post.data.updated.toLocaleDateString('zh-CN')} 更新</span>
          <span class="chip">{post.data.category}</span>
          <span class="chip">{post.data.type}</span>
          <span class="chip">重要性 {post.data.importance}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p>{post.data.summary}</p>
        <div class="post-hero-footer">
          <span class="system-badge">预计 {readingTime} 分钟阅读</span>
          <a
            href={`/editor?type=${post.data.type === 'note' ? 'note' : post.data.type}&title=${encodeURIComponent(post.data.title)}&summary=${encodeURIComponent(post.data.summary)}&category=${encodeURIComponent(post.data.category)}&tags=${encodeURIComponent(post.data.tags.join(', '))}&importance=${encodeURIComponent(String(post.data.importance))}${editorQuery}`}
            class="btn-secondary magnetic"
          >
            进入编辑模式
          </a>
        </div>
        <div class="post-tag-row" aria-label="文章标签">
          {post.data.tags.length > 0 ? (
            post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag.toLowerCase())}`} class="chip">#{tag}</a>)
          ) : (
            <span class="empty-copy">未标注标签</span>
          )}
        </div>
      </header>

      {relatedPosts.length > 0 && (
        <section class="related-panel liquid-panel reveal reveal-delay-1" data-liquid-panel>
          <div class="panel-heading">
            <div>
              <p class="panel-eyebrow">Related</p>
              <h2>论文关联</h2>
            </div>
          </div>
          <ul>
            {relatedPosts.map((item) => (
              <li>
                <a href={item.href}>{item.title}</a>
                <span class="chip">{item.collection}</span>
                <p>{item.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div id="post-content" class="article-prose prose prose-slate dark:prose-invert relative reveal reveal-delay-2">
        <Content />
      </div>
    </article>

    {
      hasToc && (
        <aside class="post-toc liquid-panel sticky top-24 h-fit reveal reveal-delay-1" data-liquid-panel>
          <p class="panel-eyebrow">Outline</p>
          <h2>目录</h2>
          <ul>
            {tocEntries.map((item) => (
              <li class={`${item.depth >= 3 ? 'toc-nested' : ''}`}>
                <a href={`#${item.slug}`}>
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const root = document.querySelector('#post-content');
    if (!root) return;

    root.querySelectorAll('pre').forEach((pre) => {
      pre.classList.add('relative');
      if (pre.querySelector('.copy-code-btn')) return;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = '复制';
      btn.className = 'copy-code-btn';
      btn.addEventListener('click', async () => {
        const code = pre.textContent || '';
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = '已复制';
          window.setTimeout(() => (btn.textContent = '复制'), 1100);
        } catch (err) {
          btn.textContent = '复制失败';
          window.setTimeout(() => (btn.textContent = '复制'), 1100);
        }
      });

      pre.appendChild(btn);
    });
  })();
</script>

<style>
  .post-layout-grid {
    display: grid;
    gap: 1.2rem;
  }

  .post-layout-grid.has-toc {
    grid-template-columns: minmax(0, 1fr) 15rem;
    align-items: start;
  }

  .article-column {
    display: grid;
    gap: 1.2rem;
  }

  .post-hero {
    padding: clamp(1.2rem, 4vw, 2rem);
  }

  .post-meta-chips,
  .post-tag-row,
  .post-hero-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
  }

  .post-hero h1 {
    margin: 0.85rem 0 0;
    color: rgb(15 23 42);
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    font-weight: 950;
    line-height: 1;
    letter-spacing: 0;
  }

  .post-hero p {
    margin: 1rem 0 0;
    color: rgb(71 85 105);
    font-size: 1rem;
    line-height: 1.85;
  }

  .post-hero-footer {
    justify-content: space-between;
    margin-top: 1.2rem;
  }

  .post-tag-row {
    margin-top: 1rem;
  }

  .article-prose {
    max-width: none;
    padding: 0.25rem 0.1rem 0;
  }

  .related-panel {
    padding: 1.1rem;
  }

  .related-panel ul {
    display: grid;
    gap: 0.82rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-panel li {
    display: grid;
    gap: 0.38rem;
  }

  .related-panel a {
    color: rgb(15 23 42);
    font-size: 0.95rem;
    font-weight: 850;
    text-decoration: none;
  }

  .related-panel a:hover {
    color: rgb(15 118 110);
  }

  .related-panel p {
    margin: 0;
    color: rgb(100 116 139);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .post-toc {
    padding: 1rem;
  }

  .post-toc h2 {
    margin: 0.25rem 0 0;
    color: rgb(15 23 42);
    font-size: 1rem;
    font-weight: 900;
  }

  .post-toc ul {
    display: grid;
    gap: 0.48rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.86rem;
  }

  .post-toc a {
    color: rgb(71 85 105);
    text-decoration: none;
  }

  .post-toc a:hover {
    color: rgb(15 118 110);
  }

  .toc-nested {
    padding-left: 0.8rem;
    font-size: 0.8rem;
  }

  :global(.dark) .post-hero h1,
  :global(.dark) .post-toc h2,
  :global(.dark) .related-panel a {
    color: rgb(248 250 252);
  }

  :global(.dark) .post-hero p {
    color: rgb(203 213 225);
  }

  :global(.dark) .related-panel a:hover,
  :global(.dark) .post-toc a:hover {
    color: rgb(94 234 212);
  }

  :global(.dark) .related-panel p,
  :global(.dark) .post-toc a {
    color: rgb(148 163 184);
  }

  @media (max-width: 1024px) {
    .post-layout-grid.has-toc {
      grid-template-columns: 1fr;
    }

    .post-toc {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 620px) {
    .post-hero-footer {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
