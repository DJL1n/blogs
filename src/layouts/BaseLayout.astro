---
const { title = '山不见我', description = '', mainClass } = Astro.props as {
  title?: string;
  description?: string;
  mainClass?: string;
};
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const resolvedMainClass = mainClass
  ? mainClass
  : path === '/'
    ? 'main-home'
    : path.startsWith('/blog/')
      ? 'main-blog'
      : path === '/blog'
        ? 'main-blog'
        : path.startsWith('/notes/')
          ? 'main-notes'
          : path === '/notes'
            ? 'main-notes'
            : path.startsWith('/important/')
              ? 'main-important'
              : path === '/important'
                ? 'main-important'
                : path === '/search'
                  ? 'main-search'
                  : path.startsWith('/categories/')
                    ? 'main-category'
                    : path === '/categories'
                      ? 'main-category'
                      : path.startsWith('/tags/')
                        ? 'main-tag'
                        : path === '/tags'
                          ? 'main-tag'
                          : path === '/about'
                            ? 'main-about'
                            : path === '/editor'
                              ? 'main-editor'
                              : 'main-default';
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme') || 'system';
        const isDark =
          theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>
<body class="[word-break:break-word]">
  <Header />
  <main class={`content-shell py-8 lg:py-10 main-shell ${resolvedMainClass}`}>
    <slot />
  </main>
  <Footer />

  <script>
    (function() {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hoverSelector = '.btn-primary, .btn-secondary, .liquid-control, .theme-toggle, .panel-link, .post-card, .chip, .copy-code-btn';
      let hoverFrame = 0;
      let hoverPoint: { x: number; y: number; target: EventTarget | null } | null = null;

      document.addEventListener('pointermove', (e: PointerEvent) => {
        hoverPoint = { x: e.clientX, y: e.clientY, target: e.target };
        if (hoverFrame) return;

        hoverFrame = window.requestAnimationFrame(() => {
          hoverFrame = 0;
          if (!hoverPoint || !(hoverPoint.target instanceof HTMLElement)) return;

          const el = hoverPoint.target.closest(hoverSelector) as HTMLElement | null;
          if (!el) return;

          const r = el.getBoundingClientRect();
          el.style.setProperty('--gx', `${hoverPoint.x - r.left}px`);
          el.style.setProperty('--gy', `${hoverPoint.y - r.top}px`);
        });
      }, { passive: true });

      const revealElements = document.querySelectorAll<HTMLElement>('.reveal');
      if (!revealElements.length || reducedMotion) {
        revealElements.forEach((element) => element.classList.add('visible'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('visible');
              revealObserver.unobserve(entry.target);
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -42px 0px' }
        );
        revealElements.forEach((element) => revealObserver.observe(element));
      }

      if (reducedMotion) return;

      const interactiveElements = document.querySelectorAll<HTMLElement>('[data-liquid-panel], [data-tilt]');
      interactiveElements.forEach((element) => {
        element.addEventListener('pointermove', (event) => {
          const rect = element.getBoundingClientRect();
          const x = event.clientX - rect.left;
          const y = event.clientY - rect.top;
          const px = x / rect.width - 0.5;
          const py = y / rect.height - 0.5;

          element.style.setProperty('--mx', `${x}px`);
          element.style.setProperty('--my', `${y}px`);

          if (!element.hasAttribute('data-tilt')) return;
          element.style.transform = `perspective(900px) rotateX(${(-py * 4.2).toFixed(2)}deg) rotateY(${(px * 5.2).toFixed(2)}deg) translate3d(0, -2px, 0)`;
        }, { passive: true });

        element.addEventListener('pointerleave', () => {
          element.style.removeProperty('--mx');
          element.style.removeProperty('--my');
          element.style.transform = '';
        }, { passive: true });
      });

      const magneticElements = document.querySelectorAll<HTMLElement>('.magnetic');
      magneticElements.forEach((element) => {
        element.addEventListener('pointermove', (event) => {
          const rect = element.getBoundingClientRect();
          const x = event.clientX - rect.left - rect.width / 2;
          const y = event.clientY - rect.top - rect.height / 2;
          element.style.transform = `translate(${(x * 0.11).toFixed(1)}px, ${(y * 0.16).toFixed(1)}px)`;
        }, { passive: true });

        element.addEventListener('pointerleave', () => {
          element.style.transform = '';
        }, { passive: true });
      });
    })();
  </script>
</body>
</html>
