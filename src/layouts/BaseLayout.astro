---
const { title = '山不见我', description = '', mainClass } = Astro.props as {
  title?: string;
  description?: string;
  mainClass?: string;
};
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const resolvedMainClass = mainClass
  ? mainClass
  : path === '/'
    ? 'main-home'
    : path.startsWith('/blog/')
      ? 'main-blog'
      : path === '/blog'
        ? 'main-blog'
        : path.startsWith('/notes/')
          ? 'main-notes'
          : path === '/notes'
            ? 'main-notes'
            : path.startsWith('/important/')
              ? 'main-important'
              : path === '/important'
                ? 'main-important'
                : path === '/search'
                  ? 'main-search'
                  : path.startsWith('/categories/')
                    ? 'main-category'
                    : path === '/categories'
                      ? 'main-category'
                      : path.startsWith('/tags/')
                        ? 'main-tag'
                        : path === '/tags'
                          ? 'main-tag'
                          : path === '/about'
                            ? 'main-about'
                            : path === '/editor'
                              ? 'main-editor'
                              : 'main-default';
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme') || 'system';
        const isDark =
          theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>
<body class="[word-break:break-word]">
  <Header />
  <main class={`content-shell py-8 lg:py-10 main-shell ${resolvedMainClass}`}>
    <slot />
  </main>
  <Footer />

  <script>
    (function() {
      const root = document.documentElement;
      const hoverSelector = '.btn-primary, .btn-secondary, .liquid-control, .theme-toggle, .panel-link';

      document.addEventListener('pointermove', (e: PointerEvent) => {
        root.style.setProperty('--page-x', `${e.clientX}px`);
        root.style.setProperty('--page-y', `${e.clientY}px`);

        const el = (e.target as HTMLElement).closest(hoverSelector) as HTMLElement | null;
        if (!el) return;

        const r = el.getBoundingClientRect();
        el.style.setProperty('--gx', `${e.clientX - r.left}px`);
        el.style.setProperty('--gy', `${e.clientY - r.top}px`);
      }, { passive: true });
    })();
  </script>
</body>
</html>
