---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = [
    ...(await getCollection('blog')).filter((post) => !post.data.draft),
    ...(await getCollection('notes')).filter((post) => !post.data.draft),
    ...(await getCollection('important')).filter((post) => !post.data.draft)
  ];

  const categorySet = new Set<string>();
  for (const post of posts) {
    if (post.data.category) {
      categorySet.add(post.data.category.toLowerCase());
    }
  }

  return [...categorySet].map((category) => ({
    params: {
      category
    }
  }));
}

const { category } = Astro.params;
const target = (category || '').toLowerCase();

const posts = [
  ...(await getCollection('blog')).filter((post) => !post.data.draft),
  ...(await getCollection('notes')).filter((post) => !post.data.draft),
  ...(await getCollection('important')).filter((post) => !post.data.draft)
]
  .filter((post) => post.data.category.toLowerCase() === target)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={`分类：${category}`} description={`分类 ${category} 下的内容`}>
  <section class="page-stack">
    <PageHeader
      eyebrow="Category Filter"
      title={`分类：${category}`}
      description="这个分类下的内容按更新时间排序，适合从一个稳定用途回看全部材料。"
      meta={[`${posts.length} 篇内容`]}
      actions={[{ label: '所有分类', href: '/categories' }, { label: '搜索', href: `/search?q=${encodeURIComponent(category || '')}` }]}
    />

    <div class="collection-grid">
      {posts.map((post) => {
        const url =
          post.collection === 'blog'
            ? `/blog/${post.slug}`
            : post.collection === 'notes'
            ? `/notes/${post.slug}`
            : `/important/${post.slug}`;
        return <PostCard item={post} href={url} />;
      })}
    </div>
  </section>
</BaseLayout>
