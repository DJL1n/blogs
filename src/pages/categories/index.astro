---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryList from '../../components/CategoryList.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const posts = [
  ...(await getCollection('blog')),
  ...(await getCollection('notes')),
  ...(await getCollection('important'))
];

const categories = Array.from(
  new Set(posts.map((item) => item.data.category.toLowerCase()).filter(Boolean))
).sort();
---

<BaseLayout title="分类" description="按分类查看内容">
  <section class="page-stack">
    <PageHeader
      eyebrow="Category Index"
      title="分类页"
      description="分类负责稳定结构，帮助内容在长期维护中保持可迁移、可定位。"
      meta={[`${categories.length} 个分类`, '稳定索引']}
      actions={[{ label: '查看标签', href: '/tags' }]}
    />

    <div class="card reveal">
      <CategoryList categories={categories} />
    </div>
  </section>
</BaseLayout>
