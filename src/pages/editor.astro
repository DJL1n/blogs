---
import BaseLayout from '../layouts/BaseLayout.astro';

const TYPES = [
  { value: 'note', label: 'note（短笔记）' },
  { value: 'blog', label: 'blog（长文）' },
  { value: 'important', label: 'important（重要记录）' },
];

const LS_KEY = 'kb-editor-draft-clean-v1';
---

<BaseLayout title="写作助手（重构版）" description="简化稳定的本地写作页：可视化编辑、源码编辑、元数据与 Markdown 导出。">
  <section class="space-y-6">
    <header>
      <p class="inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 dark:border-emerald-700 dark:bg-slate-800 dark:text-emerald-200">
        重构版编辑器
      </p>
      <h1 class="mt-3 text-4xl font-bold">写作助手</h1>
      <p class="mt-2 text-slate-600 dark:text-slate-300">
        以本地 draft 为主，支持文档模式和源码模式。你可以直接在正文写作并生成 frontmatter + Markdown。
      </p>
    </header>

    <section class="space-y-6 content-shell">
      <form id="writer-form" class="space-y-4" autocomplete="off">
        <div class="surface-card space-y-4">
          <h2 class="text-lg font-semibold">元数据</h2>
          <div class="grid gap-3 md:grid-cols-2">
            <label class="space-y-2">
              <span class="text-sm font-medium">标题</span>
              <input id="title" type="text" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800" placeholder="输入标题" value="" />
            </label>

            <label class="space-y-2">
              <span class="text-sm font-medium">类型</span>
              <select id="type" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800">
                {TYPES.map((item) => <option value={item.value}>{item.label}</option>)}
              </select>
            </label>

            <label class="space-y-2">
              <span class="text-sm font-medium">分类</span>
              <input id="category" type="text" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800" value="技巧" />
            </label>

            <label class="space-y-2">
              <span class="text-sm font-medium">重要性（1-5）</span>
              <input id="importance" type="number" min="1" max="5" value="2" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800" />
            </label>

            <input id="date" type="hidden" />
            <input id="updated" type="hidden" />

            <label class="space-y-2 md:col-span-2">
              <span class="text-sm font-medium">标签（英文逗号分隔）</span>
              <input id="tags" type="text" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800" placeholder="macOS, dns, network" />
            </label>

            <label class="space-y-2 md:col-span-2">
              <span class="text-sm font-medium">摘要</span>
              <textarea id="summary" rows="2" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800" placeholder="一句话说明这篇内容"></textarea>
            </label>
          </div>
        </div>

        <div class="surface-card">
          <div class="mb-3 flex flex-wrap items-center gap-2 border-b border-slate-200 pb-3 dark:border-slate-700">
            <button type="button" id="mode-visual" class="btn-tool btn-tool-active">文档模式</button>
            <button type="button" id="mode-source" class="btn-tool">源码模式</button>
            <span class="h-4 w-px bg-slate-300 dark:bg-slate-600"></span>
            <button type="button" data-command="bold" class="btn-tool" title="加粗 (Cmd/Ctrl+B)">B</button>
            <button type="button" data-command="italic" class="btn-tool" title="斜体 (Cmd/Ctrl+I)">I</button>
            <button type="button" data-command="underline" class="btn-tool">U</button>
            <button type="button" data-command="foreColor" data-color="#ef4444" class="btn-tool" title="红色" style="color:#ef4444;font-weight:700;">A</button>
            <button type="button" data-command="foreColor" data-color="#f59e0b" class="btn-tool" title="橙色" style="color:#f59e0b;font-weight:700;">A</button>
            <button type="button" data-command="foreColor" data-color="#eab308" class="btn-tool" title="黄色" style="color:#eab308;font-weight:700;">A</button>
            <button type="button" data-command="foreColor" data-color="#22c55e" class="btn-tool" title="绿色" style="color:#22c55e;font-weight:700;">A</button>
            <button type="button" data-command="foreColor" data-color="#0ea5e9" class="btn-tool" title="蓝色" style="color:#0ea5e9;font-weight:700;">A</button>
            <button type="button" data-command="foreColor" data-color="#a855f7" class="btn-tool" title="紫色" style="color:#a855f7;font-weight:700;">A</button>
            <button type="button" data-command="foreColor" data-color="#64748b" class="btn-tool" title="灰色" style="color:#64748b;font-weight:700;">A</button>
            <button type="button" data-command="insertOrderedList" class="btn-tool">有序列表</button>
            <button type="button" data-command="insertUnorderedList" class="btn-tool">无序列表</button>
            <button type="button" data-command="blockquote" class="btn-tool">引用</button>
            <button type="button" data-command="h1" class="btn-tool">H1</button>
            <button type="button" data-command="h2" class="btn-tool">H2</button>
            <button type="button" data-command="h3" class="btn-tool">H3</button>
            <button type="button" data-command="h4" class="btn-tool">H4</button>
            <button type="button" data-command="h5" class="btn-tool">H5</button>
            <button type="button" data-command="h6" class="btn-tool">H6</button>
          </div>

          <div id="editor-shell" class="editor-shell">
            <div id="editor-placeholder" class="writer-placeholder">在这里开始写作（支持标题、列表、引用、代码块、图片粘贴）。例如：输入 / 调出块级命令，或 Ctrl/Cmd+P 打开命令盘。</div>
            <div
              id="editor"
              class="writer-canvas w-full"
              contenteditable="true"
              aria-label="正文编辑区"
            ></div>

            <textarea
              id="source-editor"
              class="writer-canvas h-[56vh] w-full font-mono hidden"
              placeholder="在这里直接写 Markdown，例如：# 标题"
              aria-label="Markdown 源码编辑"
            ></textarea>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <button type="button" id="build-btn" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500">保存</button>
          <button type="button" id="clear-btn" class="rounded-md border border-rose-300 px-4 py-2 text-sm text-rose-600 dark:border-rose-700 dark:text-rose-300">清空草稿</button>
        </div>

        <p id="state-tip" class="text-sm text-slate-500 dark:text-slate-300">欢迎使用重构版编辑器，先填正文再切换源码/保存。</p>
      </form>
    </section>
  </section>

  <script is:inline>
    const titleInput = document.getElementById('title');
    const typeInput = document.getElementById('type');
    const categoryInput = document.getElementById('category');
    const importanceInput = document.getElementById('importance');
    const dateInput = document.getElementById('date');
    const updatedInput = document.getElementById('updated');
    const tagsInput = document.getElementById('tags');
    const summaryInput = document.getElementById('summary');
    const editor = document.getElementById('editor');
    const sourceEditor = document.getElementById('source-editor');
    const editorPlaceholder = document.getElementById('editor-placeholder');
    const modeVisualBtn = document.getElementById('mode-visual');
    const modeSourceBtn = document.getElementById('mode-source');
    const buildBtn = document.getElementById('build-btn');
    const clearBtn = document.getElementById('clear-btn');
    const stateTip = document.getElementById('state-tip');

    const commands = document.querySelectorAll('[data-command]');

    let currentMode = 'visual';

    function nowDate() {
      return new Date().toISOString().slice(0, 10);
    }

    function clampImportance(value) {
      const n = Number(value);
      if (Number.isNaN(n)) return 2;
      return Math.min(Math.max(Math.round(n), 1), 5);
    }

    function stripText(value) {
      return String(value || '').replace(/\s+/g, ' ').trim();
    }

    function isEditorEmpty() {
      const txt = (editor.textContent || '').replace(/[\u200b\u00a0\n\r\t]/g, '').trim();
      if (txt.length > 0) return false;
      const hasBlock = editor.querySelector('img, pre, blockquote, ul, ol, table, hr, li');
      if (hasBlock) return false;
      const html = (editor.innerHTML || '')
        .toLowerCase()
        .replace(/\s+/g, '')
        .replace(/&nbsp;/g, '')
        .replace(/<\/?(div|p|span|article|section)[^>]*>/g, '')
        .replace(/<br\s*\/?>/g, '');
      return html.length === 0;
    }

    function updatePlaceholder() {
      const empty = isEditorEmpty() && currentMode === 'visual';
      if (!editorPlaceholder) return;
      editorPlaceholder.style.display = empty ? '' : 'none';
    }

    function setMode(mode, sync = true) {
      currentMode = mode === 'source' ? 'source' : 'visual';
      if (currentMode === 'visual') {
        sourceEditor.classList.add('hidden');
        editor.classList.remove('hidden');
        editorPlaceholder.style.display = isEditorEmpty() ? '' : 'none';
      } else {
        editorPlaceholder.style.display = 'none';
        editor.classList.add('hidden');
        sourceEditor.classList.remove('hidden');
      }
      updateModeUI();
      if (sync) {
        syncState();
      }
    }

    function syncState() {
      if (currentMode === 'source') {
        sourceEditor.value = editorToMarkdown() || sourceEditor.value;
      } else {
        editor.innerHTML = sourceToHtml(sourceEditor.value);
      }
      updatePlaceholder();
      saveDraft();
    }

    function updateModeUI() {
      if (currentMode === 'visual') {
        modeVisualBtn.classList.add('btn-tool-active');
        modeSourceBtn.classList.remove('btn-tool-active');
      } else {
        modeSourceBtn.classList.add('btn-tool-active');
        modeVisualBtn.classList.remove('btn-tool-active');
      }
    }

    function toYamlString(value) {
      return JSON.stringify(String(value));
    }

    function slugify(value) {
      return String(value || '')
        .trim()
        .toLowerCase()
        .replace(/\s+/g, '-')
        .replace(/[^a-z0-9\u4e00-\u9fff_-]/g, '')
        .replace(/-+/g, '-')
        .replace(/(^-|-$)/g, '')
        .slice(0, 80) || `post-${nowDate()}`;
    }

    function cleanTags() {
      return stripText(tagsInput.value)
        .split(',')
        .map((item) => stripText(item))
        .filter(Boolean);
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function inlineMarkdownToHtml(text) {
      let out = String(text || '');
      const colorSpans = [];
      out = out.replace(/<span\b[^>]*\bstyle\s*=\s*(["'])([\s\S]*?)\1[^>]*>([\s\S]*?)<\/span>/gi, (_match, _quote, styleText, body) => {
        const style = (styleText || '').toLowerCase().trim();
        const safeStyle = style.includes('color') ? ` style=\"${escapeHtml(style)}\"` : '';
        const safeBody = body || '';
        if (!safeStyle) return '';
        const index = colorSpans.length;
        colorSpans.push(`<span${safeStyle}>${escapeHtml(safeBody)}</span>`);
        return `__COLOR_SPAN_${index}__`;
      });
      out = escapeHtml(out);

      out = out.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (_, alt, src) => {
        const safeAlt = (alt || '').trim() || 'image';
        return `<img src="${escapeHtml(src.trim())}" alt="${escapeHtml(safeAlt)}" />`;
      });

      out = out.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, label, href) => {
        return `<a href="${encodeURI((href || '').trim())}">${escapeHtml(label)}</a>`;
      });

      out = out.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      out = out.replace(/__([^_]+)__/g, '<strong>$1</strong>');
      out = out.replace(/\*([^*]+)\*/g, '<em>$1</em>');
      out = out.replace(/_([^_]+)_/g, '<em>$1</em>');
      out = out.replace(/~~([^~]+)~~/g, '<del>$1</del>');
      out = out.replace(/`([^`]+)`/g, '<code>$1</code>');
      out = out.replace(/__COLOR_SPAN_(\d+)__/g, (_, idx) => colorSpans[Number(idx)] || '');

      return out;
    }

    function sourceToHtml(md) {
      const text = String(md || '').replace(/\r\n/g, '\n').trim();
      if (!text) return '';
      const lines = text.split('\n');
      const html = [];
      let i = 0;

      while (i < lines.length) {
        const line = (lines[i] || '').trim();
        if (!line) {
          i += 1;
          continue;
        }

        const heading = line.match(/^(#{1,6})\s+(.*)$/);
        if (heading) {
          const level = Math.min(6, heading[1].length);
          html.push(`<h${level}>${inlineMarkdownToHtml(heading[2])}</h${level}>`);
          i += 1;
          continue;
        }

        if (/^```/.test(line)) {
          const language = line.replace(/^```/, '').trim();
          i += 1;
          const code = [];
          while (i < lines.length && !/^```/.test((lines[i] || '').trim())) {
            code.push(lines[i]);
            i += 1;
          }
          if (i < lines.length) i += 1;
          const codeText = escapeHtml(code.join('\n'));
          const lang = language ? ` data-language="${escapeHtml(language)}"` : '';
          const cls = language ? ` class="language-${escapeHtml(language)}"` : '';
          html.push(`<pre${lang}><code${cls}>${codeText}</code></pre>`);
          continue;
        }

        if (/^>/.test(line)) {
          let quote = [];
          while (i < lines.length && /^>/.test((lines[i] || '').trim())) {
            quote.push((lines[i] || '').replace(/^>\s?/, ''));
            i += 1;
          }
          const quoteHtml = quote.map((item) => inlineMarkdownToHtml(item)).join('<br/>');
          html.push(`<blockquote>${quoteHtml}</blockquote>`);
          continue;
        }

        if (/^[-*]\s+/.test(line)) {
          const items = [];
          while (i < lines.length && /^[-*]\s+/.test((lines[i] || '').trim())) {
            items.push((lines[i] || '').replace(/^[-*]\s+/, ''));
            i += 1;
          }
          html.push(`<ul>${items.map((item) => `<li>${inlineMarkdownToHtml(item)}</li>`).join('')}</ul>`);
          continue;
        }

        if (/^\d+\.\s+/.test(line)) {
          const items = [];
          while (i < lines.length && /^\d+\.\s+/.test((lines[i] || '').trim())) {
            items.push((lines[i] || '').replace(/^\d+\.\s+/, ''));
            i += 1;
          }
          html.push(`<ol>${items.map((item) => `<li>${inlineMarkdownToHtml(item)}</li>`).join('')}</ol>`);
          continue;
        }

        html.push(`<p>${inlineMarkdownToHtml(line)}</p>`);
        i += 1;
      }

      return html.join('');
    }

    function serializeNode(node) {
      if (!node) return '';
      if (node.nodeType === Node.TEXT_NODE) return (node.textContent || '').replace(/\u0000/g, '');
      if (node.nodeType === Node.ELEMENT_NODE) {
        const tag = (node.tagName || '').toLowerCase();
        const style = (node.getAttribute('style') || '').toLowerCase();
        const raw = Array.from(node.childNodes).map(serializeNode).join('');
        const content = raw.replace(/\s+$/, '');
        if (tag === 'strong' || tag === 'b') return `**${content.trim()}**`;
        if (tag === 'em' || tag === 'i') return `*${content.trim()}*`;
        if (tag === 'del' || tag === 'strike' || tag === 's') return `~~${content.trim()}~~`;
        if (tag === 'u') return `_${content.trim()}_`;
        if (tag === 'span' && /font-weight:\s*(bold|[7-9]00|bolder|[1-9][0-9]{2})/.test(style)) {
          return `**${content.trim()}**`;
        }
        if (tag === 'span' && /font-style:\s*italic/.test(style)) {
          return `*${content.trim()}*`;
        }
        if (tag === 'span' && /text-decoration:\s*[^;]*underline/.test(style)) {
          return `_${content.trim()}_`;
        }
        if (tag === 'span' && /text-decoration:\s*[^;]*line-through/.test(style)) {
          return `~~${content.trim()}~~`;
        }
        if (tag === 'span' && /color:\s*[^;]+/.test(style)) {
          const safeStyle = (node.getAttribute('style') || '').replace(/["']/g, '');
          return `<span style="${safeStyle}">${content}</span>`;
        }
        if (tag === 'code') return `\`${content}\``;
        if (tag === 'h1') return `# ${content.trim()}\n\n`;
        if (tag === 'h2') return `## ${content.trim()}\n\n`;
        if (tag === 'h3') return `### ${content.trim()}\n\n`;
        if (tag === 'h4') return `#### ${content.trim()}\n\n`;
        if (tag === 'h5') return `##### ${content.trim()}\n\n`;
        if (tag === 'h6') return `###### ${content.trim()}\n\n`;
        if (tag === 'blockquote') return `> ${content.trim()}\n\n`;
        if (tag === 'pre') {
          const codeNode = node.querySelector('code');
          const code = (node.textContent || '').replace(/^\n+|\n+$/g, '');
          const lang = (node.getAttribute('data-language') || codeNode?.getAttribute('class') || '').match(/language-([\w-]+)/)?.[1] || '';
          const info = lang ? `${lang}` : '';
          return `\n\n\`\`\`${info}\n${code}\n\`\`\`\n\n`;
        }
        if (tag === 'ul' || tag === 'ol') {
          return Array.from(node.querySelectorAll(':scope > li'))
            .map((li, idx) => {
              const prefix = tag === 'ol' ? `${idx + 1}. ` : '- ';
              const row = Array.from(li.childNodes).map((child) => serializeNode(child)).join('').replace(/\n+/g, ' ').trim();
              return `${prefix}${row}`;
            })
            .join('\n') + '\n\n';
        }
        if (tag === 'a') {
          const href = (node.getAttribute('href') || '').trim() || '#';
          return `[${content.trim()}](${href})`;
        }
        if (tag === 'li') return `- ${content.trim()}\n`;
        if (tag === 'img') return `![${node.alt || 'image'}](${(node.getAttribute('src') || '').trim() || ''})\n\n`;
        if (tag === 'hr') return '---\n\n';
        if (tag === 'p') return `${content.trim()}\n\n`;
        if (tag === 'br') return '\n';
        return content;
      }
      return '';
    }

    function editorToMarkdown() {
      const container = document.createElement('div');
      container.innerHTML = editor.innerHTML || '';
      return Array.from(container.childNodes)
        .map(serializeNode)
        .join('')
        .replace(/\n{3,}/g, '\n\n')
        .trim();
    }

    function getBodyMarkdown() {
      if (currentMode === 'source') {
        return (sourceEditor.value || '').trim();
      }
      return editorToMarkdown() || '';
    }

    function buildMarkdown() {
      const title = stripText(titleInput.value) || '无标题';
      const tags = cleanTags();
      const date = dateInput.value || nowDate();
      const updated = updatedInput.value || nowDate();
      const summary = stripText(summaryInput.value) || '待补充';
      const body = getBodyMarkdown();

      const front = [
        '---',
        `title: ${toYamlString(title)}`,
        `date: ${date}`,
        `updated: ${updated}`,
        `summary: ${toYamlString(summary)}`,
        `tags: [${tags.map((item) => toYamlString(item)).join(', ')}]`,
        `category: ${toYamlString(stripText(categoryInput.value) || '技巧')}`,
        `type: ${toYamlString(typeInput.value || 'note')}`,
        `importance: ${clampImportance(importanceInput.value)}`,
        'draft: false',
        '---',
        '',
        body || '请在正文中填写内容。',
        '',
      ];
      return front.join('\n');
    }

    function saveDraft() {
      const payload = {
        title: stripText(titleInput.value),
        type: typeInput.value || 'note',
        category: stripText(categoryInput.value) || '技巧',
        importance: clampImportance(importanceInput.value),
        date: dateInput.value || nowDate(),
        updated: updatedInput.value || nowDate(),
        tags: cleanTags(),
        summary: stripText(summaryInput.value),
        contentHtml: editor.innerHTML || '',
        contentSource: sourceEditor.value || '',
        mode: currentMode,
      };
      localStorage.setItem(LS_KEY, JSON.stringify(payload));
    }

    function loadDraft() {
      const raw = localStorage.getItem(LS_KEY);
      if (!raw) {
        dateInput.value = nowDate();
        updatedInput.value = nowDate();
        return;
      }

      try {
        const data = JSON.parse(raw);
        titleInput.value = data.title || '';
        typeInput.value = data.type || 'note';
        categoryInput.value = data.category || '技巧';
        importanceInput.value = String(data.importance || 2);
        dateInput.value = data.date || nowDate();
        updatedInput.value = data.updated || nowDate();
        tagsInput.value = Array.isArray(data.tags) ? data.tags.join(', ') : '';
        summaryInput.value = data.summary || '';

        if (data.mode === 'source') {
          sourceEditor.value = data.contentSource || '';
          editor.innerHTML = sourceEditor.value ? sourceToHtml(sourceEditor.value) : (data.contentHtml || '');
          currentMode = 'source';
          setMode('source', false);
        } else {
          editor.innerHTML = data.contentHtml || '';
          if (!editor.innerHTML && data.contentSource) {
            editor.innerHTML = sourceToHtml(data.contentSource);
          }
          currentMode = 'visual';
          setMode('visual', false);
        }
        updateModeUI();
        updatePlaceholder();
      } catch (_err) {
        // ignore corrupted data
      }
    }

    function setDraftDate() {
      const now = nowDate();
      if (!dateInput.value) dateInput.value = now;
      updatedInput.value = now;
    }

    function getCurrentBlockElement(range) {
      if (!range) return null;
      let node = range.startContainer?.nodeType === Node.TEXT_NODE ? range.startContainer.parentElement : range.startContainer;
      while (node && node !== editor) {
        const tag = (node.tagName || '').toUpperCase();
        if (!tag) break;
        if (['P', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'BLOCKQUOTE', 'UL', 'OL', 'LI', 'DIV'].includes(tag)) {
          return node;
        }
        node = node.parentElement;
      }
      return node === editor ? editor : null;
    }

    function replaceWithBlock(node, tagName) {
      if (!node || node === editor || !node.parentElement) return null;
      const wrapper = document.createElement(tagName);
      Array.from(node.childNodes).forEach((child) => {
        wrapper.appendChild(child);
      });
      node.parentElement.replaceChild(wrapper, node);
      return wrapper;
    }

    function normalizeColor(value) {
      if (!value) return '';
      return String(value).toLowerCase().trim();
    }

    function applyTextColor(color) {
      if (!color) return;
      const ok = document.execCommand('foreColor', false, color);
      if (ok) return;
      const selection = window.getSelection();
      if (!selection?.rangeCount) return;
      const range = selection.getRangeAt(0);
      const text = range.toString();
      if (!text) return;
      const span = document.createElement('span');
      span.style.color = color;
      span.textContent = text;
      range.deleteContents();
      range.insertNode(span);
      const newRange = document.createRange();
      newRange.setStartAfter(span);
      newRange.setEndAfter(span);
      selection.removeAllRanges();
      selection.addRange(newRange);
    }

    function applyHeading(level) {
      const selection = window.getSelection();
      if (!selection?.rangeCount) return;
      const range = selection.getRangeAt(0);
      const before = editor.innerHTML;
      const ok = document.execCommand('formatBlock', false, `<h${level}>`);
      const after = editor.innerHTML;
      if (ok && before !== after) return;
      const block = getCurrentBlockElement(range);
      if (!block || block === editor) return;
      const headingNode = replaceWithBlock(block, `H${level}`);
      if (headingNode && headingNode !== editor) {
        const newRange = document.createRange();
        newRange.selectNodeContents(headingNode);
        selection.removeAllRanges();
        selection.addRange(newRange);
      }
    }

    function applyList(command) {
      const tagName = command === 'insertOrderedList' ? 'OL' : 'UL';
      const selection = window.getSelection();
      if (!selection?.rangeCount) return;
      const range = selection.getRangeAt(0);
      const before = editor.innerHTML;
      const ok = document.execCommand(command, false, null);
      const after = editor.innerHTML;
      if (ok && before !== after) return;
      const block = getCurrentBlockElement(range);
      if (!block || block === editor) return;

      if (block.tagName === 'UL' || block.tagName === 'OL') {
        if (block.tagName !== tagName) {
          const parent = block.parentElement;
          if (!parent) return;
          const list = document.createElement(tagName);
          Array.from(block.childNodes).forEach((child) => list.appendChild(child));
          parent.replaceChild(list, block);
        }
        return;
      }

      if (block.tagName === 'LI') {
        const parent = block.parentElement;
        if (!parent) return;
        if (parent.tagName !== tagName) {
          const list = document.createElement(tagName);
          Array.from(parent.children).forEach((item) => {
            list.appendChild(item);
          });
          parent.replaceWith(list);
        }
        return;
      }

      const list = document.createElement(tagName);
      const li = document.createElement('li');
      Array.from(block.childNodes).forEach((child) => li.appendChild(child));
      list.appendChild(li);
      if (block.parentElement) {
        block.parentElement.replaceChild(list, block);
      }
      const newRange = document.createRange();
      newRange.selectNodeContents(li);
      selection.removeAllRanges();
      selection.addRange(newRange);
    }

    function applyBlockquote() {
      const selection = window.getSelection();
      if (!selection?.rangeCount) return;
      const range = selection.getRangeAt(0);
      const before = editor.innerHTML;
      const ok = document.execCommand('formatBlock', false, '<blockquote>');
      const after = editor.innerHTML;
      if (ok && before !== after) return;
      const block = getCurrentBlockElement(range);
      if (!block || block === editor) return;
      if (block.tagName === 'BLOCKQUOTE') {
        const firstChild = block.firstElementChild;
        if (firstChild) {
          block.parentElement?.replaceChild(firstChild, block);
        }
        return;
      }
      replaceWithBlock(block, 'BLOCKQUOTE');
    }

    function runCommand(command, colorValue) {
      if (currentMode !== 'visual') {
        stateTip.textContent = '先切到文档模式再执行命令。';
        return;
      }

      if (['bold', 'italic', 'underline'].includes(command)) {
        document.execCommand(command, false, null);
      }

      if (command === 'blockquote') {
        applyBlockquote();
      }
      if (command === 'insertOrderedList' || command === 'insertUnorderedList') {
        applyList(command);
      }

      if (command === 'h1') {
        applyHeading(1);
      }
      if (command === 'h2') {
        applyHeading(2);
      }
      if (command === 'h3') {
        applyHeading(3);
      }
      if (command === 'h4') {
        applyHeading(4);
      }
      if (command === 'h5') {
        applyHeading(5);
      }
      if (command === 'h6') {
        applyHeading(6);
      }
      if (command === 'foreColor') {
        applyTextColor(normalizeColor(colorValue));
      }
      editor.focus();
      updatePlaceholder();
      saveDraft();
    }

    modeVisualBtn.addEventListener('click', () => {
      if (currentMode === 'source') {
        editor.innerHTML = sourceToHtml(sourceEditor.value);
      }
      setMode('visual');
      stateTip.textContent = '已切换到文档模式。';
    });

    modeSourceBtn.addEventListener('click', () => {
      if (currentMode === 'visual') {
        sourceEditor.value = editorToMarkdown();
      }
      setMode('source');
      editorPlaceholder.style.display = 'none';
      stateTip.textContent = '已切换到源码模式。';
    });

    buildBtn.addEventListener('click', () => {
      const body = getBodyMarkdown();
      if (!body) {
        stateTip.textContent = '正文为空，先写一些内容。';
        return;
      }
      buildMarkdown();
      setDraftDate();
      saveDraft();
      stateTip.textContent = '已保存到本地草稿。';
      const now = nowDate();
      updatedInput.value = now;
    });

    clearBtn.addEventListener('click', () => {
      titleInput.value = '';
      categoryInput.value = '技巧';
      importanceInput.value = '2';
      tagsInput.value = '';
      summaryInput.value = '';
      editor.innerHTML = '';
      sourceEditor.value = '';
      localStorage.removeItem(LS_KEY);
      dateInput.value = nowDate();
      updatedInput.value = nowDate();
      updatePlaceholder();
      currentMode = 'visual';
      setMode('visual');
      updateModeUI();
      stateTip.textContent = '草稿已清空。';
    });

    commands.forEach((button) => {
      button.addEventListener('click', () => {
        const command = button.getAttribute('data-command');
        if (!command) return;
        const colorValue = button.getAttribute('data-color');
        runCommand(command, colorValue);
      });
    });

    editor.addEventListener('input', () => {
      updatePlaceholder();
      saveDraft();
    });

    editor.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'b') {
        event.preventDefault();
        runCommand('bold');
      }
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'i') {
        event.preventDefault();
        runCommand('italic');
      }
    });

    sourceEditor.addEventListener('input', () => {
      saveDraft();
    });

    [titleInput, categoryInput, tagsInput, summaryInput, importanceInput, typeInput].forEach((input) => {
      if (!input) return;
      input.addEventListener('input', () => {
        setDraftDate();
        saveDraft();
      });
    });

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        saveDraft();
      }
    });

    function init() {
      loadDraft();
      setDraftDate();
      updateModeUI();
      if (!currentMode || currentMode === 'visual') {
        setMode('visual', false);
      } else {
        setMode('source', false);
      }
      editorPlaceholder.textContent = '在这里开始写作（支持标题、列表、引用、代码块、图片粘贴）。例如：输入 / 调出块级命令，或 Ctrl/Cmd+P 打开命令盘。';
      updatePlaceholder();
      requestAnimationFrame(() => {
        updatePlaceholder();
      });
    }

    init();
  </script>

  <style>
    .editor-shell {
      position: relative;
      min-height: 56vh;
    }

    .writer-placeholder {
      position: absolute;
      inset: 0.9rem 1rem auto 1rem;
      color: rgb(148 163 184);
      white-space: pre-wrap;
      pointer-events: none;
      user-select: none;
      font-size: 0.95rem;
      line-height: 1.7;
      z-index: 3;
    }

    .writer-canvas {
      min-height: 56vh;
      width: 100%;
      border: 1px solid rgb(226 232 240);
      border-radius: 0.7rem;
      background-color: rgb(255, 255, 255);
      padding: 0.9rem 1rem;
      color: #0f172a;
      outline: none;
      line-height: 1.7;
      box-sizing: border-box;
      overflow: auto;
      position: relative;
      z-index: 1;
    }

    .writer-canvas:focus-within,
    .writer-canvas:focus {
      border-color: rgb(59 130 246);
      box-shadow: 0 0 0 3px rgb(59 130 246 / 10%);
    }

    .writer-canvas.h-\[56vh\] {
      min-height: 56vh;
    }

    .writer-canvas h1,
    .writer-canvas h2,
    .writer-canvas h3,
    .writer-canvas h4,
    .writer-canvas h5,
    .writer-canvas h6 {
      font-weight: 700;
      margin-top: 1rem;
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }

    .writer-canvas p {
      margin: 0.45rem 0;
    }

    .writer-canvas ul,
    .writer-canvas ol {
      padding-left: 1.4rem;
      margin: 0.7rem 0;
    }

    .writer-canvas blockquote {
      margin: 0.75rem 0;
      padding-left: 0.9rem;
      border-left: 3px solid rgb(148 163 184);
      color: rgb(71 85 105);
    }

    .writer-canvas pre {
      margin: 0.8rem 0;
      padding: 0.8rem;
      border: 1px solid rgb(226 232 240);
      border-radius: 0.5rem;
      background: rgb(241 245 249);
      overflow-x: auto;
      white-space: pre-wrap;
    }

    .writer-canvas img {
      max-width: 100%;
    }

    .writer-canvas hr {
      border: none;
      border-top: 1px solid rgb(226 232 240);
      margin: 1rem 0;
    }

    .btn-tool {
      border: 1px solid rgb(203 213 225);
      border-radius: 0.45rem;
      padding: 0.25rem 0.58rem;
      font-size: 0.8rem;
      color: rgb(15 23 42);
      background: white;
    }

    .btn-tool-active {
      background: rgb(219 234 254);
      border-color: rgb(59 130 246);
      color: rgb(29 78 216);
    }
  </style>
</BaseLayout>
