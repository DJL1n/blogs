---
import BaseLayout from '../layouts/BaseLayout.astro';

const TYPES = [
  { value: 'note', label: '笔记' },
  { value: 'blog', label: '博客' },
  { value: 'important', label: '重要记录' },
  { value: 'diary', label: '日记' },
];
---

<BaseLayout title="写作 · 山不见我" description="Markdown 写作助手">
  <div class="mx-auto max-w-[72rem] px-4 sm:px-6 lg:px-8 animate-fade-in">

    <!-- Toolbar -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded-xl bg-gradient-to-r from-blue-50 to-indigo-50 px-3 py-1 text-xs font-semibold text-blue-700 ring-1 ring-blue-200/60 dark:from-slate-800 dark:to-indigo-950 dark:text-blue-300 dark:ring-blue-800">
          块编辑器
        </span>
      </div>
      <div class="flex gap-2">
        <button id="save-btn" class="btn-primary text-sm" type="button">保存到文件</button>
        <button id="copy-btn" class="btn-secondary text-sm" type="button">复制 Markdown</button>
      </div>
    </div>

    <!-- Title -->
    <input
      id="title-input"
      type="text"
      class="mb-0 block w-full border-0 bg-transparent text-4xl font-black tracking-tight text-slate-900 outline-none placeholder:text-slate-300 dark:text-slate-100 dark:placeholder:text-slate-600"
      placeholder="无标题"
      autocomplete="off"
    />

    <!-- Editor wrapper -->
    <div class="surface-card-elevated mt-4 relative">
      <!-- Format toolbar -->
      <div id="format-bar" class="flex flex-wrap items-center gap-0.5 border-b border-slate-100 pb-3 dark:border-slate-800">
        <button data-cmd="undo" class="fmt-btn" title="撤销" type="button">↩</button>
        <button data-cmd="redo" class="fmt-btn" title="重做" type="button">↪</button>
        <span class="mx-1 text-slate-300 dark:text-slate-600">|</span>
        <button data-cmd="bold" class="fmt-btn font-bold" title="加粗" type="button"><b>B</b></button>
        <button data-cmd="italic" class="fmt-btn" title="斜体" type="button"><i>I</i></button>
        <button data-cmd="strike" class="fmt-btn" title="删除线" type="button"><s>S</s></button>
        <button data-cmd="code" class="fmt-btn" title="行内代码" type="button">&lt;/&gt;</button>
        <span class="mx-1 text-slate-300 dark:text-slate-600">|</span>
        <button data-cmd="h1" class="fmt-btn" title="一级标题" type="button">H1</button>
        <button data-cmd="h2" class="fmt-btn" title="二级标题" type="button">H2</button>
        <button data-cmd="h3" class="fmt-btn" title="三级标题" type="button">H3</button>
        <span class="mx-1 text-slate-300 dark:text-slate-600">|</span>
        <button data-cmd="bulletList" class="fmt-btn" title="无序列表" type="button">• 列表</button>
        <button data-cmd="orderedList" class="fmt-btn" title="有序列表" type="button">1. 列表</button>
        <button data-cmd="taskList" class="fmt-btn" title="任务列表" type="button">☑ 任务</button>
        <button data-cmd="blockquote" class="fmt-btn" title="引用" type="button">〝</button>
        <button data-cmd="codeBlock" class="fmt-btn" title="代码块" type="button">&lt;/&gt; 代码</button>
        <span id="lang-wrapper" class="hidden items-center gap-1 ml-1">
          <span class="text-[10px] text-slate-400 uppercase">语言</span>
          <select id="lang-select" class="text-xs rounded border border-slate-200 bg-white px-1.5 py-0.5 focus:outline-none dark:bg-slate-800 dark:border-slate-600 dark:text-slate-200">
            <option value="">纯文本</option>
            <option value="javascript">JavaScript</option>
            <option value="typescript">TypeScript</option>
            <option value="python">Python</option>
            <option value="html">HTML</option>
            <option value="css">CSS</option>
            <option value="bash">Bash</option>
            <option value="json">JSON</option>
            <option value="sql">SQL</option>
          </select>
        </span>
        <button data-cmd="horizontalRule" class="fmt-btn" title="分割线" type="button">—</button>
      </div>

      <!-- TipTap mount -->
      <div id="editor-mount" class="editor-content"></div>
    </div>

    <!-- Slash menu (created dynamically by TipTap plugin) -->
    <div id="slash-container"></div>

    <!-- Metadata (collapsible) -->
    <details class="surface-card mt-4" id="meta-details">
      <summary class="cursor-pointer text-sm font-medium text-slate-500 select-none">元数据</summary>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="block">
          <span class="text-xs font-medium text-slate-500">类型</span>
          <select id="meta-type" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-800">
            {TYPES.map((t) => <option value={t.value}>{t.label}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-medium text-slate-500">分类</span>
          <input id="meta-category" type="text" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-800" placeholder="技术 / 概念" />
        </label>
        <label class="block">
          <span class="text-xs font-medium text-slate-500">标签（逗号分隔）</span>
          <input id="meta-tags" type="text" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-800" placeholder="macOS, dns, astro" />
        </label>
        <label class="block">
          <span class="text-xs font-medium text-slate-500">重要性</span>
          <input id="meta-importance" type="number" min="1" max="5" value="2" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-800" />
        </label>
        <label class="block sm:col-span-2">
          <span class="text-xs font-medium text-slate-500">摘要</span>
          <textarea id="meta-summary" rows="2" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-800" placeholder="一句话描述"></textarea>
        </label>
      </div>
    </details>

    <!-- Status -->
    <p id="status-bar" class="mt-3 text-center text-xs text-slate-400"></p>
  </div>
</BaseLayout>

<script>
  import { Editor, Extension } from '@tiptap/core';
  import { PluginKey } from '@tiptap/pm/state';
  import StarterKit from '@tiptap/starter-kit';
  import Placeholder from '@tiptap/extension-placeholder';
  import Link from '@tiptap/extension-link';
  import Image from '@tiptap/extension-image';
  import TaskList from '@tiptap/extension-task-list';
  import TaskItem from '@tiptap/extension-task-item';
  import CodeBlockLowlight from '@tiptap/extension-code-block-lowlight';
  import { createLowlight } from 'lowlight';
  import Suggestion from '@tiptap/suggestion';

  // Register common languages for syntax highlighting
  import { common } from 'lowlight';
  const lowlight = createLowlight();
  Object.entries(common).forEach(([k, v]) => lowlight.register(k, v));

  // ── Diary auth ──
  // When this module is imported in a browser context, diary-auth functions are available
  // We use dynamic checks inline rather than importing the module to avoid build issues
  function diaryCheckOrPrompt(): boolean {
    try {
      const hash = localStorage.getItem('kb-diary-hash');
      if (!hash) {
        status('请先在 /diary/settings 设置日记密码', true);
        return false;
      }
      const ts = sessionStorage.getItem('kb-diary-authed');
      if (ts) {
        const elapsed = Date.now() - Number(ts);
        if (elapsed < 2 * 60 * 60 * 1000) return true;
      }
      // Session not authed — show prompt
      const pw = prompt('请输入日记密码：');
      if (!pw) return false;
      // SHA-256 verify inline
      crypto.subtle.digest('SHA-256', new TextEncoder().encode(pw)).then(buf => {
        const hash2 = Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join('');
        if (hash2 === hash) {
          sessionStorage.setItem('kb-diary-authed', Date.now().toString());
          status('日记已解锁');
        } else {
          status('密码错误', true);
        }
      });
      return false;
    } catch {
      return false;
    }
  }

  // ── DOM refs ──
  const $ = (id: string) => document.getElementById(id)!;
  const titleEl = $('title-input') as HTMLInputElement;
  const mountEl = $('editor-mount') as HTMLDivElement;
  const slashContainer = $('slash-container') as HTMLDivElement;
  const typeEl = $('meta-type') as HTMLSelectElement;
  const categoryEl = $('meta-category') as HTMLInputElement;
  const tagsEl = $('meta-tags') as HTMLInputElement;
  const importanceEl = $('meta-importance') as HTMLInputElement;
  const summaryEl = $('meta-summary') as HTMLTextAreaElement;
  const saveBtn = $('save-btn') as HTMLButtonElement;
  const copyBtn = $('copy-btn') as HTMLButtonElement;
  const statusBar = $('status-bar') as HTMLParagraphElement;

  const LS_KEY = 'kb-editor-v3';
  const DEBOUNCE_MS = 600;
  let editor: Editor | null = null;
  let draftTimer: number | null = null;

  // ── Status ──
  function status(msg, err = false) {
    statusBar.textContent = msg;
    statusBar.className = `mt-3 text-center text-xs ${err ? 'text-rose-500' : 'text-slate-400'}`;
  }

  // ── Slash menu items ──
  const SLASH_ITEMS = [
    {
      title: '一级标题',
      description: '大章节标题',
      icon: 'H1',
      command: ({ editor, range }) => editor.chain().focus().deleteRange(range).setHeading({ level: 1 }).run(),
    },
    {
      title: '二级标题',
      description: '章节标题',
      icon: 'H2',
      command: ({ editor, range }) => editor.chain().focus().deleteRange(range).setHeading({ level: 2 }).run(),
    },
    {
      title: '三级标题',
      description: '小节标题',
      icon: 'H3',
      command: ({ editor, range }) => editor.chain().focus().deleteRange(range).setHeading({ level: 3 }).run(),
    },
    {
      title: '无序列表',
      description: '圆点列表',
      icon: '•',
      command: ({ editor, range }) => editor.chain().focus().deleteRange(range).toggleBulletList().run(),
    },
    {
      title: '有序列表',
      description: '编号列表',
      icon: '1.',
      command: ({ editor, range }) => editor.chain().focus().deleteRange(range).toggleOrderedList().run(),
    },
    {
      title: '任务列表',
      description: '带复选框的列表',
      icon: '☑',
      command: ({ editor, range }) => editor.chain().focus().deleteRange(range).toggleTaskList().run(),
    },
    {
      title: '引用块',
      description: '引用文本',
      icon: '〝',
      command: ({ editor, range }) => editor.chain().focus().deleteRange(range).toggleBlockquote().run(),
    },
    {
      title: '代码块',
      description: '代码片段',
      icon: '<>',
      command: ({ editor, range }) => editor.chain().focus().deleteRange(range).toggleCodeBlock().run(),
    },
    {
      title: '分割线',
      description: '水平分隔',
      icon: '—',
      command: ({ editor, range }) => editor.chain().focus().deleteRange(range).setHorizontalRule().run(),
    },
    {
      title: '图片',
      description: '插入图片链接',
      icon: '🖼',
      command: ({ editor, range }) => {
        showImageDialog(editor, range);
      },
    },
  ];

  // ── Slash command extension ──
  const SlashCommands = Extension.create({
    name: 'slashCommands',

    addOptions() {
      return {
        suggestion: {
          char: '/',
          pluginKey: new PluginKey('slashCommands'),
          command: ({ editor, range, props }) => {
            props.command({ editor, range });
          },
          items: ({ query }) => {
            return SLASH_ITEMS
              .filter((item) => item.title.toLowerCase().includes(query.toLowerCase()))
              .slice(0, 10);
          },
          render: () => {
            let popupEl: HTMLElement | null = null;
            let items: any[] = [];
            let selectedIndex = 0;

            function createPopup(props: any) {
              popupEl = document.createElement('div');
              popupEl.className = 'slash-menu';

              const list = document.createElement('div');
              list.className = 'slash-list';

              items = props.items;
              selectedIndex = 0;

              function renderItems() {
                list.innerHTML = '';
                items.forEach((item, i) => {
                  const row = document.createElement('div');
                  row.className = `slash-item${i === selectedIndex ? ' slash-active' : ''}`;
                  row.dataset.index = String(i);

                  const icon = document.createElement('span');
                  icon.className = 'slash-icon';
                  icon.textContent = item.icon;

                  const label = document.createElement('div');
                  label.className = 'slash-label';
                  const titleSpan = document.createElement('span');
                  titleSpan.className = 'slash-title';
                  titleSpan.textContent = item.title;
                  const descSpan = document.createElement('span');
                  descSpan.className = 'slash-desc';
                  descSpan.textContent = item.description;
                  label.appendChild(titleSpan);
                  label.appendChild(descSpan);

                  row.appendChild(icon);
                  row.appendChild(label);

                  row.addEventListener('mousedown', (e) => {
                    e.preventDefault();
                    props.command({ ...props, props: item });
                  });

                  row.addEventListener('mouseenter', () => {
                    selectedIndex = i;
                    renderItems();
                  });

                  list.appendChild(row);
                });
              }

              renderItems();
              popupEl.appendChild(list);
              document.body.appendChild(popupEl);
              positionPopup(props);
            }

            function positionPopup(props: any) {
              if (!popupEl) return;
              const rect = props.clientRect?.();
              if (!rect) return;
              popupEl.style.position = 'fixed';
              popupEl.style.left = `${rect.left}px`;
              popupEl.style.top = `${rect.bottom + 4}px`;
              popupEl.style.zIndex = '1000';
            }

            return {
              onStart: (props) => {
                createPopup(props);
              },
              onUpdate: (props) => {
                items = props.items;
                selectedIndex = 0;
                const list = popupEl?.querySelector('.slash-list');
                if (list) {
                  list.innerHTML = '';
                  items.forEach((item, i) => {
                    const row = document.createElement('div');
                    row.className = `slash-item${i === selectedIndex ? ' slash-active' : ''}`;
                    row.dataset.index = String(i);

                    const icon = document.createElement('span');
                    icon.className = 'slash-icon';
                    icon.textContent = item.icon;

                    const label = document.createElement('div');
                    label.className = 'slash-label';
                    const titleSpan = document.createElement('span');
                    titleSpan.className = 'slash-title';
                    titleSpan.textContent = item.title;
                    const descSpan = document.createElement('span');
                    descSpan.className = 'slash-desc';
                    descSpan.textContent = item.description;
                    label.appendChild(titleSpan);
                    label.appendChild(descSpan);

                    row.appendChild(icon);
                    row.appendChild(label);

                    row.addEventListener('mousedown', (e) => {
                      e.preventDefault();
                      props.command({ ...props, props: item });
                    });

                    row.addEventListener('mouseenter', () => {
                      selectedIndex = i;
                      const allRows = list.querySelectorAll('.slash-item');
                      allRows.forEach((r, idx) => r.classList.toggle('slash-active', idx === selectedIndex));
                    });

                    list.appendChild(row);
                  });
                }
                positionPopup(props);
              },
              onKeyDown: (props) => {
                const { event } = props;
                if (event.key === 'ArrowDown') {
                  event.preventDefault();
                  selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
                  const rows = popupEl?.querySelectorAll('.slash-item');
                  if (rows) {
                    rows.forEach((r, i) => r.classList.toggle('slash-active', i === selectedIndex));
                    rows[selectedIndex]?.scrollIntoView({ block: 'nearest' });
                  }
                  return true;
                }
                if (event.key === 'ArrowUp') {
                  event.preventDefault();
                  selectedIndex = Math.max(selectedIndex - 1, 0);
                  const rows = popupEl?.querySelectorAll('.slash-item');
                  if (rows) {
                    rows.forEach((r, i) => r.classList.toggle('slash-active', i === selectedIndex));
                    rows[selectedIndex]?.scrollIntoView({ block: 'nearest' });
                  }
                  return true;
                }
                if (event.key === 'Enter' || event.key === 'Tab') {
                  event.preventDefault();
                  const item = items[selectedIndex];
                  if (item) {
                    props.command({ ...props, props: item });
                  }
                  return true;
                }
                if (event.key === 'Escape') {
                  event.preventDefault();
                  if (popupEl) {
                    popupEl.remove();
                    popupEl = null;
                  }
                  return true;
                }
                return false;
              },
              onExit: () => {
                if (popupEl) {
                  popupEl.remove();
                  popupEl = null;
                }
              },
            };
          },
        },
      };
    },

    addProseMirrorPlugins() {
      return [
        Suggestion({
          editor: this.editor,
          ...this.options.suggestion,
        }),
      ];
    },
  });

  // ── Markdown serializer (TipTap JSON → Markdown) ──
  function serializeInline(nodes) {
    if (!nodes || nodes.length === 0) return '';
    let md = '';
    for (const node of nodes) {
      if (node.type === 'text') {
        let text = node.text || '';
        if (node.marks) {
          // Apply marks from outside in (bold first, then italic, etc.)
          const linkMark = node.marks.find((m) => m.type === 'link');
          const otherMarks = node.marks.filter((m) => m.type !== 'link');
          for (const mark of otherMarks) {
            switch (mark.type) {
              case 'bold': text = `**${text}**`; break;
              case 'italic': text = `*${text}*`; break;
              case 'strike': text = `~~${text}~~`; break;
              case 'code': text = `\`${text}\``; break;
            }
          }
          if (linkMark) {
            text = `[${text}](${linkMark.attrs?.href || ''})`;
          }
        }
        md += text;
      } else if (node.type === 'hardBreak') {
        md += '\n';
      } else if (node.type === 'image') {
        md += `![${node.attrs?.alt || ''}](${node.attrs?.src || ''})`;
      }
    }
    return md;
  }

  function getTextContent(node) {
    if (!node.content) return '';
    return node.content.map((n) => (n.type === 'text' ? n.text : getTextContent(n))).join('');
  }

  function serializeNode(node) {
    const inline = serializeInline(node.content || []);

    switch (node.type) {
      case 'paragraph':
        return inline || '';
      case 'heading':
        return '#'.repeat(node.attrs?.level || 1) + ' ' + inline;
      case 'bulletList':
        return (node.content || [])
          .map((li) => '- ' + serializeInline(li.content || []))
          .join('\n');
      case 'orderedList':
        return (node.content || [])
          .map((li, i) => `${i + 1}. ` + serializeInline(li.content || []))
          .join('\n');
      case 'taskList':
        return (node.content || [])
          .map((li) => {
            const checked = li.attrs?.checked ? 'x' : ' ';
            return '- [' + checked + '] ' + serializeInline(li.content || []);
          })
          .join('\n');
      case 'listItem':
        return inline; // handled by parent
      case 'taskItem':
        return inline; // handled by parent
      case 'blockquote':
        return inline
          .split('\n')
          .map((line) => '> ' + line)
          .join('\n');
      case 'codeBlock':
        return '```' + (node.attrs?.language || '') + '\n' + getTextContent(node) + '\n```';
      case 'horizontalRule':
        return '---';
      case 'image':
        return `![${node.attrs?.alt || ''}](${node.attrs?.src || ''})`;
      case 'hardBreak':
        return '\n';
      default:
        return inline;
    }
  }

  function editorToMarkdown(editor) {
    const doc = editor.getJSON();
    if (!doc.content || doc.content.length === 0) return '';
    return doc.content
      .map(serializeNode)
      .join('\n\n')
      .replace(/\n{3,}/g, '\n\n')
      .trim() + '\n';
  }

  // ── Simple Markdown → HTML for loading existing content ──
  function simpleMdToHtml(md) {
    if (!md) return '<p></p>';
    const lines = md.split('\n');
    const out: string[] = [];
    let i = 0;
    while (i < lines.length) {
      const line = lines[i];

      // Code block
      if (/^```/.test(line)) {
        const lang = line.slice(3).trim();
        i++;
        const code: string[] = [];
        while (i < lines.length && !/^```/.test(lines[i])) {
          code.push(lines[i].replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'));
          i++;
        }
        i++; // skip closing ```
        out.push(`<pre><code${lang ? ` data-lang="${lang}"` : ''}>${code.join('\n')}</code></pre>`);
        continue;
      }

      // Heading
      const hMatch = line.match(/^(#{1,6})\s+(.+)/);
      if (hMatch) {
        out.push(`<h${hMatch[1].length}>${escapeHtml(hMatch[2])}</h${hMatch[1].length}>`);
        i++;
        continue;
      }

      // HR
      if (/^(-{3,}|\*{3,})$/.test(line.trim())) {
        out.push('<hr>');
        i++;
        continue;
      }

      // Blockquote
      if (/^>\s?/.test(line)) {
        const quotes: string[] = [];
        while (i < lines.length && /^>\s?/.test(lines[i])) {
          quotes.push(lines[i].replace(/^>\s?/, ''));
          i++;
        }
        out.push('<blockquote><p>' + quotes.join('<br>') + '</p></blockquote>');
        continue;
      }

      // Unordered list
      if (/^[-*]\s+/.test(line)) {
        const items: string[] = [];
        while (i < lines.length && /^[-*]\s+/.test(lines[i])) {
          items.push('<li>' + inlineMdToHtml(lines[i].replace(/^[-*]\s+/, '')) + '</li>');
          i++;
        }
        // Check if it's a task list
        if (items.some((item) => item.includes('<li>['))) {
          out.push('<ul data-type="taskList">' + items.join('') + '</ul>');
        } else {
          out.push('<ul>' + items.join('') + '</ul>');
        }
        continue;
      }

      // Ordered list
      if (/^\d+\.\s+/.test(line)) {
        const items: string[] = [];
        while (i < lines.length && /^\d+\.\s+/.test(lines[i])) {
          items.push('<li>' + inlineMdToHtml(lines[i].replace(/^\d+\.\s+/, '')) + '</li>');
          i++;
        }
        out.push('<ol>' + items.join('') + '</ol>');
        continue;
      }

      // Empty line
      if (!line.trim()) {
        out.push('<p><br></p>');
        i++;
        continue;
      }

      // Paragraph
      out.push('<p>' + inlineMdToHtml(line) + '</p>');
      i++;
    }
    return out.join('\n');
  }

  function escapeHtml(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function inlineMdToHtml(s) {
    let t = escapeHtml(s);
    t = t.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1">');
    t = t.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
    t = t.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    t = t.replace(/\*([^*]+)\*/g, '<em>$1</em>');
    t = t.replace(/~~([^~]+)~~/g, '<del>$1</del>');
    t = t.replace(/`([^`]+)`/g, '<code>$1</code>');
    return t;
  }

  // ── Draft persistence ──
  function saveDraft() {
    if (!editor) return;
    if (draftTimer !== null) window.clearTimeout(draftTimer);
    draftTimer = window.setTimeout(() => {
      const data = {
        title: titleEl.value,
        type: typeEl.value,
        category: categoryEl.value,
        tags: tagsEl.value,
        importance: importanceEl.value,
        summary: summaryEl.value,
        editorJson: editor!.getJSON(),
        savedAt: Date.now(),
      };
      try {
        localStorage.setItem(LS_KEY, JSON.stringify(data));
        status('草稿已保存');
      } catch {
        // localStorage quota exceeded
      }
    }, DEBOUNCE_MS);
  }

  function loadDraft() {
    const params = new URLSearchParams(window.location.search);
    const hasParams = params.has('title') || params.has('body') || params.has('type');

    if (hasParams) {
      titleEl.value = params.get('title') || '';
      typeEl.value = params.get('type') || 'note';
      categoryEl.value = params.get('category') || '';
      tagsEl.value = params.get('tags') || '';
      importanceEl.value = params.get('importance') || '2';
      summaryEl.value = params.get('summary') || '';
      const body = params.get('body');
      if (body && editor) {
        const decoded = decodeURIComponent(body);
        const html = simpleMdToHtml(decoded);
        editor.commands.setContent(html);
      }
      status('已加载文章内容');
      saveDraft();
      return;
    }

    // Restore from localStorage
    try {
      const raw = localStorage.getItem(LS_KEY);
      if (!raw) { status('新文章'); return; }
      const d = JSON.parse(raw);
      titleEl.value = d.title || '';
      typeEl.value = d.type || 'note';
      categoryEl.value = d.category || '';
      tagsEl.value = d.tags || '';
      importanceEl.value = d.importance || '2';
      summaryEl.value = d.summary || '';
      if (d.editorJson && editor) {
        editor.commands.setContent(d.editorJson);
      }
      status('已恢复草稿');
    } catch {
      status('新文章');
    }
  }

  // ── Build markdown for save ──
  function buildMarkdown() {
    const title = titleEl.value.trim() || '无标题';
    const body = editor ? editorToMarkdown(editor) : '';
    const now = new Date().toISOString().slice(0, 10);
    const tags = tagsEl.value.split(',').map((s) => s.trim()).filter(Boolean);
    const type = typeEl.value || 'note';
    const category = categoryEl.value.trim() || '技巧';
    const importance = Math.min(Math.max(Number(importanceEl.value) || 2, 1), 5);
    const summary = summaryEl.value.trim() || '待补充';

    return [
      '---',
      `title: ${JSON.stringify(title)}`,
      `date: ${now}`,
      `updated: ${now}`,
      `summary: ${JSON.stringify(summary)}`,
      `tags: [${tags.map((t) => JSON.stringify(t)).join(', ')}]`,
      `category: ${JSON.stringify(category)}`,
      `type: ${JSON.stringify(type)}`,
      `importance: ${importance}`,
      'draft: false',
      '---',
      '',
      body || '正文内容待补充。',
      '',
    ].join('\n');
  }

  function buildFileName() {
    const title = titleEl.value.trim() || '无标题';
    const now = new Date().toISOString().slice(0, 10);
    const slug = title
      .replace(/\s+/g, '-')
      .replace(/[\\/:*?"<>|]/g, '')
      .replace(/-+/g, '-')
      .replace(/(^-|-$)/g, '')
      .slice(0, 60)
      .toLowerCase() || 'untitled';
    return `${now}-${slug}`;
  }

  // ── Save ──
  async function save() {
    const title = titleEl.value.trim();
    const category = categoryEl.value.trim();
    const summary = summaryEl.value.trim();
    if (!title) { status('请填写标题', true); return; }
    if (!category) { status('请填写分类', true); return; }
    if (!summary) { status('请填写摘要', true); return; }

    // Diary type requires password
    if (typeEl.value === 'diary' && !diaryCheckOrPrompt()) { return; }

    const markdown = buildMarkdown();
    const filename = buildFileName(); // NO EXTENSION — API adds .md
    const type = typeEl.value || 'note';

    saveBtn.textContent = '保存中...';
    saveBtn.disabled = true;

    try {
      const resp = await fetch('/api/editor-save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ markdown, filename, type }),
      });
      const result = await resp.json();
      if (result.ok) {
        status(`已保存: ${result.path}${result.commit ? ` (commit: ${result.commit})` : ''}`);
        saveDraft();
      } else {
        status(`保存失败: ${result.reason}`, true);
      }
    } catch (e: any) {
      status(`网络错误: ${e.message || '请确认 dev server 已启动'}`, true);
    } finally {
      saveBtn.textContent = '保存到文件';
      saveBtn.disabled = false;
    }
  }

  // ── Copy ──
  function copyMd() {
    const md = buildMarkdown();
    navigator.clipboard.writeText(md).then(() => {
      status('Markdown 已复制到剪贴板');
      setTimeout(() => status(''), 2000);
    }).catch(() => status('复制失败', true));
  }

  // ── Format bar ──
  function execCmd(cmd) {
    if (!editor) return;
    editor.chain().focus().run();

    switch (cmd) {
      case 'undo': editor.chain().undo().run(); break;
      case 'redo': editor.chain().redo().run(); break;
      case 'bold': editor.chain().toggleBold().run(); break;
      case 'italic': editor.chain().toggleItalic().run(); break;
      case 'strike': editor.chain().toggleStrike().run(); break;
      case 'code': editor.chain().toggleCode().run(); break;
      case 'h1': editor.chain().toggleHeading({ level: 1 }).run(); break;
      case 'h2': editor.chain().toggleHeading({ level: 2 }).run(); break;
      case 'h3': editor.chain().toggleHeading({ level: 3 }).run(); break;
      case 'bulletList': editor.chain().toggleBulletList().run(); break;
      case 'orderedList': editor.chain().toggleOrderedList().run(); break;
      case 'taskList': editor.chain().toggleTaskList().run(); break;
      case 'blockquote': editor.chain().toggleBlockquote().run(); break;
      case 'codeBlock': editor.chain().toggleCodeBlock().run(); break;
      case 'horizontalRule': editor.chain().setHorizontalRule().run(); break;
    }
  }

  // ── Image upload ──
  async function uploadImage(file: File) {
    const formData = new FormData();
    formData.append('image', file);
    try {
      const resp = await fetch('/api/editor-upload', { method: 'POST', body: formData });
      const result = await resp.json();
      if (result.ok && editor) {
        editor.chain().focus().setImage({ src: result.url }).run();
        status('图片已上传');
      } else {
        status('图片上传失败', true);
      }
    } catch {
      status('图片上传失败，请确认 dev server 已启动', true);
    }
  }

  // ── Image dialog ──
  function showImageDialog(editor: any, range: any) {
    const existing = document.querySelector('.editor-image-dialog');
    if (existing) existing.remove();

    const overlay = document.createElement('div');
    overlay.className = 'editor-image-dialog fixed inset-0 z-50 flex items-center justify-center bg-black/20 dark:bg-black/40';
    overlay.innerHTML = `
      <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-xl max-w-sm w-full mx-4">
        <h3 class="text-lg font-bold mb-4 text-slate-900 dark:text-slate-100">插入图片</h3>

        <!-- Upload tab -->
        <div class="mb-4">
          <div class="flex gap-2 mb-3">
            <button id="img-tab-upload" class="img-tab img-tab-active" type="button">上传文件</button>
            <button id="img-tab-url" class="img-tab" type="button">网络链接</button>
          </div>

          <!-- File upload panel -->
          <div id="img-panel-upload">
            <div class="border-2 border-dashed border-slate-200 dark:border-slate-600 rounded-lg p-6 text-center cursor-pointer hover:border-blue-400 dark:hover:border-blue-500 transition-colors" id="img-dropzone">
              <p class="text-slate-400 dark:text-slate-500 text-sm">点击选择图片，或直接粘贴/拖拽</p>
              <input id="img-file-input" type="file" accept="image/*" class="hidden" />
            </div>
          </div>

          <!-- URL panel -->
          <div id="img-panel-url" class="hidden">
            <label class="block text-sm font-medium text-slate-600 dark:text-slate-300 mb-1">图片 URL</label>
            <input id="img-url" type="url" class="w-full rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="https://example.com/image.png" />
          </div>
        </div>

        <label class="block text-sm font-medium text-slate-600 dark:text-slate-300 mb-1">替代文本</label>
        <input id="img-alt" type="text" class="w-full rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="图片描述（选填）" />
        <div class="flex gap-2 mt-4 justify-end">
          <button id="img-cancel" class="px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-600 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700" type="button">取消</button>
          <button id="img-insert" class="px-4 py-2 rounded-lg bg-blue-600 text-sm text-white font-medium hover:bg-blue-500" type="button">插入</button>
        </div>
      </div>`;

    document.body.appendChild(overlay);

    const imgUrl = overlay.querySelector('#img-url') as HTMLInputElement;
    const imgAlt = overlay.querySelector('#img-alt') as HTMLInputElement;
    const fileInput = overlay.querySelector('#img-file-input') as HTMLInputElement;
    const dropzone = overlay.querySelector('#img-dropzone') as HTMLDivElement;
    const insertBtn = overlay.querySelector('#img-insert') as HTMLButtonElement;
    const cancelBtn = overlay.querySelector('#img-cancel') as HTMLButtonElement;
    const tabUpload = overlay.querySelector('#img-tab-upload') as HTMLButtonElement;
    const tabUrl = overlay.querySelector('#img-tab-url') as HTMLButtonElement;
    const panelUpload = overlay.querySelector('#img-panel-upload') as HTMLDivElement;
    const panelUrl = overlay.querySelector('#img-panel-url') as HTMLDivElement;

    let pendingFile: File | null = null;

    // Tab switching
    tabUpload.onclick = () => {
      tabUpload.classList.add('img-tab-active');
      tabUrl.classList.remove('img-tab-active');
      panelUpload.classList.remove('hidden');
      panelUrl.classList.add('hidden');
    };
    tabUrl.onclick = () => {
      tabUrl.classList.add('img-tab-active');
      tabUpload.classList.remove('img-tab-active');
      panelUrl.classList.remove('hidden');
      panelUpload.classList.add('hidden');
    };

    // File picker
    dropzone.onclick = () => fileInput.click();
    fileInput.onchange = () => {
      const f = fileInput.files?.[0];
      if (f) {
        pendingFile = f;
        dropzone.innerHTML = `<p class="text-sm text-blue-600 dark:text-blue-400">已选择: ${f.name}</p>`;
      }
    };

    // Drag over dropzone
    dropzone.ondragover = (e: DragEvent) => { e.preventDefault(); dropzone.classList.add('border-blue-400'); };
    dropzone.ondragleave = () => { dropzone.classList.remove('border-blue-400'); };
    dropzone.ondrop = (e: DragEvent) => {
      e.preventDefault();
      dropzone.classList.remove('border-blue-400');
      const f = e.dataTransfer?.files?.[0];
      if (f) {
        pendingFile = f;
        dropzone.innerHTML = `<p class="text-sm text-blue-600 dark:text-blue-400">已选择: ${f.name}</p>`;
      }
    };

    cancelBtn.onclick = () => overlay.remove();
    insertBtn.onclick = () => {
      const alt = imgAlt.value.trim();
      if (pendingFile) {
        // Upload file
        const formData = new FormData();
        formData.append('image', pendingFile);
        fetch('/api/editor-upload', { method: 'POST', body: formData })
          .then((r) => r.json())
          .then((result) => {
            if (result.ok) {
              editor.chain().focus().deleteRange(range).setImage({ src: result.url, alt }).run();
            } else {
              status('图片上传失败', true);
            }
          })
          .catch(() => status('图片上传失败', true));
      } else {
        const url = imgUrl.value.trim();
        if (url) {
          editor.chain().focus().deleteRange(range).setImage({ src: url, alt }).run();
        }
      }
      overlay.remove();
    };
    overlay.onclick = (e: MouseEvent) => { if (e.target === overlay) overlay.remove(); };
    imgUrl.onkeydown = (e: KeyboardEvent) => { if (e.key === 'Enter') insertBtn.click(); };
  }

  // ── Init editor ──
  function initEditor() {
    editor = new Editor({
      element: mountEl,
      extensions: [
        StarterKit.configure({
          // TaskList requires custom list handling, disable default list
          bulletList: { keepMarks: true },
          orderedList: { keepMarks: true },
          codeBlock: false,
        }),
        CodeBlockLowlight.configure({
          lowlight,
        }),
        Placeholder.configure({
          placeholder: '按 / 选择块类型，或直接输入…',
        }),
        Link.configure({
          openOnClick: true,
          HTMLAttributes: { class: 'editor-link' },
        }),
        Image.configure({
          inline: false,
          allowBase64: true,
          HTMLAttributes: { class: 'editor-image' },
        }),
        TaskList,
        TaskItem.configure({
          nested: true,
          HTMLAttributes: { class: 'editor-task-item' },
        }),
        SlashCommands,
      ],
      editorProps: {
        attributes: {
          class: 'prose prose-slate dark:prose-invert max-w-none focus:outline-none min-h-[50vh]',
        },
        handleDOMEvents: {
          keydown: (_view, event) => {
            // Ctrl+S / Cmd+S
            if ((event.metaKey || event.ctrlKey) && event.key === 's') {
              event.preventDefault();
              save();
              return true;
            }
            return false;
          },
          paste: (_view, event) => {
            // Check clipboardData.files first (macOS Finder copy)
            const files = event.clipboardData?.files;
            if (files && files.length > 0) {
              for (const file of Array.from(files)) {
                if (file.type.startsWith('image/')) {
                  event.preventDefault();
                  uploadImage(file);
                  return true;
                }
              }
            }
            // Then check items (browser/web copy)
            const items = event.clipboardData?.items;
            if (!items) return false;
            for (const item of Array.from(items)) {
              if (item.type.startsWith('image/')) {
                event.preventDefault();
                const file = item.getAsFile();
                if (file) uploadImage(file);
                return true;
              }
            }
            return false;
          },
          drop: (_view, event) => {
            const files = event.dataTransfer?.files;
            if (!files || files.length === 0) return false;
            for (const file of Array.from(files)) {
              if (file.type.startsWith('image/')) {
                event.preventDefault();
                uploadImage(file);
                return true;
              }
            }
            return false;
          },
        },
      },
      onCreate: () => {
        loadDraft();
        status('就绪');
      },
      onUpdate: () => {
        saveDraft();
      },
      onSelectionUpdate: () => {
        const inCodeBlock = editor!.isActive('codeBlock');
        langWrapper.classList.toggle('hidden', !inCodeBlock);
        if (inCodeBlock) {
          const lang = editor!.getAttributes('codeBlock').language || '';
          langSelect.value = lang;
        }
      },
    });
  }

  // ── Event bindings ──
  document.querySelectorAll('[data-cmd]').forEach((btn) => {
    (btn as HTMLElement).addEventListener('click', () => execCmd((btn as HTMLElement).dataset.cmd));
  });

  [titleEl, typeEl, categoryEl, tagsEl, importanceEl, summaryEl].forEach((el) =>
    el?.addEventListener('input', () => saveDraft())
  );

  // Diary type: prompt for password on selection
  typeEl.addEventListener('change', () => {
    if (typeEl.value === 'diary') {
      diaryCheckOrPrompt();
    }
  });

  saveBtn.addEventListener('click', () => save());
  copyBtn.addEventListener('click', () => copyMd());

  // ── Language selector ──
  const langWrapper = $('lang-wrapper') as HTMLElement;
  const langSelect = $('lang-select') as HTMLSelectElement;

  langSelect.addEventListener('change', () => {
    if (!editor) return;
    editor.chain().focus().updateAttributes('codeBlock', { language: langSelect.value }).run();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') saveDraft();
  });

  // Cleanup on page leave
  window.addEventListener('beforeunload', () => {
    editor?.destroy();
  });

  // ── Go! ──
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEditor);
  } else {
    initEditor();
  }
</script>

