      color: #0f172a;
      outline: none;
      line-height: 1.7;
      position: relative;
      box-sizing: border-box;
    }
    .writer-canvas.is-empty::before {
      content: attr(data-placeholder);
      position: absolute;
      inset: 0.9rem 1rem;
      color: rgb(148 163 184);
      pointer-events: none;
      white-space: pre-wrap;
      user-select: none;
      font-size: 0.95rem;
    }
    .writer-canvas.is-empty:focus::before {
