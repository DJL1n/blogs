      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
      font-size: 0.82em;
    }
    .btn-tool {
      border: 1px solid rgb(203 213 225);
      border-radius: 0.45rem;
      padding: 0.25rem 0.58rem;
