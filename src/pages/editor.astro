---
import BaseLayout from '../layouts/BaseLayout.astro';

const TYPES = [
  { value: 'note', label: 'note（短笔记）' },
  { value: 'blog', label: 'blog（长文）' },
  { value: 'important', label: 'important（重要记录）' }
];
---

<BaseLayout title="写作助手" description="本地写作模板，生成 Markdown 内容文件">
  <section class="space-y-6">
    <header>
      <p class="inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 dark:border-emerald-700 dark:bg-slate-800 dark:text-emerald-200">写作工作流</p>
      <h1 class="mt-3 text-4xl font-bold">写作助手</h1>
      <p class="mt-2 text-slate-600 dark:text-slate-300">推荐在这里写作，提交时直接输出标准 Markdown 文件，保存在 <code>src/content/*</code> 下。</p>
    </header>

    <section class="grid gap-4 lg:grid-cols-[2fr_1fr]">
      <form id="writer-form" class="surface-card space-y-4" autocomplete="off">
        <div class="grid gap-3 md:grid-cols-2">
          <label class="space-y-2">
            <span class="text-sm font-medium">标题</span>
            <input id="title" type="text" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800" placeholder="输入标题" />
          </label>

          <label class="space-y-2">
            <span class="text-sm font-medium">类型</span>
            <select id="type" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800">
              {TYPES.map((item) => (
                <option value={item.value}>{item.label}</option>
              ))}
            </select>
          </label>

          <label class="space-y-2">
            <span class="text-sm font-medium">分类</span>
            <input id="category" type="text" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800" value="技巧" />
          </label>

          <label class="space-y-2">
            <span class="text-sm font-medium">重要性（1-5）</span>
            <input id="importance" type="number" min="1" max="5" value="2" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800" />
          </label>

          <label class="space-y-2 md:col-span-2">
            <span class="text-sm font-medium">标签</span>
            <input id="tags" type="text" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800" placeholder="macOS, dns, network" />
            <span class="text-xs text-slate-500">用英文逗号分隔</span>
          </label>

          <label class="space-y-2 md:col-span-2">
            <span class="text-sm font-medium">摘要</span>
            <textarea id="summary" rows="2" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800" placeholder="一句话说明这篇内容"></textarea>
          </label>

          <label class="space-y-2 md:col-span-2">
            <span class="text-sm font-medium">正文（Markdown）</span>
            <textarea id="body" rows="18" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-mono text-sm dark:border-slate-600 dark:bg-slate-800"></textarea>
          </label>

          <label class="space-y-2 md:col-span-2">
            <span class="text-sm font-medium">图片（可选）</span>
            <input id="images" type="file" accept="image/*" multiple class="block w-full text-sm text-slate-600 dark:text-slate-300" />
            <p id="image-hint" class="text-xs text-slate-500">支持直接插入 base64 图片，适合小图演示；大图建议放 <code>public/images</code> 后再引用相对路径。</p>
          </label>
        </div>

        <div class="flex flex-wrap gap-3">
          <button type="button" id="build-btn" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500">生成 Markdown</button>
          <button type="button" id="copy-btn" class="rounded-md border border-slate-300 px-4 py-2 text-sm dark:border-slate-700">复制内容</button>
          <button type="button" id="download-btn" class="rounded-md border border-slate-300 px-4 py-2 text-sm dark:border-slate-700">下载 .md</button>
          <button type="button" id="clear-btn" class="rounded-md border border-rose-300 px-4 py-2 text-sm text-rose-600 dark:border-rose-700 dark:text-rose-300">清空草稿</button>
        </div>

        <p id="state-tip" class="text-sm text-slate-500 dark:text-slate-300">点击「生成 Markdown」后查看可直接提交的文件内容。</p>
      </form>

      <aside class="surface-card">
        <h2 class="mb-2 text-lg font-semibold">生成结果</h2>
        <p class="mb-3 text-sm text-slate-500 dark:text-slate-300">会自动生成 frontmatter + 正文。</p>
        <pre class="rounded-xl bg-slate-900 text-slate-100"><code id="output" class="block min-h-[22rem] overflow-x-auto p-4 text-xs">（先填写并点击「生成 Markdown」）</code></pre>
      </aside>
    </section>
  </section>

  <script is:inline>
    const LS_KEY = 'kb-editor-draft-v1';
    const form = document.getElementById('writer-form');
    const titleInput = document.getElementById('title');
    const typeInput = document.getElementById('type');
    const categoryInput = document.getElementById('category');
    const importanceInput = document.getElementById('importance');
    const tagsInput = document.getElementById('tags');
    const summaryInput = document.getElementById('summary');
    const bodyInput = document.getElementById('body');
    const imagesInput = document.getElementById('images');
    const imageHint = document.getElementById('image-hint');
    const buildBtn = document.getElementById('build-btn');
    const copyBtn = document.getElementById('copy-btn');
    const downloadBtn = document.getElementById('download-btn');
    const clearBtn = document.getElementById('clear-btn');
    const output = document.getElementById('output');
    const stateTip = document.getElementById('state-tip');

    function toDateString(date = new Date()) {
      return date.toISOString().slice(0, 10);
    }

    function toYamlString(value) {
      return JSON.stringify(String(value));
    }

    function slugify(value) {
      return String(value || '')
        .trim()
        .toLowerCase()
        .replace(/\s+/g, '-')
        .replace(/[^a-z0-9\u4e00-\u9fff_-]/g, '')
        .replace(/-+/g, '-')
        .replace(/(^-|-$)/g, '')
        .slice(0, 80) || `post-${toDateString()}`;
    }

    function readMarkdownData() {
      return {
        title: titleInput.value.trim(),
        type: typeInput.value,
        category: categoryInput.value.trim() || '技巧',
        importance: Math.min(Math.max(Number(importanceInput.value || 2), 1), 5),
        tags: tagsInput.value
          .split(',')
          .map((tag) => tag.trim())
          .filter(Boolean),
        summary: summaryInput.value.trim(),
        body: bodyInput.value.replace(/\n+$/g, ''),
      };
    }

    function buildMarkdown(data) {
      const now = toDateString();
      const slug = slugify(data.title || 'untitled');
      const tags = data.tags.length > 0 ? `[${data.tags.map((item) => JSON.stringify(item)).join(', ')}]` : '[]';
      const metaType = data.type === 'notes' ? 'note' : data.type;
      const folder = data.type === 'note' ? 'notes' : data.type;

      return `---\n` +
        `title: ${toYamlString(data.title || '无标题')}\n` +
        `date: ${now}\n` +
        `updated: ${now}\n` +
        `summary: ${toYamlString(data.summary || '待补充')}\n` +
        `tags: ${tags}\n` +
        `category: ${toYamlString(data.category)}\n` +
        `type: ${toYamlString(metaType)}\n` +
        `importance: ${Number(data.importance)}\n` +
        `draft: false\n` +
        `---\n\n` +
        `${data.body || '请在此补充正文内容。'}\n\n` +
        `<!-- 文件建议路径 -->\n` +
        `<!-- src/content/${folder}/${slug}.md -->\n`;
    }

    function saveDraft() {
      const draft = readMarkdownData();
      localStorage.setItem(LS_KEY, JSON.stringify(draft));
    }

    function hydrateDraft() {
      const raw = localStorage.getItem(LS_KEY);
      if (!raw) return;

      try {
        const saved = JSON.parse(raw);
        titleInput.value = saved.title || '';
        typeInput.value = saved.type || 'note';
        categoryInput.value = saved.category || '技巧';
        importanceInput.value = String(saved.importance || 2);
        tagsInput.value = (saved.tags || []).join(', ');
        summaryInput.value = saved.summary || '';
        bodyInput.value = saved.body || '';
        stateTip.textContent = '已恢复上次本地草稿。你可以继续编辑后重新生成。';
      } catch (err) {
        console.error(err);
      }
    }

    async function insertImage(fileList) {
      const files = Array.from(fileList || []);
      if (!files.length) return;

      const promises = files.map((file) => {
        if (!file.type.startsWith('image/')) return null;
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve({ name: file.name, data: String(reader.result) });
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
      });

      const ready = (await Promise.all(promises)).filter(Boolean);
      if (!ready.length) return;

      const start = bodyInput.selectionStart || bodyInput.value.length;
      const end = bodyInput.selectionEnd || bodyInput.value.length;
      const before = bodyInput.value.slice(0, start);
      const after = bodyInput.value.slice(end);
      const mdSnippets = ready.map(({ name, data }) => {
        const base = name.replace(/\.[^.]+$/, '') || 'image';
        const safe = base.replace(/[^a-zA-Z0-9-_\u4e00-\u9fff]/g, '_');
        return `![${safe}](${data})`;
      });

      const inserted = `${before}\n\n${mdSnippets.join('\n\n')}\n\n${after}`;
      bodyInput.value = inserted;
      saveDraft();
      imageHint.textContent = `已插入 ${ready.length} 张图片（base64）。若有大图请改用 public/images 引用。`;
    }

    form.addEventListener('input', saveDraft);

    buildBtn.addEventListener('click', () => {
      const data = readMarkdownData();
      const result = buildMarkdown(data);
      output.textContent = result;
      stateTip.textContent = '已生成 Markdown，可复制或下载为 .md 文件。';
      saveDraft();
    });

    copyBtn.addEventListener('click', async () => {
      if (!output.textContent.trim()) {
        stateTip.textContent = '先点击「生成 Markdown」再复制。';
        return;
      }

      try {
        await navigator.clipboard.writeText(output.textContent);
        copyBtn.textContent = '已复制';
        stateTip.textContent = 'Markdown 已复制到剪贴板。';
        window.setTimeout(() => {
          copyBtn.textContent = '复制内容';
        }, 1100);
      } catch (err) {
        stateTip.textContent = '复制失败，请手动选择代码块内容复制。';
      }
    });

    downloadBtn.addEventListener('click', () => {
      if (!output.textContent.trim()) {
        stateTip.textContent = '先点击「生成 Markdown」再下载。';
        return;
      }

      const title = titleInput.value.trim() || 'untitled';
      const fileName = `${slugify(title)}.md`;
      const blob = new Blob([output.textContent], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      a.click();
      URL.revokeObjectURL(url);
      const targetFolder = typeInput.value === 'note' ? 'notes' : typeInput.value;
      stateTip.textContent = `已下载 ${fileName}，建议放到 src/content/${targetFolder}/ 下。`;
    });

    clearBtn.addEventListener('click', () => {
      titleInput.value = '';
      categoryInput.value = '技巧';
      importanceInput.value = '2';
      tagsInput.value = '';
      summaryInput.value = '';
      bodyInput.value = '';
      imagesInput.value = '';
      output.textContent = '（先填写并点击「生成 Markdown」）';
      stateTip.textContent = '草稿已清空。';
      localStorage.removeItem(LS_KEY);
    });

    imagesInput.addEventListener('change', (event) => {
      const target = event.target;
      if (!target.files || target.files.length === 0) return;
      insertImage(target.files);
      target.value = '';
    });

    hydrateDraft();
  </script>
</BaseLayout>
