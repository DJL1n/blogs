---
import BaseLayout from '../layouts/BaseLayout.astro';

const TYPES = [
  { value: 'note', label: 'note（短笔记）' },
  { value: 'blog', label: 'blog（长文）' },
  { value: 'important', label: 'important（重要记录）' },
];
---

<BaseLayout title="写作助手" description="本地可视化写作模板，导出 Markdown 并保存到 src/content/* 下">
  <section class="space-y-6">
    <header>
      <p class="inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 dark:border-emerald-700 dark:bg-slate-800 dark:text-emerald-200">
        写作工作流
      </p>
      <h1 class="mt-3 text-4xl font-bold">写作助手</h1>
      <p class="mt-2 text-slate-600 dark:text-slate-300">
        用文档方式创作，底层仍输出 Markdown，后续只需要把文件拷贝到对应的
        <code>src/content/{'{'}blog | notes | important{'}'}</code>
        目录即可。
      </p>
    </header>

    <section class="grid gap-4 xl:grid-cols-[1.1fr_0.9fr]">
      <form id="writer-form" class="space-y-4" autocomplete="off">
        <div class="surface-card space-y-4">
          <h2 class="text-lg font-semibold">元数据</h2>
          <div class="grid gap-3 md:grid-cols-2">
            <label class="space-y-2">
              <span class="text-sm font-medium">标题</span>
              <input
                id="title"
                type="text"
                class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800"
                placeholder="输入标题"
              />
            </label>

            <label class="space-y-2">
              <span class="text-sm font-medium">类型</span>
              <select
                id="type"
                class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800"
              >
                {TYPES.map((item) => <option value={item.value}>{item.label}</option>)}
              </select>
            </label>

            <label class="space-y-2">
              <span class="text-sm font-medium">分类</span>
              <input
                id="category"
                type="text"
                class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800"
                value="技巧"
              />
            </label>

            <label class="space-y-2">
              <span class="text-sm font-medium">重要性（1-5）</span>
              <input
                id="importance"
                type="number"
                min="1"
                max="5"
                value="2"
                class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800"
              />
            </label>

            <label class="space-y-2">
              <span class="text-sm font-medium">发布时间（自动）</span>
              <p id="date-text" class="h-10 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">-</p>
              <input id="date" type="hidden" />
            </label>

            <label class="space-y-2">
              <span class="text-sm font-medium">更新时间（自动）</span>
              <p id="updated-text" class="h-10 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">-</p>
              <input id="updated" type="hidden" />
            </label>

            <label class="space-y-2 md:col-span-2">
              <span class="text-sm font-medium">标签（英文逗号分隔）</span>
              <input
                id="tags"
                type="text"
                class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800"
                placeholder="macOS, dns, network"
              />
            </label>

            <label class="space-y-2 md:col-span-2">
              <span class="text-sm font-medium">摘要</span>
              <textarea
                id="summary"
                rows="2"
                class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-800"
                placeholder="一句话说明这篇内容"
              ></textarea>
            </label>
          </div>
        </div>

        <div class="surface-card">
          <div class="mb-3 flex flex-wrap gap-2 border-b border-slate-200 pb-3 dark:border-slate-700">
            <button type="button" data-command="bold" class="btn-tool" title="加粗 (Ctrl/Cmd+B)">B</button>
            <button type="button" data-command="italic" class="btn-tool" title="斜体 (Ctrl/Cmd+I)">I</button>
            <button type="button" data-command="underline" class="btn-tool" title="下划线">U</button>
            <span class="w-px bg-slate-300 dark:bg-slate-600"></span>
            <button type="button" data-block="h1" class="btn-tool" title="标题 1">H1</button>
            <button type="button" data-block="h2" class="btn-tool" title="标题 2">H2</button>
            <button type="button" data-block="h3" class="btn-tool" title="标题 3">H3</button>
            <button type="button" data-command="insertUnorderedList" class="btn-tool" title="无序列表">• 列表</button>
            <button type="button" data-command="insertOrderedList" class="btn-tool" title="有序列表">1. 列表</button>
            <button type="button" data-command="formatBlock" data-value="BLOCKQUOTE" class="btn-tool" title="引用">引用</button>
            <button type="button" data-command="formatBlock" data-value="PRE" class="btn-tool" title="代码块">代码块</button>
            <button type="button" id="link-btn" class="btn-tool" title="插入链接">🔗</button>
            <button type="button" id="undo-btn" data-command="undo" class="btn-tool" title="撤销">↶</button>
            <button type="button" id="redo-btn" data-command="redo" class="btn-tool" title="重做">↷</button>
            <label class="inline-flex items-center rounded-md border border-slate-300 px-3 py-1.5 text-sm dark:border-slate-700">
              <input id="color-picker" type="color" value="#0f172a" class="h-5 w-7 border-none bg-transparent p-0" title="字体颜色" />
              <span class="ml-2 text-xs">颜色</span>
            </label>
            <button type="button" id="clear-format-btn" class="btn-tool" title="清除格式">清空格式</button>
          </div>

          <div
            id="editor"
            class="writer-canvas is-empty"
            contenteditable="true"
            spellcheck="true"
            aria-label="正文编辑区"
            data-placeholder="在这里开始写作（支持标题、列表、引用、代码块、图片粘贴）。例如：Ctrl/Cmd + B 加粗，Ctrl/Cmd + V 粘贴图片。"
          ></div>
        </div>

        <div class="flex flex-wrap gap-3">
          <button type="button" id="build-btn" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500">
            生成 Markdown
          </button>
          <button type="button" id="copy-btn" class="rounded-md border border-slate-300 px-4 py-2 text-sm dark:border-slate-700">
            复制内容
          </button>
          <button type="button" id="download-btn" class="rounded-md border border-slate-300 px-4 py-2 text-sm dark:border-slate-700">
            下载 .md
          </button>
          <button type="button" id="clear-btn" class="rounded-md border border-rose-300 px-4 py-2 text-sm text-rose-600 dark:border-rose-700 dark:text-rose-300">
            清空草稿
          </button>
        </div>
        <p id="state-tip" class="text-sm text-slate-500 dark:text-slate-300">支持像写文档一样编辑；生成后可直接复制或下载。</p>
      </form>

      <aside class="surface-card">
        <h2 class="mb-2 text-lg font-semibold">生成结果</h2>
        <p class="mb-3 text-sm text-slate-500 dark:text-slate-300">会自动生成 frontmatter + 正文 Markdown。</p>
        <pre class="rounded-xl bg-slate-900 text-slate-100"><code id="output" class="block min-h-[22rem] overflow-x-auto p-4 text-xs">（点击「生成 Markdown」后自动输出）</code></pre>
      </aside>
    </section>
  </section>

  <script is:inline>
    const LS_KEY = 'kb-editor-draft-v2';
    const form = document.getElementById('writer-form');
    const titleInput = document.getElementById('title');
    const typeInput = document.getElementById('type');
    const categoryInput = document.getElementById('category');
    const importanceInput = document.getElementById('importance');
    const dateInput = document.getElementById('date');
    const updatedInput = document.getElementById('updated');
    const tagsInput = document.getElementById('tags');
    const summaryInput = document.getElementById('summary');
    const editor = document.getElementById('editor');
    const buildBtn = document.getElementById('build-btn');
    const copyBtn = document.getElementById('copy-btn');
    const downloadBtn = document.getElementById('download-btn');
    const clearBtn = document.getElementById('clear-btn');
    const output = document.getElementById('output');
    const stateTip = document.getElementById('state-tip');
    const linkBtn = document.getElementById('link-btn');
    const undoBtn = document.getElementById('undo-btn');
    const redoBtn = document.getElementById('redo-btn');
    const colorPicker = document.getElementById('color-picker');
    const clearFormatBtn = document.getElementById('clear-format-btn');
    const query = new URL(window.location.href).searchParams;
    const dateText = document.getElementById('date-text');
    const updatedText = document.getElementById('updated-text');

    function toDateString(date = new Date()) {
      return date.toISOString().slice(0, 10);
    }

    function toYamlString(value) {
      return JSON.stringify(String(value));
    }

    function slugify(value) {
      return String(value || '')
        .trim()
        .toLowerCase()
        .replace(/\s+/g, '-')
        .replace(/[^a-z0-9\u4e00-\u9fff_-]/g, '')
        .replace(/-+/g, '-')
        .replace(/(^-|-$)/g, '')
        .slice(0, 80) || `post-${toDateString()}`;
    }

    function clampImportance(value) {
      const num = Number(value || 2);
      if (Number.isNaN(num)) return 2;
      return Math.min(Math.max(Math.round(num), 1), 5);
    }

    function querySafeString(key) {
      const value = query.get(key);
      return value || '';
    }

    function cleanText(value) {
      return String(value || '').replace(/\s+/g, ' ').trim();
    }

    function focusEditor() {
      if (!editor) return;
      editor.focus();
      const selection = window.getSelection();
      if (!selection || selection.rangeCount === 0) {
        const range = document.createRange();
        range.selectNodeContents(editor);
        range.collapse(false);
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      updateEditorEmptyState();
    }

    function isEditorEmpty() {
      return (editor.textContent || '').replace(/\u200b/g, '').trim().length === 0;
    }

    function updateEditorEmptyState() {
      if (isEditorEmpty()) {
        editor.classList.add('is-empty');
      } else {
        editor.classList.remove('is-empty');
      }
    }

    function syncDateMeta(now = toDateString()) {
      if (!dateInput.value) {
        dateInput.value = now;
      }
      if (!updatedInput.value) {
        updatedInput.value = now;
      }
      if (dateText) dateText.textContent = dateInput.value || now;
      if (updatedText) updatedText.textContent = updatedInput.value || now;
    }

    function serializeNode(node, depth = 0) {
      if (!node) return '';
      if (node.nodeType === 3) {
        return cleanText(node.textContent || '');
      }

      if (node.nodeType === 8) {
        return '';
      }

      if (node.nodeType === 11) {
        return Array.from(node.childNodes)
          .map((child) => serializeNode(child, depth))
          .join('');
      }

      const tag = (node.nodeName || '').toLowerCase();
      const children = Array.from(node.childNodes).map((child) => serializeNode(child, depth));
      const text = children.join('').replace(/\s+$/g, '');
      const withNoExtra = text.trim();

      if (tag === 'br') return '\\n';
      if (tag === 'strong' || tag === 'b') return `**${withNoExtra}**`;
      if (tag === 'em' || tag === 'i') return `*${withNoExtra}*`;
      if (tag === 'u') return `<u>${withNoExtra}</u>`;
      if (tag === 'code') return `\`${withNoExtra}\``;
      if (tag === 'a') {
        const href = node.href || '#';
        return `[${withNoExtra}](${href})`;
      }
      if (tag === 'img') {
        const alt = (node.getAttribute && node.getAttribute('alt')) || 'image';
        const src = node.getAttribute && node.getAttribute('src') ? node.getAttribute('src') : '';
        return `![${alt}](${src})`;
      }
      if (tag === 'h1' || tag === 'h2' || tag === 'h3' || tag === 'h4' || tag === 'h5' || tag === 'h6') {
        const level = Number(tag.replace('h', '')) || 1;
        return `\\n${'#'.repeat(level)} ${withNoExtra}\\n\\n`;
      }
      if (tag === 'blockquote') {
        return `\\n> ${withNoExtra}\\n\\n`;
      }
      if (tag === 'pre') {
        const code = node.textContent || '';
        return `\\n\\n\`\`\`\\n${code}\\n\`\`\`\\n\\n`;
      }
      if (tag === 'li') {
        const marker = depth > 0 ? `${'  '.repeat(depth)}- ` : '- ';
        const bullet = marker + withNoExtra;
        const nested = Array.from(node.childNodes)
          .filter((child) => child.nodeType === 1 && ['ul', 'ol'].includes((child.nodeName || '').toLowerCase()))
          .map((child) => serializeNode(child, depth + 1))
          .join('');
        return `${bullet}\\n${nested}`;
      }
      if (tag === 'ul' || tag === 'ol') {
        const listItems = Array.from(node.children).filter((child) => (child.nodeName || '').toLowerCase() === 'li');
        return `${listItems
          .map((item, index) => {
            const content = Array.from(item.childNodes)
              .map((child) => serializeNode(child, depth + 1))
              .join('')
              .trim()
              .replace(/^\\s*/, '');
            const marker = tag === 'ol' ? `${index + 1}.` : '-';
            const indent = '  '.repeat(depth);
            return `${indent}${marker} ${content}`;
          })
          .join('\\n')}\\n\\n`;
      }
      if (tag === 'p') {
        return `${withNoExtra}\\n\\n`;
      }
      if (tag === 'span') {
        const style = (node.getAttribute && node.getAttribute('style')) || '';
        if (/color\\s*:/i.test(style)) {
          return `<span style=\"${style}\">${withNoExtra}</span>`;
        }
        return withNoExtra;
      }
      if (tag === 'div') {
        const style = (node.getAttribute && node.getAttribute('style')) || '';
        if (/page-break-before/i.test(style)) {
          return '';
        }
        return `${withNoExtra}\\n`;
      }
      return withNoExtra;
    }

    function editorToMarkdown() {
      const html = editor.innerHTML;
      if (!html) return '';
      const wrapper = document.createElement('div');
      wrapper.innerHTML = html;
      const md = Array.from(wrapper.childNodes)
        .map((node) => serializeNode(node, 0))
        .join('')
        .replace(/\\n{3,}/g, '\\n\\n')
        .trim();
      return md || '请先填写正文内容。';
    }

    function readDraftData() {
      return {
        title: cleanText(titleInput.value),
        type: typeInput.value || 'note',
        category: cleanText(categoryInput.value) || '技巧',
        importance: clampImportance(importanceInput.value),
        date: dateInput.value || toDateString(),
        updated: updatedInput.value || toDateString(),
        tags: cleanText(tagsInput.value)
          .split(',')
          .map((tag) => cleanText(tag))
          .filter(Boolean),
        summary: summaryInput.value.trim(),
        contentHtml: editor.innerHTML || '',
      };
    }

    function readMarkdownData() {
      const raw = readDraftData();
      const body = editorToMarkdown();
      return {
        ...raw,
        body,
      };
    }

    function buildMarkdown(data) {
      const tags = data.tags.length > 0 ? `[${data.tags.map((item) => toYamlString(item)).join(', ')}]` : '[]';
      const slug = slugify(data.title || 'untitled');
      const folder = data.type === 'note' ? 'notes' : data.type;
      const comment = `<!-- 文件建议路径：src/content/${folder}/${slug}.md -->`;

      return (
        `---\n` +
        `title: ${toYamlString(data.title || '无标题')}\n` +
        `date: ${data.date}\n` +
        `updated: ${data.updated || data.date}\n` +
        `summary: ${toYamlString(data.summary || '待补充')}\n` +
        `tags: ${tags}\n` +
        `category: ${toYamlString(data.category || '技巧')}\n` +
        `type: ${toYamlString(data.type)}\n` +
        `importance: ${Number(data.importance)}\n` +
        `draft: false\n` +
        `---\n\n` +
        `${data.body}\n\n` +
        `${comment}\n`
      );
    }

    function saveDraft() {
      localStorage.setItem(LS_KEY, JSON.stringify(readDraftData()));
    }

    function hydrateDraft() {
      const raw = localStorage.getItem(LS_KEY);
      if (!raw) return;
      try {
        const saved = JSON.parse(raw);
        titleInput.value = saved.title || '';
        typeInput.value = saved.type || 'note';
        categoryInput.value = saved.category || '技巧';
        importanceInput.value = String(saved.importance || 2);
        dateInput.value = saved.date || toDateString();
        updatedInput.value = saved.updated || toDateString();
        tagsInput.value = (saved.tags || []).join(', ');
        summaryInput.value = saved.summary || '';
        if (saved.contentHtml) editor.innerHTML = saved.contentHtml;
        updateEditorEmptyState();
        stateTip.textContent = '已恢复上次本地草稿。';
      } catch (err) {
        console.error(err);
      }
    }

    function applyCommand(cmd, value) {
      focusEditor();
      document.execCommand(cmd, false, value || null);
      updateEditorEmptyState();
      saveDraft();
    }

    function applyHeading(level) {
      if (!editor) return;
      focusEditor();
      const tag = `H${level}`;
      const done = document.execCommand('formatBlock', false, tag);
      if (!done) {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0) return;
        const range = selection.getRangeAt(0);
        const selected = selection.toString().trim();
        if (selected.length > 0) {
          insertAtCursor(`<${tag.toLowerCase()}>${selected}</${tag.toLowerCase()}>`);
          return;
        }

        const anchor = selection.anchorNode;
        let current = anchor && anchor.nodeType === 3 ? anchor.parentElement : anchor;
        while (current && current !== editor && current.parentElement) {
          const nodeName = (current.tagName || '').toLowerCase();
          if (['p', 'div', 'li', 'blockquote', 'pre'].includes(nodeName)) break;
          current = current.parentElement;
        }
        if (current && current !== editor && current.parentElement === editor) {
          const html = current.innerHTML;
          current.outerHTML = `<${tag.toLowerCase()}>${html}</${tag.toLowerCase()}>`;
          const rangeAfter = document.createRange();
          const next = editor.querySelector(`h${level}:last-child`);
          if (next) {
            rangeAfter.setStartAfter(next);
            rangeAfter.collapse(true);
            selection.removeAllRanges();
            selection.addRange(rangeAfter);
            editor.focus();
          }
        }
      }
      updateEditorEmptyState();
      saveDraft();
    }

    function applyBlockTag(commandValue) {
      focusEditor();
      document.execCommand('formatBlock', false, commandValue);
      saveDraft();
    }

    function insertAtCursor(html) {
      const selection = window.getSelection();
      if (!selection || selection.rangeCount === 0) {
        editor.focus();
        const range = document.createRange();
        range.selectNodeContents(editor);
        range.collapse(false);
        selection?.removeAllRanges();
        selection?.addRange(range);
      }

      const sel = window.getSelection();
      if (!sel || sel.rangeCount === 0) return;
      const range = sel.getRangeAt(0);
      range.deleteContents();
      const container = document.createElement('div');
      container.innerHTML = html;
      const frag = document.createDocumentFragment();
      while (container.firstChild) {
        frag.appendChild(container.firstChild);
      }
      range.insertNode(frag);
      range.collapse(false);
      sel.removeAllRanges();
      sel.addRange(range);
      editor.focus();
      updateEditorEmptyState();
      saveDraft();
    }

    async function insertImageFromClipboard(file) {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = () => {
          const imageUrl = String(reader.result);
          const safe = file.name ? file.name.replace(/\\.[^.]+$/, '') : 'image';
          const alt = safe.replace(/[^a-zA-Z0-9\\-_\\u4e00-\\u9fff]/g, '_') || 'image';
          insertAtCursor(`<img src="${imageUrl}" alt="${alt}" />`);
          stateTip.textContent = '已粘贴图片，导出时会转为 markdown 图片语法。';
          resolve();
        };
        reader.onerror = () => resolve();
        reader.readAsDataURL(file);
      });
    }

    function toClipboardHtml(htmlText) {
      const parser = new DOMParser();
      const parsed = parser.parseFromString(htmlText, 'text/html');
      return parsed.body ? parsed.body.textContent || '' : '';
    }

    function restoreQuery() {
      let hasPayload = false;
      const queryType = query.get('type');
      if (queryType === 'note' || queryType === 'blog' || queryType === 'important') {
        typeInput.value = queryType;
        hasPayload = true;
      }

      const queryTitle = querySafeString('title');
      if (queryTitle) titleInput.value = queryTitle;
      if (queryTitle) hasPayload = true;

      const querySummary = querySafeString('summary');
      if (querySummary) summaryInput.value = querySummary;
      if (querySummary) hasPayload = true;

      const queryCategory = querySafeString('category');
      if (queryCategory) categoryInput.value = queryCategory;
      if (queryCategory) hasPayload = true;

      const queryTags = querySafeString('tags');
      if (queryTags) {
        tagsInput.value = queryTags;
        hasPayload = true;
      }

      const queryImportance = query.get('importance');
      if (queryImportance) importanceInput.value = String(clampImportance(queryImportance));
      if (queryImportance) hasPayload = true;

      const queryDate = query.get('date');
      if (queryDate) dateInput.value = queryDate;
      if (queryDate) hasPayload = true;

      const queryUpdated = query.get('updated');
      if (queryUpdated) updatedInput.value = queryUpdated;
      if (queryUpdated) hasPayload = true;

      const queryBody = querySafeString('body');
      if (queryBody) {
        const html = toClipboardHtml(queryBody);
        if (html) {
          editor.innerHTML = html;
          hasPayload = true;
        }
      }

      return hasPayload;
    }

    editor.addEventListener('keydown', (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'b') {
        event.preventDefault();
        applyCommand('bold');
      } else if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'i') {
        event.preventDefault();
        applyCommand('italic');
      }
    });

    editor.addEventListener('input', () => {
      updateEditorEmptyState();
      saveDraft();
    });

    editor.addEventListener('paste', async (event) => {
      const clipboard = event.clipboardData;
      if (!clipboard) return;

      const files = Array.from(clipboard.files || []);
      const imageFiles = files.filter((file) => file && file.type.startsWith('image/'));
      if (imageFiles.length === 0) return;

      event.preventDefault();
      for (const file of imageFiles) {
        await insertImageFromClipboard(file);
      }
    });

    document.querySelectorAll('[data-command]').forEach((button) => {
      button.addEventListener('click', (event) => {
        const target = event.currentTarget;
        const command = target.getAttribute('data-command');
        if (!command) return;
        const value = target.getAttribute('data-value') || null;
        applyCommand(command, value);
      });
    });

    document.querySelectorAll('[data-block]').forEach((button) => {
      button.addEventListener('click', (event) => {
        const target = event.currentTarget;
        const block = target.getAttribute('data-block');
        if (!block) return;
        if (block === 'h1') applyHeading(1);
        if (block === 'h2') applyHeading(2);
        if (block === 'h3') applyHeading(3);
      });
    });

    colorPicker.addEventListener('input', () => {
      applyCommand('foreColor', colorPicker.value);
    });

    clearFormatBtn.addEventListener('click', () => {
      applyCommand('removeFormat');
      stateTip.textContent = '已清除选区格式。';
    });

    linkBtn.addEventListener('click', () => {
      const selection = window.getSelection();
      focusEditor();
      const selectedText = selection ? selection.toString().trim() : '';
      const text = window.prompt('链接文字', selectedText || '链接');
      const url = window.prompt('链接地址', 'https://');
      if (!text || !url || !url.trim()) return;
      const selected = window.getSelection();
      if (!selected || selected.toString().trim().length === 0) {
        stateTip.textContent = '请先选中文本再插入链接。';
        return;
      }
      applyCommand('createLink', url.trim());
      const range = selected.getRangeAt(0);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.textContent = text;
      range.deleteContents();
      range.insertNode(anchor);
      range.collapse(false);
      selected.removeAllRanges();
      const freshRange = document.createRange();
      freshRange.setStartAfter(anchor);
      freshRange.collapse(true);
      selected.addRange(freshRange);
      editor.focus();
      stateTip.textContent = '已插入链接。';
      saveDraft();
    });

    undoBtn.addEventListener('click', () => applyCommand('undo'));
    redoBtn.addEventListener('click', () => applyCommand('redo'));

    buildBtn.addEventListener('click', () => {
      const now = toDateString();
      const data = readMarkdownData();
      data.date = data.date || now;
      data.updated = now;
      dateInput.value = data.date;
      updatedInput.value = now;
      syncDateMeta(now);
      const markdown = buildMarkdown(data);
      output.textContent = markdown;
      saveDraft();
      stateTip.textContent = '已生成 Markdown，可复制或下载为 .md 文件。';
    });

    copyBtn.addEventListener('click', async () => {
      if (!output.textContent.trim() || output.textContent.startsWith('（点击')) {
        stateTip.textContent = '先点击「生成 Markdown」后再复制。';
        return;
      }
      try {
        await navigator.clipboard.writeText(output.textContent);
        copyBtn.textContent = '已复制';
        stateTip.textContent = 'Markdown 已复制到剪贴板。';
        window.setTimeout(() => {
          copyBtn.textContent = '复制内容';
        }, 1200);
      } catch (err) {
        stateTip.textContent = '复制失败，请手动选择代码块内容复制。';
      }
    });

    downloadBtn.addEventListener('click', () => {
      if (!output.textContent.trim() || output.textContent.startsWith('（点击')) {
        stateTip.textContent = '先点击「生成 Markdown」再下载。';
        return;
      }

      const now = toDateString();
      const data = readMarkdownData();
      data.date = data.date || now;
      data.updated = now;
      dateInput.value = data.date;
      updatedInput.value = now;
      syncDateMeta(now);
      const slug = slugify(data.title);
      const folder = data.type === 'note' ? 'notes' : data.type;
      const filename = `${slug}.md`;
      const blob = new Blob([output.textContent], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      link.click();
      URL.revokeObjectURL(url);
      stateTip.textContent = `已下载 ${filename}，建议保存到 src/content/${folder}/。`;
    });

    clearBtn.addEventListener('click', () => {
      titleInput.value = '';
      categoryInput.value = '技巧';
      importanceInput.value = '2';
      tagsInput.value = '';
      summaryInput.value = '';
      editor.innerHTML = '';
      updateEditorEmptyState();
      output.textContent = '（点击「生成 Markdown」后自动输出）';
      localStorage.removeItem(LS_KEY);
      const now = toDateString();
      dateInput.value = now;
      updatedInput.value = now;
      syncDateMeta(now);
      stateTip.textContent = '草稿已清空。';
    });

    const now = toDateString();
    dateInput.value = now;
    updatedInput.value = now;
    syncDateMeta(now);
    const hasQueryPayload = restoreQuery();
    if (!hasQueryPayload) hydrateDraft();
    syncDateMeta(now);
    updateEditorEmptyState();
    const html = readDraftData();
    if (!querySafeString('title') && !html.title) {
      stateTip.textContent = '欢迎使用，请开始填写内容；支持快捷键与工具栏排版。';
    }
  </script>

  <style>
