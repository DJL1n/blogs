---
import BaseLayout from '../layouts/BaseLayout.astro';

const TYPES = [
  { value: 'note', label: '笔记' },
  { value: 'blog', label: '博客' },
  { value: 'important', label: '重要记录' },
];
---

<BaseLayout title="写作 · 山不见我" description="Markdown 写作助手">
  <div class="mx-auto max-w-[72rem] px-4 sm:px-6 lg:px-8 animate-fade-in">

    <!-- Toolbar -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center rounded-xl border border-slate-200 bg-white p-0.5 dark:border-slate-700 dark:bg-slate-900">
        <button id="mode-visual" class="mode-tab mode-tab-active">可视化</button>
        <button id="mode-source" class="mode-tab">Markdown</button>
      </div>
      <div class="flex gap-2">
        <button id="save-btn" class="btn-primary text-sm" type="button">保存到文件</button>
        <button id="copy-btn" class="btn-secondary text-sm" type="button">复制 Markdown</button>
      </div>
    </div>

    <!-- Writing surface -->
    <div class="surface-card-elevated">
      <!-- Title -->
      <input
        id="title-input"
        type="text"
        class="w-full border-0 bg-transparent text-4xl font-black tracking-tight text-slate-900 outline-none placeholder:text-slate-300 dark:text-slate-100 dark:placeholder:text-slate-600"
        placeholder="无标题"
        autocomplete="off"
      />

      <!-- Visual editor -->
      <div id="visual-editor" class="editor-visual" contenteditable="true" spellcheck="true"
           data-placeholder="输入 `/` 选择块类型，或直接写 Markdown..."></div>

      <!-- Source editor -->
      <textarea
        id="source-editor"
        class="editor-source hidden"
        placeholder="直接写 Markdown..."
        spellcheck="true"
      ></textarea>

      <!-- Formatting toolbar (visual only) -->
      <div id="format-bar" class="mt-3 flex flex-wrap items-center gap-1 border-t border-slate-100 pt-3 dark:border-slate-800">
        <button data-cmd="bold" class="fmt-btn font-bold">B</button>
        <button data-cmd="italic" class="fmt-btn"><i>I</i></button>
        <button data-cmd="strike" class="fmt-btn"><s>S</s></button>
        <button data-cmd="code" class="fmt-btn">&lt;/&gt;</button>
        <span class="mx-1 text-slate-300">|</span>
        <button data-cmd="h2" class="fmt-btn">H2</button>
        <button data-cmd="h3" class="fmt-btn">H3</button>
        <button data-cmd="ul" class="fmt-btn">• 列表</button>
        <button data-cmd="ol" class="fmt-btn">1. 列表</button>
        <button data-cmd="quote" class="fmt-btn">〝 引用</button>
        <button data-cmd="hr" class="fmt-btn">— 分割</button>
      </div>

      <!-- Slash menu -->
      <div id="slash-menu" class="slash-menu hidden">
        <div data-slash="h1" class="slash-item"><span class="slash-icon">H1</span>一级标题</div>
        <div data-slash="h2" class="slash-item"><span class="slash-icon">H2</span>二级标题</div>
        <div data-slash="h3" class="slash-item"><span class="slash-icon">H3</span>三级标题</div>
        <div class="slash-divider"></div>
        <div data-slash="ul" class="slash-item"><span class="slash-icon">•</span>无序列表</div>
        <div data-slash="ol" class="slash-item"><span class="slash-icon">1.</span>有序列表</div>
        <div data-slash="quote" class="slash-item"><span class="slash-icon">〝</span>引用块</div>
        <div class="slash-divider"></div>
        <div data-slash="code" class="slash-item"><span class="slash-icon">&lt;/&gt;</span>代码块</div>
        <div data-slash="hr" class="slash-item"><span class="slash-icon">—</span>分割线</div>
      </div>
    </div>

    <!-- Metadata (collapsible) -->
    <details class="surface-card mt-4" id="meta-details">
      <summary class="cursor-pointer text-sm font-medium text-slate-500 select-none">元数据</summary>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="block">
          <span class="text-xs font-medium text-slate-500">类型</span>
          <select id="meta-type" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-800">
            {TYPES.map((t) => <option value={t.value}>{t.label}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-medium text-slate-500">分类</span>
          <input id="meta-category" type="text" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-800" placeholder="技术 / 概念" />
        </label>
        <label class="block">
          <span class="text-xs font-medium text-slate-500">标签（逗号分隔）</span>
          <input id="meta-tags" type="text" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-800" placeholder="macOS, dns, astro" />
        </label>
        <label class="block">
          <span class="text-xs font-medium text-slate-500">重要性</span>
          <input id="meta-importance" type="number" min="1" max="5" value="2" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-800" />
        </label>
        <label class="block sm:col-span-2">
          <span class="text-xs font-medium text-slate-500">摘要</span>
          <textarea id="meta-summary" rows="2" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-800" placeholder="一句话描述"></textarea>
        </label>
      </div>
    </details>

    <!-- Status -->
    <p id="status-bar" class="mt-3 text-center text-xs text-slate-400"></p>
  </div>
</BaseLayout>

<script>
  // ── DOM refs ──
  const $ = (id: string) => document.getElementById(id)!;
  const titleEl = $('title-input') as HTMLInputElement;
  const visualEl = $('visual-editor') as HTMLDivElement;
  const sourceEl = $('source-editor') as HTMLTextAreaElement;
  const modeVisualBtn = $('mode-visual') as HTMLButtonElement;
  const modeSourceBtn = $('mode-source') as HTMLButtonElement;
  const formatBar = $('format-bar') as HTMLDivElement;
  const slashMenu = $('slash-menu') as HTMLDivElement;
  const typeEl = $('meta-type') as HTMLSelectElement;
  const categoryEl = $('meta-category') as HTMLInputElement;
  const tagsEl = $('meta-tags') as HTMLInputElement;
  const importanceEl = $('meta-importance') as HTMLInputElement;
  const summaryEl = $('meta-summary') as HTMLTextAreaElement;
  const saveBtn = $('save-btn') as HTMLButtonElement;
  const copyBtn = $('copy-btn') as HTMLButtonElement;
  const statusBar = $('status-bar') as HTMLParagraphElement;

  const LS_KEY = 'kb-editor-v2';
  const DEBOUNCE_MS = 600;
  let currentMode: 'visual' | 'source' = 'visual';
  let draftTimer: ReturnType<typeof setTimeout>;

  // ── Status ──
  function status(msg: string, err = false) {
    statusBar.textContent = msg;
    statusBar.className = `mt-3 text-center text-xs ${err ? 'text-rose-500' : 'text-slate-400'}`;
  }

  // ── Markdown ↔ HTML (lightweight) ──
  function esc(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function unesc(s: string) { return s.replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"'); }

  function inlineToHtml(t: string): string {
    let s = esc(t);
    s = s.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1">');
    s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
    s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    s = s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
    s = s.replace(/~~([^~]+)~~/g, '<del>$1</del>');
    s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
    return s;
  }

  function mdToHtml(md: string): string {
    if (!md.trim()) return '';
    const lines = md.split('\n');
    const out: string[] = [];
    let i = 0;
    while (i < lines.length) {
      const line = lines[i];
      if (/^```/.test(line.trim())) {
        const lang = line.trim().slice(3).trim();
        i++;
        const cl: string[] = [];
        while (i < lines.length && !/^```/.test(lines[i].trim())) { cl.push(esc(lines[i])); i++; }
        if (i < lines.length) i++;
        out.push(`<pre data-lang="${esc(lang)}"><code>${cl.join('\n')}</code></pre>`);
        continue;
      }
      const h = line.match(/^(#{1,6})\s+(.+)/);
      if (h) { out.push(`<h${h[1].length}>${inlineToHtml(h[2])}</h${h[1].length}>`); i++; continue; }
      if (/^(-{3,}|\*{3,})$/.test(line.trim())) { out.push('<hr>'); i++; continue; }
      if (/^>\s?/.test(line)) {
        const q: string[] = [];
        while (i < lines.length && /^>\s?/.test(lines[i])) { q.push(lines[i].replace(/^>\s?/,'')); i++; }
        out.push(`<blockquote><p>${q.map(inlineToHtml).join('<br>')}</p></blockquote>`);
        continue;
      }
      if (/^[-*]\s+/.test(line)) {
        const items: string[] = [];
        while (i < lines.length && /^[-*]\s+/.test(lines[i])) { items.push(`<li>${inlineToHtml(lines[i].replace(/^[-*]\s+/,''))}</li>`); i++; }
        out.push(`<ul>${items.join('')}</ul>`);
        continue;
      }
      if (/^\d+\.\s+/.test(line)) {
        const items: string[] = [];
        while (i < lines.length && /^\d+\.\s+/.test(lines[i])) { items.push(`<li>${inlineToHtml(lines[i].replace(/^\d+\.\s+/,''))}</li>`); i++; }
        out.push(`<ol>${items.join('')}</ol>`);
        continue;
      }
      if (!line.trim()) { out.push('<p><br></p>'); i++; continue; }
      out.push(`<p>${inlineToHtml(line)}</p>`);
      i++;
    }
    return out.join('');
  }

  function serializeNode(node: ChildNode): string {
    if (node.nodeType === Node.TEXT_NODE) return node.textContent || '';
    if (node.nodeType !== Node.ELEMENT_NODE) return '';
    const el = node as HTMLElement;
    const tag = el.tagName.toLowerCase();
    const kids = Array.from(el.childNodes).map(serializeNode).join('');

    switch (tag) {
      case 'strong': case 'b': return `**${kids}**`;
      case 'em': case 'i': return `*${kids}*`;
      case 'del': case 's': return `~~${kids}~~`;
      case 'code': return `\`${kids}\``;
      case 'br': return '\n';
      case 'hr': return '---';
      case 'h1': return `# ${kids}`;
      case 'h2': return `## ${kids}`;
      case 'h3': return `### ${kids}`;
      case 'h4': return `#### ${kids}`;
      case 'h5': return `##### ${kids}`;
      case 'h6': return `###### ${kids}`;
      case 'p': return kids.trim() || '';
      case 'blockquote': return `> ${kids.replace(/\n/g, '\n> ')}`;
      case 'pre': {
        const lang = el.getAttribute('data-lang') || '';
        return `\`\`\`${lang}\n${el.textContent || ''}\n\`\`\``;
      }
      case 'ul': return Array.from(el.querySelectorAll(':scope > li')).map(li => `- ${serializeNode(li)}`).join('\n');
      case 'ol': return Array.from(el.querySelectorAll(':scope > li')).map((li, i) => `${i+1}. ${serializeNode(li)}`).join('\n');
      case 'li': return Array.from(el.childNodes).map(serializeNode).join('').replace(/\n/g, ' ').trim();
      case 'a': return `[${kids}](${el.getAttribute('href')||'#'})`;
      case 'img': return `![${el.getAttribute('alt')||''}](${el.getAttribute('src')||''})`;
      default: return kids;
    }
  }

  function htmlToMd(): string {
    const container = document.createElement('div');
    container.innerHTML = visualEl.innerHTML || '';
    return Array.from(container.childNodes).map(serializeNode).join('\n').replace(/\n{3,}/g, '\n\n').trim();
  }

  // ── Mode switching ──
  function setMode(mode: 'visual' | 'source') {
    if (mode === currentMode) return;
    if (currentMode === 'visual') {
      sourceEl.value = htmlToMd();
    } else {
      visualEl.innerHTML = mdToHtml(sourceEl.value);
    }
    currentMode = mode;
    if (mode === 'visual') {
      visualEl.classList.remove('hidden');
      sourceEl.classList.add('hidden');
      formatBar.classList.remove('hidden');
      modeVisualBtn.classList.add('mode-tab-active');
      modeSourceBtn.classList.remove('mode-tab-active');
    } else {
      visualEl.classList.add('hidden');
      sourceEl.classList.remove('hidden');
      formatBar.classList.add('hidden');
      hideSlash();
      modeSourceBtn.classList.add('mode-tab-active');
      modeVisualBtn.classList.remove('mode-tab-active');
    }
  }

  // ── Slash menu ──
  let slashIdx = 0;
  let slashVisible = false;

  function showSlash(x: number, y: number) {
    slashMenu.style.left = `${x}px`;
    slashMenu.style.top = `${y}px`;
    slashMenu.classList.remove('hidden');
    slashVisible = true;
    slashIdx = 0;
    highlightSlash();
  }
  function hideSlash() { slashMenu.classList.add('hidden'); slashVisible = false; }

  function highlightSlash() {
    slashMenu.querySelectorAll('.slash-item').forEach((el, i) => el.classList.toggle('slash-active', i === slashIdx));
  }

  function applySlashBlock(tag: string) {
    const sel = window.getSelection();
    if (!sel?.rangeCount) return;
    const range = sel.getRangeAt(0);
    const block = getBlock(range.startContainer);
    if (!block || block === visualEl) return;

    // remove "/" character
    const txt = block.textContent || '';
    const pos = txt.indexOf('/');
    if (pos >= 0 && block.firstChild?.nodeType === Node.TEXT_NODE) {
      (block.firstChild as Text).textContent = txt.slice(0, pos);
    }

    let el: HTMLElement;
    if (tag === 'pre') {
      el = document.createElement('pre');
      el.innerHTML = '<code><br></code>';
    } else if (tag === 'hr') {
      el = document.createElement('hr');
      const p = document.createElement('p');
      p.innerHTML = '<br>';
      block.replaceWith(el);
      el.after(p);
      hideSlash();
      placeCaret(p);
      return;
    } else {
      el = document.createElement(tag);
      el.innerHTML = '<br>';
    }
    block.replaceWith(el);
    hideSlash();
    placeCaret(el);
  }

  function placeCaret(el: HTMLElement) {
    const sel = window.getSelection();
    const r = document.createRange();
    r.selectNodeContents(el);
    r.collapse(true);
    sel?.removeAllRanges();
    sel?.addRange(r);
    visualEl.focus();
  }

  function getBlock(node: Node | null): HTMLElement | null {
    while (node && node !== visualEl) {
      if (node.nodeType === Node.ELEMENT_NODE) {
        const t = (node as HTMLElement).tagName.toLowerCase();
        if (['p','h1','h2','h3','h4','h5','h6','blockquote','pre','ul','ol','li','hr'].includes(t)) return node as HTMLElement;
      }
      node = node.parentNode;
    }
    return null;
  }

  // ── Toolbar commands ──
  function execCmd(cmd: string) {
    if (currentMode !== 'visual') return;
    const sel = window.getSelection();
    if (!sel?.rangeCount) return;
    const range = sel.getRangeAt(0);
    const block = getBlock(range.startContainer);

    switch (cmd) {
      case 'bold': wrapInline('strong'); break;
      case 'italic': wrapInline('em'); break;
      case 'strike': wrapInline('del'); break;
      case 'code': wrapInline('code'); break;
      case 'h2':
      case 'h3':
        if (block && !/^(h[1-6]|pre|ul|ol|blockquote|hr)$/.test(block.tagName.toLowerCase())) {
          const h = document.createElement(cmd);
          h.innerHTML = block.innerHTML;
          block.replaceWith(h);
          placeCaretEnd(h);
        }
        break;
      case 'ul':
      case 'ol': {
        if (!block || block === visualEl) return;
        const list = document.createElement(cmd);
        const li = document.createElement('li');
        li.innerHTML = block.innerHTML || '<br>';
        list.appendChild(li);
        block.replaceWith(list);
        placeCaretEnd(li);
        break;
      }
      case 'quote':
        if (block && block.tagName.toLowerCase() !== 'blockquote') {
          const bq = document.createElement('blockquote');
          bq.innerHTML = block.innerHTML ? `<p>${block.innerHTML}</p>` : '<p><br></p>';
          block.replaceWith(bq);
          placeCaretEnd(bq);
        }
        break;
      case 'hr':
        if (block) {
          const hr = document.createElement('hr');
          const p = document.createElement('p'); p.innerHTML = '<br>';
          block.replaceWith(hr);
          hr.after(p);
          placeCaret(p);
        }
        break;
    }
    visualEl.focus();
    saveDraft();
  }

  function wrapInline(tag: string) {
    const sel = window.getSelection();
    if (!sel?.rangeCount || sel.isCollapsed) return;
    const range = sel.getRangeAt(0);
    try { range.surroundContents(document.createElement(tag)); } catch { /* cross-node */ }
    sel.removeAllRanges();
  }

  function placeCaretEnd(el: HTMLElement) {
    const sel = window.getSelection();
    const r = document.createRange();
    r.selectNodeContents(el);
    r.collapse(false);
    sel?.removeAllRanges();
    sel?.addRange(r);
  }

  // ── Markdown shortcut detection ──
  function detectShortcuts() {
    if (currentMode !== 'visual') return;
    const sel = window.getSelection();
    if (!sel?.rangeCount) return;

    let block = getBlock(sel.getRangeAt(0).startContainer);
    let text: string;

    // Direct text in editor (no wrapper element) — parse whole editor content
    if (!block || block === visualEl) {
      text = (visualEl.textContent || '').trim();
      if (!text) return;

      const hAll = text.match(/^(#{1,6})\s(.+)/);
      if (hAll) {
        visualEl.innerHTML = mdToHtml(text);
        const newBlock = visualEl.querySelector('h1, h2, h3, h4, h5, h6');
        if (newBlock) placeCaretEnd(newBlock as HTMLElement);
        return;
      }
      const ulAll = text.match(/^[-*]\s(.+)/);
      if (ulAll) { visualEl.innerHTML = mdToHtml(text); return; }
      const qAll = text.match(/^>\s(.+)/);
      if (qAll) { visualEl.innerHTML = mdToHtml(text); return; }
      return;
    }

    if (block.tagName === 'PRE') return;
    text = block.textContent || '';

    const h = text.match(/^(#{1,6})\s(.+)/);
    const ul = text.match(/^[-*]\s(.+)/);
    const q = text.match(/^>\s(.+)/);

    if (h) {
      const lv = h[1].length;
      const el = document.createElement(`h${lv}`);
      el.innerHTML = inlineToHtml(h[2]);
      block.replaceWith(el);
      placeCaretEnd(el);
    } else if (ul) {
      const list = document.createElement('ul');
      const li = document.createElement('li');
      li.innerHTML = inlineToHtml(ul[1]);
      list.appendChild(li);
      block.replaceWith(list);
      placeCaretEnd(li);
    } else if (q) {
      const bq = document.createElement('blockquote');
      bq.innerHTML = `<p>${inlineToHtml(q[1])}</p>`;
      block.replaceWith(bq);
      placeCaretEnd(bq);
    }
  }

  // ── Draft persistence ──
  function saveDraft() {
    clearTimeout(draftTimer);
    draftTimer = setTimeout(() => {
      const data = {
        title: titleEl.value,
        type: typeEl.value,
        category: categoryEl.value,
        tags: tagsEl.value,
        importance: importanceEl.value,
        summary: summaryEl.value,
        bodyHtml: visualEl.innerHTML,
        bodyMd: sourceEl.value,
        mode: currentMode,
        savedAt: Date.now(),
      };
      localStorage.setItem(LS_KEY, JSON.stringify(data));
      status('草稿已保存', false);
    }, DEBOUNCE_MS);
  }

  function loadDraft() {
    const params = new URLSearchParams(window.location.search);
    const hasParams = params.has('title') || params.has('body') || params.has('type');

    if (hasParams) {
      titleEl.value = params.get('title') || '';
      typeEl.value = params.get('type') || 'note';
      categoryEl.value = params.get('category') || '';
      tagsEl.value = params.get('tags') || '';
      importanceEl.value = params.get('importance') || '2';
      summaryEl.value = params.get('summary') || '';
      const body = params.get('body');
      if (body) {
        const decoded = decodeURIComponent(body);
        visualEl.innerHTML = mdToHtml(decoded);
        sourceEl.value = decoded;
      }
      status('已加载文章内容', false);
      saveDraft();
      return;
    }

    const raw = localStorage.getItem(LS_KEY);
    if (!raw) { status('新文章', false); return; }
    try {
      const d = JSON.parse(raw);
      titleEl.value = d.title || '';
      typeEl.value = d.type || 'note';
      categoryEl.value = d.category || '';
      tagsEl.value = d.tags || '';
      importanceEl.value = d.importance || '2';
      summaryEl.value = d.summary || '';
      visualEl.innerHTML = d.bodyHtml || mdToHtml(d.bodyMd || '');
      sourceEl.value = d.bodyMd || '';
      if (d.mode === 'source') setMode('source');
      status('已恢复草稿', false);
    } catch { status('新文章', false); }
  }

  // ── Build markdown ──
  function buildMarkdown(): string {
    const title = titleEl.value.trim() || '无标题';
    const body = currentMode === 'source' ? sourceEl.value.trim() : htmlToMd();
    const now = new Date().toISOString().slice(0, 10);
    const tags = tagsEl.value.split(',').map(s => s.trim()).filter(Boolean);
    const type = typeEl.value || 'note';
    const category = categoryEl.value.trim() || '技巧';
    const importance = Math.min(Math.max(Number(importanceEl.value) || 2, 1), 5);
    const summary = summaryEl.value.trim() || '待补充';

    return [
      '---',
      `title: ${JSON.stringify(title)}`,
      `date: ${now}`,
      `updated: ${now}`,
      `summary: ${JSON.stringify(summary)}`,
      `tags: [${tags.map(t => JSON.stringify(t)).join(', ')}]`,
      `category: ${JSON.stringify(category)}`,
      `type: ${JSON.stringify(type)}`,
      `importance: ${importance}`,
      'draft: false',
      '---',
      '',
      body || '正文内容待补充。',
      '',
    ].join('\n');
  }

  function buildFileName(): string {
    const title = titleEl.value.trim() || '无标题';
    const now = new Date().toISOString().slice(0, 10);
    const slug = title.replace(/\s+/g, '-').replace(/[\\/:*?"<>|]/g, '').slice(0, 60) || 'untitled';
    return `${now}-${slug}.md`;
  }

  // ── Save ──
  async function save() {
    const title = titleEl.value.trim();
    const category = categoryEl.value.trim();
    const summary = summaryEl.value.trim();
    if (!title) { status('请填写标题', true); return; }
    if (!category) { status('请填写分类', true); return; }
    if (!summary) { status('请填写摘要', true); return; }

    const markdown = buildMarkdown();
    const filename = buildFileName();
    const type = typeEl.value || 'note';

    saveBtn.textContent = '保存中...';
    saveBtn.setAttribute('disabled', 'true');

    try {
      const resp = await fetch('/api/editor-save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ markdown, filename, type }),
      });
      const result = await resp.json();
      if (result.ok) {
        status(`已保存: ${result.path}${result.commit ? ` (commit: ${result.commit})` : ''}`, false);
        saveDraft();
      } else {
        status(`保存失败: ${result.reason}`, true);
      }
    } catch (e: any) {
      status(`网络错误: ${e.message || '请确认 dev server 已启动'}`, true);
    } finally {
      saveBtn.textContent = '保存到文件';
      saveBtn.removeAttribute('disabled');
    }
  }

  // ── Copy ──
  function copyMd() {
    const md = buildMarkdown();
    navigator.clipboard.writeText(md).then(() => {
      status('Markdown 已复制到剪贴板', false);
      setTimeout(() => status('', false), 2000);
    }).catch(() => status('复制失败', true));
  }

  // ── Event bindings ──
  modeVisualBtn.addEventListener('click', () => setMode('visual'));
  modeSourceBtn.addEventListener('click', () => setMode('source'));

  visualEl.addEventListener('input', () => { detectShortcuts(); saveDraft(); });
  sourceEl.addEventListener('input', () => saveDraft());

  visualEl.addEventListener('keydown', (e: KeyboardEvent) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'b') { e.preventDefault(); execCmd('bold'); }
    if ((e.metaKey || e.ctrlKey) && e.key === 'i') { e.preventDefault(); execCmd('italic'); }
    if ((e.metaKey || e.ctrlKey) && e.key === 's') { e.preventDefault(); save(); }

    // Slash menu nav
    if (slashVisible) {
      const items = slashMenu.querySelectorAll('.slash-item');
      if (e.key === 'ArrowDown') { e.preventDefault(); slashIdx = (slashIdx + 1) % items.length; highlightSlash(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); slashIdx = (slashIdx - 1 + items.length) % items.length; highlightSlash(); }
      if (e.key === 'Enter' || e.key === 'Tab') {
        e.preventDefault();
        const tag = (items[slashIdx] as HTMLElement)?.getAttribute('data-slash') || '';
        applySlashBlock(tag);
      }
      if (e.key === 'Escape') { e.preventDefault(); hideSlash(); }
    }

    // Detect "/" at line start
    if (e.key === '/') {
      setTimeout(() => {
        const sel = window.getSelection();
        if (!sel?.rangeCount) return;
        const block = getBlock(sel.getRangeAt(0).startContainer);
        const txt = block?.textContent?.trim() || '';
        if (txt === '/' || txt.startsWith('/')) {
          const rect = (block as HTMLElement)?.getBoundingClientRect?.();
          if (rect) showSlash(rect.left, rect.bottom + 4);
        }
      }, 10);
    }

    // Enter on empty heading → convert to paragraph
    if (e.key === 'Enter') {
      setTimeout(() => {
        const sel = window.getSelection();
        if (!sel?.rangeCount) return;
        const block = getBlock(sel.getRangeAt(0).startContainer);
        if (block && /^h[1-6]$/.test(block.tagName.toLowerCase()) && !block.textContent?.trim()) {
          const p = document.createElement('p');
          p.innerHTML = '<br>';
          block.replaceWith(p);
          placeCaret(p);
        }
      }, 10);
    }
  });

  visualEl.addEventListener('click', () => hideSlash());

  document.querySelectorAll('[data-cmd]').forEach(btn => {
    btn.addEventListener('click', () => execCmd(btn.getAttribute('data-cmd') || ''));
  });

  slashMenu.querySelectorAll('.slash-item').forEach(item => {
    item.addEventListener('click', () => {
      applySlashBlock(item.getAttribute('data-slash') || '');
    });
  });

  [titleEl, typeEl, categoryEl, tagsEl, importanceEl, summaryEl].forEach(el =>
    el?.addEventListener('input', () => saveDraft())
  );

  saveBtn.addEventListener('click', () => save());
  copyBtn.addEventListener('click', () => copyMd());

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') saveDraft();
  });

  // ── Init ──
  loadDraft();
</script>

