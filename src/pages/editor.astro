      margin-bottom: 0.45rem;
    }
    .writer-canvas h1 {
      font-size: 1.95rem;
      line-height: 1.2;
    }
    .writer-canvas h2 {
      font-size: 1.5rem;
      line-height: 1.28;
    }
    .writer-canvas h3 {
      font-size: 1.25rem;
      line-height: 1.3;
    }
    .writer-canvas ul,
    .writer-canvas ol {
      padding-left: 1.4rem;
      margin: 0.7rem 0;
    }
    .writer-canvas p {
      margin: 0.4rem 0;
    }
    .writer-canvas blockquote {
      margin: 0.75rem 0;
      padding-left: 0.9rem;
      border-left: 3px solid rgb(148 163 184);
      color: rgb(71 85 105);
    }
    .writer-canvas pre {
      margin: 0.8rem 0;
      padding: 0.8rem;
      border: 1px solid rgb(226 232 240);
