---
import { getCollection, getEntryBySlug, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { estimateReadingTime } from '../../utils/reading-time';
import { resolveRelatedPosts } from '../../utils/related-posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: {
        slug: post.slug
      }
    }));
}

const { slug } = Astro.params;
const post = slug ? await getEntryBySlug('blog', slug) : null;

if (!post || post.data.draft) {
  return Astro.redirect('/blog');
}

const rendered = await render(post);
const { Content, headings = [] } = rendered;
const readingTime = post.body ? estimateReadingTime(post.body) : 3;
const relatedPosts = await resolveRelatedPosts(post.data.relatedNotes || []);
---

<PostLayout post={post} headings={headings} readingTime={readingTime} Content={Content} relatedPosts={relatedPosts} />
