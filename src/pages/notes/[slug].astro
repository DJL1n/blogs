---
import { getEntryBySlug, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

function estimateReadingTime(content: string): number {
  const plainChinese = content.replace(/[^\u4e00-\u9fff]/g, '');
  const plainEnglish = content.replace(/[^\x00-\x7F]/g, '').trim();
  const enWords = plainEnglish.length ? plainEnglish.split(/\s+/).filter(Boolean).length : 0;
  const score = plainChinese.length * 1.2 + enWords;
  return Math.max(1, Math.round(score / 500));
}

const { slug } = Astro.params;
const post = slug ? await getEntryBySlug('notes', slug) : null;

if (!post || post.data.draft) {
  return Astro.redirect('/notes');
}

const rendered = await render(post);
const { Content, headings = [] } = rendered;
const readingTime = post.body ? estimateReadingTime(post.body) : 2;
---

<PostLayout post={post} headings={headings} readingTime={readingTime} Content={Content} />
