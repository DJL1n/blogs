---
import { getCollection, getEntryBySlug, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

const REL_COLLECTIONS = ['notes', 'blog', 'important'] as const;
type RelCollection = (typeof REL_COLLECTIONS)[number];

type RelatedPost = {
  title: string;
  summary: string;
  collection: RelCollection;
  slug: string;
  href: string;
};

export async function getStaticPaths() {
  const posts = await getCollection('notes');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: {
        slug: post.slug
      }
    }));
}

function estimateReadingTime(content: string): number {
  const plainChinese = content.replace(/[^\u4e00-\u9fff]/g, '');
  const plainEnglish = content.replace(/[^\x00-\x7F]/g, '').trim();
  const enWords = plainEnglish.length ? plainEnglish.split(/\s+/).filter(Boolean).length : 0;
  const score = plainChinese.length * 1.2 + enWords;
  return Math.max(1, Math.round(score / 500));
}

const { slug } = Astro.params;
const post = slug ? await getEntryBySlug('notes', slug) : null;

if (!post || post.data.draft) {
  return Astro.redirect('/notes');
}

const rendered = await render(post);
const { Content, headings = [] } = rendered;
const readingTime = post.body ? estimateReadingTime(post.body) : 2;

const allCollections = await Promise.all(
  REL_COLLECTIONS.map(async (collection) => {
    const entries = (await getCollection(collection)).filter((entry) => !entry.data.draft);
    const map = new Map<string, (typeof entries)[number]>();
    entries.forEach((entry) => map.set(entry.slug, entry));
    return { collection, map };
  })
);

const collectionMaps = allCollections.reduce((acc, item) => {
  acc[item.collection] = item.map;
  return acc;
}, {} as Record<RelCollection, Map<string, any>>);

function parseRelatedReference(raw: string) {
  const trimmed = String(raw || '').trim();
  if (!trimmed || /^https?:\/\//i.test(trimmed)) {
    return null;
  }

  const normalized = trimmed.replace(/^\/+/, '');
  const parts = normalized.split('/').filter(Boolean);
  if (parts.length === 0) return null;

  const first = parts[0];
  const guessedCollection = first as RelCollection;
  if (REL_COLLECTIONS.includes(guessedCollection) && parts.length >= 2) {
    return {
      collection: guessedCollection,
      slug: parts.slice(1).join('/'),
    };
  }

  return {
    collection: null,
    slug: normalized,
  };
}

function resolveRelatedPosts(values: string[]): RelatedPost[] {
  const related: RelatedPost[] = [];
  const seen = new Set<string>();

  for (const value of values || []) {
    const parsed = parseRelatedReference(value);
    if (!parsed) continue;

    const candidates = parsed.collection ? [parsed.collection] : REL_COLLECTIONS;
    for (const collection of candidates) {
      const map = collectionMaps[collection];
      const hit = map?.get(parsed.slug);
      if (!hit) continue;

      const href = `/${collection}/${hit.slug}`;
      if (seen.has(href)) continue;
      seen.add(href);
      related.push({
        title: hit.data.title,
        summary: hit.data.summary,
        collection,
        slug: hit.slug,
        href,
      });
      break;
    }
  }
  return related;
}

const relatedPosts = resolveRelatedPosts(post.data.relatedNotes || []);
---

<PostLayout post={post} headings={headings} readingTime={readingTime} Content={Content} relatedPosts={relatedPosts} />
