---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="搜索" description="站内文章快速检索">
  <section class="page-stack">
    <PageHeader
      eyebrow="Search"
      title="站内搜索"
      description="标题、摘要、标签和分类会被一起匹配。搜索结果即时更新，也会同步到地址栏。"
      meta={['站内全文检索', '实时过滤']}
      actions={[{ label: '回到首页', href: '/' }]}
    />

    <form class="liquid-panel search-panel reveal" role="search" id="search-form" data-liquid-panel>
      <label for="search-input" class="sr-only">搜索</label>
      <input
        id="search-input"
        type="search"
        placeholder="输入关键词"
        autocomplete="off"
      />
      <button type="submit" class="btn-primary magnetic">搜索</button>
    </form>

    <p id="count" class="search-count" aria-live="polite">加载索引中…</p>
    <div id="search-result" class="collection-grid" aria-live="polite"></div>
  </section>

  <script is:inline>
    let allPosts = [];
    const input = document.getElementById('search-input');
    const result = document.getElementById('search-result');
    const count = document.getElementById('count');
    const form = document.getElementById('search-form');

    // Load search index
    fetch('/search-index.json')
      .then((r) => r.json())
      .then((data) => {
        allPosts = data;
        count.textContent = `共 ${allPosts.length} 条内容`;
        syncFromQuery();
      })
      .catch(() => {
        count.textContent = '索引加载失败';
      });

    function toUrl(post) {
      if (post.collection === 'blog') return `/blog/${post.slug}`;
      if (post.collection === 'notes') return `/notes/${post.slug}`;
      return `/important/${post.slug}`;
    }

    function textLower(value) {
      return String(value || '').toLowerCase();
    }

    function escapeHtml(value) {
      return String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function collectionLabel(collection) {
      if (collection === 'blog') return '博客';
      if (collection === 'notes') return '笔记';
      return '重要';
    }

    function filterPosts(query) {
      const keyword = query.trim().toLowerCase();
      if (!keyword) return allPosts;
      return allPosts.filter((item) => {
        const tags = textLower(item.tags.join(' '));
        return (
          textLower(item.title).includes(keyword) ||
          textLower(item.summary).includes(keyword) ||
          textLower(item.category).includes(keyword) ||
          tags.includes(keyword)
        );
      });
    }

    function render() {
      if (!allPosts.length) return;
      const query = textLower(input.value).trim();
      const listToRender = filterPosts(query);
      count.textContent = query ? `命中 ${listToRender.length} 条结果` : `共 ${listToRender.length} 条内容`;
      if (listToRender.length === 0) {
        result.classList.remove('collection-grid');
        result.classList.add('search-empty');
        result.innerHTML = '<p class="empty-copy">未命中内容，建议缩短关键词或换一个主题词。</p>';
        return;
      }

      result.classList.add('collection-grid');
      result.innerHTML = listToRender
        .map((post) => {
          const tags = post.tags.map((tag) => `<span class="chip">#${escapeHtml(tag)}</span>`).join('');
          return `
            <article class="surface-card post-card reveal visible" data-liquid-panel>
              <a href="${toUrl(post)}" class="no-underline">
                <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                  <span class="chip">${escapeHtml(post.category)}</span>
                  <span>${new Date(post.date).toLocaleDateString('zh-CN')}</span>
                  <span>${collectionLabel(post.collection)}</span>
                </div>
                <h3 class="text-xl font-black leading-tight tracking-tight text-slate-950 dark:text-slate-50">${escapeHtml(post.title)}</h3>
                <p class="mt-3 leading-relaxed text-slate-700 dark:text-slate-300">${escapeHtml(post.summary)}</p>
                <p class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-300">${tags}</p>
              </a>
            </article>
          `;
        })
        .join('');
    }

    function syncFromQuery() {
      const params = new URLSearchParams(window.location.search);
      input.value = params.get('q') || '';
      render();
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const q = input.value.trim();
      const url = new URL(window.location.href);
      if (q) {
        url.searchParams.set('q', q);
      } else {
        url.searchParams.delete('q');
      }
      window.history.replaceState({}, '', url);
      render();
    });

    input.addEventListener('input', () => {
      const q = input.value.trim();
      const url = new URL(window.location.href);
      if (q) url.searchParams.set('q', q);
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
      render();
    });

    syncFromQuery();
  </script>
</BaseLayout>

<style>
  .search-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7rem;
    align-items: stretch;
    gap: 0.6rem;
    padding: 0.55rem;
  }

  .search-panel input {
    grid-column: 1;
    width: 100%;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0 0.78rem;
    color: rgb(15 23 42);
    font-size: 0.96rem;
    outline: none;
  }

  .search-panel button {
    grid-column: 2;
    width: 100%;
  }

  .search-panel input::placeholder {
    color: rgb(100 116 139);
  }

  .search-count {
    margin: 0;
    color: rgb(100 116 139);
    font-size: 0.86rem;
    font-weight: 780;
  }

  .search-empty {
    display: block;
    border: 1px solid rgb(15 23 42 / 0.08);
    border-radius: 8px;
    padding: 1rem;
    background: rgb(255 255 255 / 0.22);
  }

  :global(.dark) .search-panel input {
    color: rgb(241 245 249);
  }

  :global(.dark) .search-panel input::placeholder {
    color: rgb(148 163 184);
  }

  :global(.dark) .search-count {
    color: rgb(148 163 184);
  }

  :global(.dark) .search-empty {
    border-color: rgb(255 255 255 / 0.1);
    background: rgb(15 23 42 / 0.24);
  }

  @media (max-width: 620px) {
    .search-panel {
      grid-template-columns: 1fr;
    }

    .search-panel button {
      grid-column: 1;
    }

    .search-panel input {
      grid-column: 1;
      min-height: 2.7rem;
    }
  }
</style>
