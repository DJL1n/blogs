---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('important')).filter((post) => !post.data.draft);
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="重要事项" description="决策记录与变更日志">
  <section class="space-y-4">
    <h1 class="text-3xl font-bold">重要事项</h1>
    <div class="grid gap-4 sm:grid-cols-2">
      {posts.map((post) => <PostCard item={post} href={`/important/${post.slug}`} />)}
    </div>
  </section>
</BaseLayout>
