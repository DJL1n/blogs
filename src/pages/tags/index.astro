---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { getCollection } from 'astro:content';

const posts = [
  ...(await getCollection('blog')),
  ...(await getCollection('notes')),
  ...(await getCollection('important'))
];
const tags = Array.from(new Set(posts.flatMap((item) => item.data.tags).map((tag) => tag.toLowerCase()))).sort();
---

<BaseLayout title="标签" description="按标签快速筛选文章">
  <section class="space-y-4">
    <h1 class="text-3xl font-bold">标签页</h1>
    <TagList tags={tags} />
  </section>
</BaseLayout>
