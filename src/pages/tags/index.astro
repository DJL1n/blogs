---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TagList from '../../components/TagList.astro';
import { getCollection } from 'astro:content';

const posts = [
  ...(await getCollection('blog')),
  ...(await getCollection('notes')),
  ...(await getCollection('important'))
];
const tags = Array.from(new Set(posts.flatMap((item) => item.data.tags).map((tag) => tag.toLowerCase()))).sort();
---

<BaseLayout title="标签" description="按标签快速筛选文章">
  <section class="page-stack">
    <PageHeader
      eyebrow="Tag Index"
      title="标签页"
      description="用标签串起跨分类的主题脉络，适合从一个概念追到所有相关记录。"
      meta={[`${tags.length} 个标签`, '跨集合筛选']}
      actions={[{ label: '站内搜索', href: '/search' }]}
    />

    <div class="card index-panel reveal">
      <TagList tags={tags} />
    </div>
  </section>
</BaseLayout>
