---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagList from '../components/TagList.astro';
import CategoryList from '../components/CategoryList.astro';
import { getCollection } from 'astro:content';

const allPosts = [
  ...(await getCollection('blog')).map((p) => ({ ...p, path: `/blog/${p.slug}` })),
  ...(await getCollection('notes')).map((p) => ({ ...p, path: `/notes/${p.slug}` })),
  ...(await getCollection('important')).map((p) => ({ ...p, path: `/important/${p.slug}` })),
];

const published = allPosts.filter((p) => !p.data.draft);
const sorted = published.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recent = sorted.slice(0, 6);
const heroRecent = sorted.slice(0, 3);

const blogCount = published.filter((p) => p.data.type === 'blog').length;
const noteCount = published.filter((p) => p.data.type === 'note').length;
const importantCount = published.filter((p) => p.data.type === 'important').length;

const tags = Array.from(
  new Set(published.flatMap((p) => p.data.tags).map((t) => t.toLowerCase()))
).sort();

const categories = Array.from(
  new Set(published.map((p) => p.data.category.toLowerCase()))
).sort();

const planPost = (await getCollection('important')).find((p) => p.slug === 'long-term-plan');
const todoPost = (await getCollection('important')).find((p) => p.slug === 'short-term-todo');
const longTermPlan = planPost?.data.plan ?? [];
const shortTermTodos = todoPost?.data.todos ?? [];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);

const metrics = [
  { label: '文章', value: published.length, tone: 'cyan' },
  { label: '博客', value: blogCount, tone: 'green' },
  { label: '笔记', value: noteCount, tone: 'amber' },
  { label: '记录', value: importantCount, tone: 'rose' },
];

const primaryActions = [
  { label: '博客', href: '/blog', style: 'btn-primary' },
  { label: '笔记', href: '/notes', style: 'btn-secondary' },
  { label: '重要记录', href: '/important', style: 'btn-secondary' },
  { label: '写作', href: '/editor', style: 'btn-secondary' },
];

const focusAreas = [
  'Computer Vision',
  'SLAM / 3DGS',
  'Tooling',
  'Research Notes',
];
---

<BaseLayout title="山不见我" description="技术笔记 · 长期写作 · 可迁移的个人站点">
  <canvas id="liquid-field" class="liquid-field" aria-hidden="true"></canvas>

  <div class="home-stage">
    <section class="hero-liquid" id="hero-section">
      <div class="hero-backplate" aria-hidden="true">
        <span class="glass-ribbon glass-ribbon-a"></span>
        <span class="glass-ribbon glass-ribbon-b"></span>
        <span class="glass-ribbon glass-ribbon-c"></span>
      </div>

      <div class="hero-copy reveal">
        <p class="hero-kicker">山不见我，我自见山</p>
        <h1>
          <span>山不见我</span>
          <span class="hero-title-line">长期知识库</span>
        </h1>
        <p class="hero-intro">
          整理技术笔记、研究脉络和重要记录。内容保持静态、可迁移、可长期维护，页面只服务于阅读、检索和沉淀。
        </p>
      </div>

      <div class="hero-actions reveal reveal-delay-1">
        {primaryActions.map((action) => (
          <a href={action.href} class={`${action.style} magnetic`}>{action.label}</a>
        ))}
      </div>

      <div class="hero-focus reveal reveal-delay-2" aria-label="关注方向">
        {focusAreas.map((area) => (
          <span>{area}</span>
        ))}
      </div>
    </section>

    <section class="signal-grid" aria-label="站点概览">
      {metrics.map((metric, index) => (
        <article
          class={`metric-panel liquid-panel reveal reveal-delay-${Math.min(index + 1, 4)}`}
          data-liquid-panel
          data-tilt
          data-tone={metric.tone}
        >
          <p class="metric-value">
            <span class="counter" data-target={metric.value}>0</span>
          </p>
          <p class="metric-label">{metric.label}</p>
        </article>
      ))}

      <article class="latest-panel liquid-panel reveal reveal-delay-2" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <h2>近期沉淀</h2>
          <a href="/blog" class="panel-link magnetic">全部</a>
        </div>
        <div class="latest-list">
          {heroRecent.length > 0 ? (
            heroRecent.map((post) => (
              <a href={post.path} class="latest-row">
                <span class="latest-date">{formatDate(post.data.date)}</span>
                <span class="latest-title">{post.data.title}</span>
              </a>
            ))
          ) : (
            <p class="empty-copy">暂无发布内容。</p>
          )}
        </div>
      </article>
    </section>

    <section class="workbench-grid" aria-label="计划与待办">
      <article class="liquid-panel reveal" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Roadmap</p>
            <h2>长期计划</h2>
          </div>
          <a
            href="https://github.com/Djl1n/blogs/edit/main/src/content/important/long-term-plan.md"
            target="_blank"
            class="panel-link magnetic"
          >编辑</a>
        </div>

        {longTermPlan.length > 0 ? (
          <div class="timeline-list">
            {longTermPlan.map((item) => (
              <div class="timeline-item">
                <span class={`timeline-dot ${item.status}`}></span>
                <div>
                  <div class="timeline-head">
                    <h3>{item.title}</h3>
                    <span class={`status-pill ${item.status}`}>
                      {item.status === 'done' ? '已完成' : item.status === 'active' ? '进行中' : '计划中'}
                    </span>
                  </div>
                  <p>{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-copy">暂无计划。在 long-term-plan.md 中添加 plan 条目即可。</p>
        )}
      </article>

      <article class="liquid-panel reveal reveal-delay-1" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Now</p>
            <h2>短期待办</h2>
          </div>
          <a
            href="https://github.com/Djl1n/blogs/edit/main/src/content/important/short-term-todo.md"
            target="_blank"
            class="panel-link magnetic"
          >编辑</a>
        </div>

        {shortTermTodos.length > 0 ? (
          <div class="todo-list">
            {shortTermTodos.map((item) => (
              <div class="todo-item">
                <span class={`todo-check ${item.done ? 'done' : ''}`} aria-hidden="true"></span>
                <span class={item.done ? 'is-done' : ''}>{item.text}</span>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-copy">暂无待办。在 short-term-todo.md 中添加 todos 条目即可。</p>
        )}
      </article>
    </section>

    <section class="content-section">
      <div class="section-heading reveal">
        <div>
          <p class="panel-eyebrow">Recent</p>
          <h2>最近更新</h2>
        </div>
        {published.length > 6 && (
          <a href="/blog" class="panel-link magnetic">查看全部 {published.length} 篇</a>
        )}
      </div>

      <div class="recent-grid">
        {recent.map((post, i) => (
          <div class="post-card-wrapper reveal" style={`--reveal-delay: ${120 + (i % 6) * 80}ms`} data-tilt>
            <PostCard item={post} href={post.path} />
          </div>
        ))}
      </div>
    </section>

    <section class="navigation-grid" aria-label="快速导航">
      <article class="liquid-panel reveal" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Index</p>
            <h2>分类</h2>
          </div>
          <a href="/categories" class="panel-link magnetic">全部</a>
        </div>
        <CategoryList categories={categories} />
      </article>

      <article class="liquid-panel reveal reveal-delay-1" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Tags</p>
            <h2>标签</h2>
          </div>
          <a href="/tags" class="panel-link magnetic">全部</a>
        </div>
        <TagList tags={tags} />
      </article>
    </section>
  </div>
</BaseLayout>

<style is:global>
  .liquid-field {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.78;
  }

  .home-stage {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem;
    min-width: 0;
    max-width: 100%;
    overflow-x: clip;
  }

  .hero-liquid {
    position: relative;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 520px;
    display: grid;
    align-content: center;
    gap: 1.4rem;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 5.5rem) 0 clamp(2rem, 4vw, 4rem);
    isolation: isolate;
  }

  .hero-backplate {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: 8px;
  }

  .hero-backplate::before {
    content: '';
    position: absolute;
    inset: 2.5rem 0 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.48);
    border-radius: 8px;
    background:
      linear-gradient(120deg, rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.1) 38%, rgb(236 253 245 / 0.25) 74%, rgb(255 247 237 / 0.2)),
      linear-gradient(180deg, rgb(255 255 255 / 0.44), rgb(255 255 255 / 0.16));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.8),
      inset 0 -1px 0 rgb(15 23 42 / 0.08),
      0 34px 90px rgb(15 23 42 / 0.12);
    backdrop-filter: blur(28px) saturate(160%) contrast(105%);
    -webkit-backdrop-filter: blur(28px) saturate(160%) contrast(105%);
  }

  .dark .hero-backplate::before {
    border-color: rgb(255 255 255 / 0.12);
    background:
      linear-gradient(120deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.04) 40%, rgb(20 184 166 / 0.08) 72%, rgb(251 146 60 / 0.06)),
      linear-gradient(180deg, rgb(2 6 23 / 0.42), rgb(2 6 23 / 0.16));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.16),
      inset 0 -1px 0 rgb(255 255 255 / 0.04),
      0 34px 90px rgb(0 0 0 / 0.36);
  }

  .glass-ribbon {
    position: absolute;
    display: block;
    height: 11rem;
    width: 74rem;
    left: 50%;
    border: 1px solid rgb(255 255 255 / 0.34);
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.36), rgb(255 255 255 / 0));
    filter: blur(0.2px);
    opacity: 0.64;
    transform-origin: center;
    animation: glass-drift 12s ease-in-out infinite alternate;
  }

  .glass-ribbon-a {
    top: 9%;
    transform: translateX(-50%) rotate(-8deg);
  }

  .glass-ribbon-b {
    top: 39%;
    animation-delay: -5s;
    transform: translateX(-50%) rotate(8deg);
  }

  .glass-ribbon-c {
    top: 64%;
    animation-delay: -9s;
    transform: translateX(-50%) rotate(-3deg);
  }

  .dark .glass-ribbon {
    border-color: rgb(255 255 255 / 0.08);
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.12), rgb(255 255 255 / 0));
  }

  .hero-copy {
    max-width: 56rem;
    min-width: 0;
    padding: 0 1.4rem;
  }

  .hero-kicker,
  .panel-eyebrow {
    margin: 0;
    color: rgb(20 184 166);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .dark .hero-kicker,
  .dark .panel-eyebrow {
    color: rgb(94 234 212);
  }

  .hero-copy h1 {
    margin: 0.7rem 0 0;
    color: rgb(9 13 18);
    font-size: clamp(3.15rem, 8vw, 7rem);
    font-weight: 950;
    line-height: 0.92;
    letter-spacing: 0;
  }

  .dark .hero-copy h1 {
    color: rgb(248 250 252);
  }

  .hero-title-line {
    display: block;
    color: transparent;
    -webkit-text-stroke: 1px rgb(15 23 42 / 0.5);
    text-shadow: none;
  }

  .dark .hero-title-line {
    -webkit-text-stroke-color: rgb(226 232 240 / 0.46);
  }

  .hero-intro {
    max-width: 48rem;
    margin: 1.25rem 0 0;
    color: rgb(51 65 85);
    font-size: 1.03rem;
    line-height: 1.85;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .dark .hero-intro {
    color: rgb(203 213 225);
  }

  .hero-actions,
  .hero-focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    min-width: 0;
    max-width: 100%;
    padding: 0 1.4rem;
  }

  .hero-focus span {
    display: inline-flex;
    align-items: center;
    flex: 0 1 auto;
    min-height: 2.15rem;
    max-width: 100%;
    border: 1px solid rgb(15 23 42 / 0.08);
    border-radius: 8px;
    padding: 0.45rem 0.7rem;
    color: rgb(51 65 85);
    background: rgb(255 255 255 / 0.28);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    font-size: 0.78rem;
    font-weight: 750;
    overflow-wrap: anywhere;
  }

  .dark .hero-focus span {
    border-color: rgb(255 255 255 / 0.1);
    color: rgb(203 213 225);
    background: rgb(15 23 42 / 0.28);
  }

  .signal-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    min-width: 0;
  }

  .metric-panel {
    min-height: 8.5rem;
  }

  .metric-panel::after {
    background:
      linear-gradient(130deg, transparent 0 35%, rgb(255 255 255 / 0.5) 46%, transparent 58%),
      radial-gradient(circle at var(--mx, 50%) var(--my, 30%), var(--tone-glow, rgb(20 184 166 / 0.18)), transparent 38%);
  }

  .metric-panel[data-tone='cyan'] {
    --tone-glow: rgb(6 182 212 / 0.2);
  }

  .metric-panel[data-tone='green'] {
    --tone-glow: rgb(34 197 94 / 0.18);
  }

  .metric-panel[data-tone='amber'] {
    --tone-glow: rgb(245 158 11 / 0.2);
  }

  .metric-panel[data-tone='rose'] {
    --tone-glow: rgb(244 63 94 / 0.16);
  }

  .metric-value {
    margin: 0;
    color: rgb(9 13 18);
    font-size: 2.55rem;
    font-weight: 950;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .dark .metric-value {
    color: rgb(248 250 252);
  }

  .metric-label {
    margin: 0.75rem 0 0;
    color: rgb(71 85 105);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .dark .metric-label {
    color: rgb(148 163 184);
  }

  .latest-panel {
    grid-column: span 4;
  }

  .panel-heading,
  .section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }

  .panel-heading h2,
  .section-heading h2 {
    margin: 0.2rem 0 0;
    color: rgb(15 23 42);
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: 0;
  }

  .dark .panel-heading h2,
  .dark .section-heading h2 {
    color: rgb(248 250 252);
  }

  .panel-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    border: 1px solid rgb(15 23 42 / 0.08);
    border-radius: 8px;
    padding: 0.3rem 0.6rem;
    color: rgb(15 23 42 / 0.72);
    background: rgb(255 255 255 / 0.2);
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }

  .panel-link:hover {
    color: rgb(15 118 110);
    border-color: rgb(20 184 166 / 0.38);
  }

  .dark .panel-link {
    border-color: rgb(255 255 255 / 0.1);
    color: rgb(226 232 240 / 0.78);
    background: rgb(15 23 42 / 0.26);
  }

  .dark .panel-link:hover {
    color: rgb(94 234 212);
    border-color: rgb(94 234 212 / 0.34);
  }

  .latest-list {
    display: grid;
    gap: 0.45rem;
  }

  .latest-row {
    display: grid;
    grid-template-columns: 8.2rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    border-radius: 8px;
    padding: 0.65rem 0.7rem;
    text-decoration: none;
  }

  .latest-row:hover {
    background: rgb(255 255 255 / 0.24);
  }

  .dark .latest-row:hover {
    background: rgb(255 255 255 / 0.06);
  }

  .latest-date {
    color: rgb(100 116 139);
    font-size: 0.77rem;
    font-variant-numeric: tabular-nums;
  }

  .latest-title {
    overflow: hidden;
    color: rgb(15 23 42);
    font-size: 0.94rem;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dark .latest-date {
    color: rgb(148 163 184);
  }

  .dark .latest-title {
    color: rgb(226 232 240);
  }

  .workbench-grid,
  .navigation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    min-width: 0;
  }

  .timeline-list,
  .todo-list {
    display: grid;
    gap: 0.9rem;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-bottom: 0;
  }

  .timeline-dot {
    position: relative;
    top: 0.2rem;
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid rgb(20 184 166);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.8);
    box-shadow: 0 0 0 5px rgb(20 184 166 / 0.12);
  }

  .timeline-dot::after {
    content: '';
    position: absolute;
    top: 0.75rem;
    left: 50%;
    width: 1px;
    height: calc(100% + 3.1rem);
    background: linear-gradient(rgb(20 184 166 / 0.28), rgb(245 158 11 / 0.18));
    transform: translateX(-50%);
  }

  .timeline-item:last-child .timeline-dot::after {
    display: none;
  }

  .timeline-dot.done {
    border-color: rgb(34 197 94);
    box-shadow: 0 0 0 5px rgb(34 197 94 / 0.12);
  }

  .timeline-dot.active {
    border-color: rgb(245 158 11);
    box-shadow: 0 0 0 5px rgb(245 158 11 / 0.14);
  }

  .dark .timeline-dot {
    background: rgb(15 23 42 / 0.82);
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .timeline-head h3 {
    margin: 0;
    color: rgb(15 23 42);
    font-size: 0.95rem;
    font-weight: 850;
  }

  .timeline-item p {
    margin: 0.35rem 0 0;
    color: rgb(71 85 105);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .dark .timeline-head h3 {
    color: rgb(241 245 249);
  }

  .dark .timeline-item p {
    color: rgb(148 163 184);
  }

  .status-pill {
    border-radius: 999px;
    padding: 0.13rem 0.45rem;
    font-size: 0.68rem;
    font-weight: 850;
  }

  .status-pill.done {
    color: rgb(22 101 52);
    background: rgb(220 252 231 / 0.78);
  }

  .status-pill.active {
    color: rgb(146 64 14);
    background: rgb(254 243 199 / 0.82);
  }

  .status-pill.planned {
    color: rgb(71 85 105);
    background: rgb(226 232 240 / 0.78);
  }

  .dark .status-pill.done {
    color: rgb(134 239 172);
    background: rgb(22 101 52 / 0.28);
  }

  .dark .status-pill.active {
    color: rgb(253 186 116);
    background: rgb(154 52 18 / 0.26);
  }

  .dark .status-pill.planned {
    color: rgb(203 213 225);
    background: rgb(71 85 105 / 0.28);
  }

  .todo-item {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    border-radius: 8px;
    padding: 0.62rem 0.65rem;
    color: rgb(51 65 85);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .todo-item:hover {
    background: rgb(255 255 255 / 0.22);
  }

  .dark .todo-item {
    color: rgb(203 213 225);
  }

  .dark .todo-item:hover {
    background: rgb(255 255 255 / 0.06);
  }

  .todo-check {
    position: relative;
    top: 0.22rem;
    width: 1rem;
    height: 1rem;
    border: 1px solid rgb(100 116 139 / 0.6);
    border-radius: 4px;
    background: rgb(255 255 255 / 0.36);
  }

  .todo-check.done {
    border-color: rgb(20 184 166);
    background: rgb(20 184 166);
  }

  .todo-check.done::after {
    content: '';
    position: absolute;
    top: 0.16rem;
    left: 0.29rem;
    width: 0.32rem;
    height: 0.55rem;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .todo-item .is-done {
    color: rgb(100 116 139);
    text-decoration: line-through;
  }

  .content-section {
    display: grid;
    gap: 1rem;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    min-width: 0;
  }

  .post-card-wrapper {
    perspective: 900px;
  }

  .post-card-wrapper.reveal {
    transition-delay: var(--reveal-delay, 0ms);
  }

  .empty-copy {
    margin: 0;
    color: rgb(100 116 139);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .dark .empty-copy {
    color: rgb(148 163 184);
  }

  .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.72s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-delay-1 { transition-delay: 90ms; }
  .reveal-delay-2 { transition-delay: 160ms; }
  .reveal-delay-3 { transition-delay: 230ms; }
  .reveal-delay-4 { transition-delay: 300ms; }

  @keyframes glass-drift {
    from {
      translate: -1.5rem 0;
    }
    to {
      translate: 1.5rem 0.8rem;
    }
  }

  @media (max-width: 1024px) {
    .hero-liquid {
      min-height: 470px;
    }

    .signal-grid,
    .recent-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .latest-panel {
      grid-column: span 2;
    }
  }

  @media (max-width: 720px) {
    .hero-liquid {
      min-height: auto;
      padding-top: 2.8rem;
      max-width: 100%;
      overflow-x: clip;
    }

    .hero-copy {
      width: 100%;
      padding: 0 0.2rem;
    }

    .hero-copy h1 {
      font-size: 2.55rem;
      line-height: 0.98;
    }

    .hero-intro {
      max-width: 100%;
      font-size: 0.96rem;
    }

    .hero-focus span {
      max-width: 100%;
      flex: 0 1 auto;
    }

    .hero-actions,
    .hero-focus {
      padding: 0;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }

    .hero-focus {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }

    .hero-focus span {
      justify-content: center;
      width: 100%;
    }

    .signal-grid,
    .workbench-grid,
    .navigation-grid,
    .recent-grid {
      grid-template-columns: 1fr;
    }

    .latest-panel {
      grid-column: auto;
    }

    .latest-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .latest-title {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-ribbon {
      animation: none;
    }

    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  (function initLiquidField() {
    const canvasElement = document.getElementById('liquid-field');
    if (!(canvasElement instanceof HTMLCanvasElement) || reducedMotion) return;

    const canvas: HTMLCanvasElement = canvasElement;
    const context = canvas.getContext('2d');
    if (!context) return;
    const ctx: CanvasRenderingContext2D = context;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let pointerX = -9999;
    let pointerY = -9999;
    let raf = 0;

    const strands = Array.from({ length: 9 }, (_, index) => ({
      offset: index / 9,
      speed: 0.00018 + index * 0.000018,
      amp: 18 + (index % 4) * 7,
    }));

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function draw(now: number) {
      ctx.clearRect(0, 0, width, height);
      const isDark = document.documentElement.classList.contains('dark');
      const baseAlpha = isDark ? 0.13 : 0.16;
      const accentAlpha = isDark ? 0.2 : 0.18;

      strands.forEach((strand, strandIndex) => {
        const yBase = height * (0.16 + strand.offset * 0.86);
        const hue = strandIndex % 3 === 0 ? '20 184 166' : strandIndex % 3 === 1 ? '245 158 11' : '244 63 94';
        ctx.beginPath();

        for (let x = -40; x <= width + 40; x += 22) {
          const phase = now * strand.speed + x * 0.006 + strand.offset * 5.8;
          const wave = Math.sin(phase) * strand.amp + Math.sin(phase * 0.43 + strandIndex) * strand.amp * 0.48;
          const dx = x - pointerX;
          const dy = yBase - pointerY;
          const distance = Math.sqrt(dx * dx + dy * dy);
          const pull = distance < 220 ? (1 - distance / 220) * 34 : 0;
          const y = yBase + wave + pull;

          if (x === -40) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }

        ctx.strokeStyle = `rgb(${hue} / ${strandIndex % 2 === 0 ? accentAlpha : baseAlpha})`;
        ctx.lineWidth = strandIndex % 2 === 0 ? 1.1 : 0.75;
        ctx.stroke();
      });

      raf = requestAnimationFrame(draw);
    }

    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('pointermove', (event) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
    }, { passive: true });
    window.addEventListener('pointerleave', () => {
      pointerX = -9999;
      pointerY = -9999;
    }, { passive: true });

    resize();
    raf = requestAnimationFrame(draw);

    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  })();

  (function initReveal() {
    const elements = document.querySelectorAll<HTMLElement>('.reveal');
    if (!elements.length || reducedMotion) {
      elements.forEach((element) => element.classList.add('visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -42px 0px' }
    );

    elements.forEach((element) => observer.observe(element));
  })();

  (function initCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.counter');
    if (!counters.length) return;

    const runCounter = (element: HTMLElement) => {
      const target = Number.parseInt(element.dataset.target || '0', 10);
      if (!Number.isFinite(target)) return;
      if (reducedMotion) {
        element.textContent = String(target);
        return;
      }

      const duration = 1100;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        element.textContent = String(Math.round(eased * target));
        if (progress < 1) requestAnimationFrame(tick);
        else element.textContent = String(target);
      };
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        runCounter(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.5 });

    counters.forEach((counter) => observer.observe(counter));
  })();

  (function initPointerGlass() {
    const interactiveElements = document.querySelectorAll<HTMLElement>('[data-liquid-panel], [data-tilt]');
    const magneticElements = document.querySelectorAll<HTMLElement>('.magnetic');
    if (reducedMotion) return;

    interactiveElements.forEach((element) => {
      element.addEventListener('pointermove', (event) => {
        const rect = element.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        const px = x / rect.width - 0.5;
        const py = y / rect.height - 0.5;

        element.style.setProperty('--mx', `${x}px`);
        element.style.setProperty('--my', `${y}px`);

        if (!element.hasAttribute('data-tilt')) return;
        element.style.transform = `perspective(900px) rotateX(${(-py * 5).toFixed(2)}deg) rotateY(${(px * 6).toFixed(2)}deg) translate3d(0, -2px, 0)`;
      }, { passive: true });

      element.addEventListener('pointerleave', () => {
        element.style.removeProperty('--mx');
        element.style.removeProperty('--my');
        element.style.transform = '';
      }, { passive: true });
    });

    magneticElements.forEach((element) => {
      element.addEventListener('pointermove', (event) => {
        const rect = element.getBoundingClientRect();
        const x = event.clientX - rect.left - rect.width / 2;
        const y = event.clientY - rect.top - rect.height / 2;
        element.style.transform = `translate(${(x * 0.12).toFixed(1)}px, ${(y * 0.18).toFixed(1)}px)`;
      }, { passive: true });

      element.addEventListener('pointerleave', () => {
        element.style.transform = '';
      }, { passive: true });
    });
  })();
</script>
