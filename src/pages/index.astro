---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagList from '../components/TagList.astro';
import CategoryList from '../components/CategoryList.astro';
import { getCollection } from 'astro:content';

const allPosts = [
  ...(await getCollection('blog')).map((p) => ({ ...p, path: `/blog/${p.slug}` })),
  ...(await getCollection('notes')).map((p) => ({ ...p, path: `/notes/${p.slug}` })),
  ...(await getCollection('important')).map((p) => ({ ...p, path: `/important/${p.slug}` })),
];

const published = allPosts.filter((p) => !p.data.draft);
const sorted = published.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recent = sorted.slice(0, 6);

const blogCount = published.filter((p) => p.data.type === 'blog').length;
const noteCount = published.filter((p) => p.data.type === 'notes').length;
const importantCount = published.filter((p) => p.data.type === 'important').length;

const tags = Array.from(
  new Set(published.flatMap((p) => p.data.tags).map((t) => t.toLowerCase()))
).sort();

const categories = Array.from(
  new Set(published.map((p) => p.data.category.toLowerCase()))
).sort();

// 从内容集合读取计划与待办
const planPost = (await getCollection('important')).find((p) => p.slug === 'long-term-plan');
const todoPost = (await getCollection('important')).find((p) => p.slug === 'short-term-todo');

const longTermPlan = planPost?.data.plan ?? [];
const shortTermTodos = todoPost?.data.todos ?? [];
---

<BaseLayout title="山不见我" description="技术笔记 · 长期写作 · 可迁移的个人站点">
  <div class="space-y-10 animate-fade-in">

    <!-- ====== Hero —— 个人介绍 ====== -->
    <section class="surface-card-elevated relative overflow-hidden">
      <div class="absolute right-4 top-4 h-24 w-24 rounded-full bg-gradient-to-br from-blue-400 to-violet-500 opacity-10 blur-2xl"></div>
      <div class="absolute -left-8 -top-8 h-32 w-32 rounded-full bg-gradient-to-br from-emerald-300 to-sky-400 opacity-5 blur-3xl"></div>
      <div class="relative flex flex-col gap-6 sm:flex-row sm:items-start">
        <!-- 头像占位 -->
        <div class="flex h-20 w-20 flex-shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-slate-700 to-slate-900 text-3xl shadow-lg dark:from-slate-200 dark:to-slate-400">
          🏔️
        </div>
        <div class="min-w-0 flex-1">
          <p class="inline-flex rounded-full bg-gradient-to-r from-blue-50 to-indigo-50 px-3 py-1 text-xs font-semibold text-blue-700 ring-1 ring-blue-200/60 dark:from-slate-800 dark:to-indigo-950 dark:text-blue-300 dark:ring-blue-800">
            山不见我，我自见山
          </p>
          <h1 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">
            山不见我
          </h1>
          <p class="mt-3 max-w-xl leading-relaxed text-slate-600 dark:text-slate-300">
            这里是我整理技术笔记、记录思考、沉淀知识的地方。内容涵盖计算机视觉、SLAM、三维重建、开发工具链等方向。追求长期可维护的静态写作，而非流量驱动的内容农场。
          </p>
          <!-- 社交链接 -->
          <div class="mt-4 flex flex-wrap gap-2 text-sm">
            <a href="https://github.com/Djl1n" class="btn-secondary text-xs py-1.5 px-3" target="_blank">GitHub</a>
            <a href="/about" class="btn-secondary text-xs py-1.5 px-3">关于我</a>
            <a href="/rss.xml" class="btn-secondary text-xs py-1.5 px-3">RSS</a>
          </div>
        </div>
      </div>

      <!-- Stats row -->
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-xl border border-blue-100 bg-blue-50/60 p-3 text-center dark:border-blue-900 dark:bg-blue-950/40">
          <p class="text-2xl font-black text-blue-700 dark:text-blue-300">{published.length}</p>
          <p class="text-xs font-medium text-blue-600/70 dark:text-blue-400/70">文章</p>
        </div>
        <div class="rounded-xl border border-indigo-100 bg-indigo-50/60 p-3 text-center dark:border-indigo-900 dark:bg-indigo-950/40">
          <p class="text-2xl font-black text-indigo-700 dark:text-indigo-300">{blogCount}</p>
          <p class="text-xs font-medium text-indigo-600/70 dark:text-indigo-400/70">博客</p>
        </div>
        <div class="rounded-xl border border-violet-100 bg-violet-50/60 p-3 text-center dark:border-violet-900 dark:bg-violet-950/40">
          <p class="text-2xl font-black text-violet-700 dark:text-violet-300">{noteCount}</p>
          <p class="text-xs font-medium text-violet-600/70 dark:text-violet-400/70">笔记</p>
        </div>
        <div class="rounded-xl border border-emerald-100 bg-emerald-50/60 p-3 text-center dark:border-emerald-900 dark:bg-emerald-950/40">
          <p class="text-2xl font-black text-emerald-700 dark:text-emerald-300">{importantCount}</p>
          <p class="text-xs font-medium text-emerald-600/70 dark:text-emerald-400/70">记录</p>
        </div>
      </div>

      <!-- Quick actions -->
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/blog" class="btn-primary">博客</a>
        <a href="/notes" class="btn-secondary">笔记</a>
        <a href="/important" class="btn-secondary">重要记录</a>
        <a href="/editor" class="btn-secondary">写作</a>
      </div>
    </section>

    <!-- ====== 双列面板 ====== -->
    <div class="grid gap-6 lg:grid-cols-2">
      <!-- 长期计划 -->
      <section class="surface-card">
        <div class="flex items-center justify-between">
          <h2 class="section-title">长期计划</h2>
          <a
            href="https://github.com/Djl1n/blogs/edit/main/src/content/important/long-term-plan.md"
            target="_blank"
            class="text-xs text-slate-400 hover:text-blue-500 transition-colors"
          >编辑 ✎</a>
        </div>
        <p class="mt-1 mb-5 text-sm text-slate-500 dark:text-slate-400">博客建设与内容路线图</p>
        {longTermPlan.length > 0 ? (
          <div>
            {longTermPlan.map((item) => (
              <div class="timeline-item">
                <span class={`timeline-dot ${item.status === 'done' ? 'done' : item.status === 'active' ? 'active' : ''}`}></span>
                <div class="flex items-center gap-2">
                  <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{item.title}</h3>
                  {item.status === 'done' && (
                    <span class="inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-medium text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-300">已完成</span>
                  )}
                  {item.status === 'active' && (
                    <span class="inline-flex rounded-full bg-violet-100 px-2 py-0.5 text-[10px] font-medium text-violet-700 dark:bg-violet-900/50 dark:text-violet-300">进行中</span>
                  )}
                  {item.status === 'planned' && (
                    <span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">计划中</span>
                  )}
                </div>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{item.detail}</p>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-slate-400 italic dark:text-slate-500">暂无计划。在 long-term-plan.md 中添加 plan 条目即可。</p>
        )}
      </section>

      <!-- 短期待办 -->
      <section class="surface-card">
        <div class="flex items-center justify-between">
          <h2 class="section-title">短期待办</h2>
          <a
            href="https://github.com/Djl1n/blogs/edit/main/src/content/important/short-term-todo.md"
            target="_blank"
            class="text-xs text-slate-400 hover:text-blue-500 transition-colors"
          >编辑 ✎</a>
        </div>
        <p class="mt-1 mb-5 text-sm text-slate-500 dark:text-slate-400">本周 / 本月待完成事项</p>
        {shortTermTodos.length > 0 ? (
          <div class="space-y-1">
            {shortTermTodos.map((item) => (
              <div class="todo-item">
                <span class={`todo-check ${item.done ? 'done' : ''}`}></span>
                <span class={`text-sm ${item.done ? 'text-slate-400 line-through dark:text-slate-500' : 'text-slate-700 dark:text-slate-200'}`}>
                  {item.text}
                </span>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-slate-400 italic dark:text-slate-500">暂无待办。在 short-term-todo.md 中添加 todos 条目即可。</p>
        )}
      </section>
    </div>

    <!-- ====== 最近更新 ====== -->
    <section>
      <h2 class="section-title mb-1">最近更新</h2>
      <p class="mb-5 text-sm text-slate-500 dark:text-slate-400">最新发布的文章和笔记</p>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {recent.map((post) => <PostCard item={post} href={post.path} />)}
      </div>
      {published.length > 6 && (
        <div class="mt-4 text-center">
          <a href="/blog" class="btn-secondary">查看全部 {published.length} 篇文章 →</a>
        </div>
      )}
    </section>

    <!-- ====== 快速导航 ====== -->
    <div class="grid gap-6 sm:grid-cols-2">
      <section class="surface-card">
        <h2 class="section-title mb-4">分类</h2>
        <CategoryList categories={categories} />
      </section>
      <section class="surface-card">
        <h2 class="section-title mb-4">标签</h2>
        <TagList tags={tags} />
      </section>
    </div>

  </div>
</BaseLayout>
