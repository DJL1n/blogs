---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryList from '../components/CategoryList.astro';
import PostCard from '../components/PostCard.astro';
import TagList from '../components/TagList.astro';
import { getCollection } from 'astro:content';

const allPosts = [
  ...(await getCollection('blog')).map((p) => ({ ...p, path: `/blog/${p.slug}` })),
  ...(await getCollection('notes')).map((p) => ({ ...p, path: `/notes/${p.slug}` })),
  ...(await getCollection('important')).map((p) => ({ ...p, path: `/important/${p.slug}` })),
];

const published = allPosts.filter((p) => !p.data.draft);
const sorted = published.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recent = sorted.slice(0, 6);
const heroRecent = sorted.slice(0, 4);

const blogCount = published.filter((p) => p.data.type === 'blog').length;
const noteCount = published.filter((p) => p.data.type === 'note').length;
const importantCount = published.filter((p) => p.data.type === 'important').length;

const tags = Array.from(
  new Set(published.flatMap((p) => p.data.tags).map((t) => t.toLowerCase()))
).sort();

const categories = Array.from(
  new Set(published.map((p) => p.data.category.toLowerCase()).filter(Boolean))
).sort();

const planPost = (await getCollection('important')).find((p) => p.slug === 'long-term-plan');
const todoPost = (await getCollection('important')).find((p) => p.slug === 'short-term-todo');
const longTermPlan = planPost?.data.plan ?? [];
const shortTermTodos = todoPost?.data.todos ?? [];

const metrics = [
  { label: '全部', value: published.length, tone: 'cyan' },
  { label: '长文', value: blogCount, tone: 'green' },
  { label: '笔记', value: noteCount, tone: 'amber' },
  { label: '记录', value: importantCount, tone: 'rose' },
];

const primaryActions = [
  { label: '博客', href: '/blog', style: 'btn-secondary' },
  { label: '笔记', href: '/notes', style: 'btn-secondary' },
  { label: '重要记录', href: '/important', style: 'btn-secondary' },
  { label: '写作入口', href: '/editor', style: 'btn-primary' },
];

const contentLanes = [
  {
    title: '长文系统',
    eyebrow: 'Blog',
    href: '/blog',
    count: blogCount,
    summary: '放系统设计、技术复盘和完整研究脉络，适合需要反复回看的内容。',
  },
  {
    title: '短笔记流',
    eyebrow: 'Notes',
    href: '/notes',
    count: noteCount,
    summary: '记录命令、坑点、片段和临时灵感，保持轻量、可检索。',
  },
  {
    title: '重要记录',
    eyebrow: 'Important',
    href: '/important',
    count: importantCount,
    summary: '沉淀配置、计划、决策和关键变更，方便长期追踪。',
  },
];

const focusAreas = ['Computer Vision', 'SLAM / 3DGS', 'Tooling', 'Research Notes'];
---

<BaseLayout title="山不见我" description="技术笔记 · 长期写作 · 可迁移的个人站点">
  <!-- Grain overlay -->
  <div id="grain" aria-hidden="true" style="position:fixed;inset:0;pointer-events:none;z-index:1;mix-blend-mode:overlay;opacity:0.03;background-image:url(data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E);background-repeat:repeat;background-size:128px"></div>

  <div class="home-stage">
    <div id="hero-bg" class="hero-bg-decoration" aria-hidden="true"></div>
    <section class="home-command" aria-labelledby="home-title">
      <div class="hero-core reveal">
        <p class="panel-eyebrow">Personal Knowledge OS</p>
        <h1 id="home-title">
          <span>山不见我</span>
          <span>长期知识工作台</span>
        </h1>
        <p class="hero-intro">
          技术长文、短笔记和重要记录统一沉淀在静态内容库里。第一屏直接服务于检索、进入内容和继续写作。
        </p>

        <form class="home-search liquid-control reveal reveal-delay-1" action="/search" method="get" role="search">
          <label for="home-q" class="sr-only">搜索站内内容</label>
          <input
            id="home-q"
            name="q"
            type="search"
            placeholder="搜索标题、摘要、标签或分类"
            autocomplete="off"
          />
          <button type="submit" class="btn-primary magnetic">搜索</button>
        </form>

        <div class="hero-actions reveal reveal-delay-2">
          {primaryActions.map((action) => (
            <a href={action.href} class={`${action.style} magnetic`}>{action.label}</a>
          ))}
        </div>

        <div class="hero-focus reveal reveal-delay-3" aria-label="关注方向">
          {focusAreas.map((area) => (
            <span>{area}</span>
          ))}
        </div>
      </div>

      <aside class="command-panel liquid-panel reveal reveal-delay-1" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Live Index</p>
            <h2>知识库状态</h2>
          </div>
          <a href="/search" class="panel-link magnetic">检索</a>
        </div>

        <div class="metric-strip" aria-label="站点概览">
          {metrics.map((metric) => (
            <div class="metric-cell" data-tone={metric.tone}>
              <span class="metric-value counter" data-target={metric.value}>0</span>
              <span class="metric-label">{metric.label}</span>
            </div>
          ))}
        </div>

        <div class="console-feed" aria-label="最近更新">
          {heroRecent.length > 0 ? (
            heroRecent.map((post) => (
              <a href={post.path} class="feed-row">
                <span class="feed-date">{post.data.date.toLocaleDateString('zh-CN')}</span>
                <span class="feed-title">{post.data.title}</span>
              </a>
            ))
          ) : (
            <p class="empty-copy">暂无发布内容。</p>
          )}
        </div>
      </aside>
    </section>

    <section class="lane-grid" aria-label="内容入口">
      {contentLanes.map((lane, index) => (
        <a
          href={lane.href}
          class={`lane-card liquid-panel reveal reveal-delay-${Math.min(index + 1, 3)}`}
          data-liquid-panel
          data-tilt
        >
          <span class="panel-eyebrow">{lane.eyebrow}</span>
          <strong>{lane.title}</strong>
          <p>{lane.summary}</p>
          <span class="lane-count">{lane.count} 条内容</span>
        </a>
      ))}
    </section>

    <section class="workbench-grid" aria-label="计划与待办">
      <article class="liquid-panel reveal" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Roadmap</p>
            <h2>长期计划</h2>
          </div>
          <a
            href="https://github.com/Djl1n/blogs/edit/main/src/content/important/long-term-plan.md"
            target="_blank"
            class="panel-link magnetic"
          >编辑</a>
        </div>

        {longTermPlan.length > 0 ? (
          <div class="timeline-list">
            {longTermPlan.map((item) => (
              <div class="timeline-item">
                <span class={`timeline-dot ${item.status}`}></span>
                <div>
                  <div class="timeline-head">
                    <h3>{item.title}</h3>
                    <span class={`status-pill ${item.status}`}>
                      {item.status === 'done' ? '已完成' : item.status === 'active' ? '进行中' : '计划中'}
                    </span>
                  </div>
                  <p>{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-copy">暂无计划。在 long-term-plan.md 中添加 plan 条目即可。</p>
        )}
      </article>

      <article class="liquid-panel reveal reveal-delay-1" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Now</p>
            <h2>短期待办</h2>
          </div>
          <a
            href="https://github.com/Djl1n/blogs/edit/main/src/content/important/short-term-todo.md"
            target="_blank"
            class="panel-link magnetic"
          >编辑</a>
        </div>

        {shortTermTodos.length > 0 ? (
          <div class="todo-list">
            {shortTermTodos.map((item) => (
              <div class="todo-item">
                <span class={`todo-check ${item.done ? 'done' : ''}`} aria-hidden="true"></span>
                <span class={item.done ? 'is-done' : ''}>{item.text}</span>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-copy">暂无待办。在 short-term-todo.md 中添加 todos 条目即可。</p>
        )}
      </article>
    </section>

    <section class="content-section">
      <div class="section-heading reveal">
        <div>
          <p class="panel-eyebrow">Recent</p>
          <h2>最近更新</h2>
        </div>
        {published.length > 6 && (
          <a href="/blog" class="panel-link magnetic">查看全部 {published.length} 篇</a>
        )}
      </div>

      <div class="recent-grid">
        {recent.map((post, i) => (
          <div class="post-card-wrapper reveal" style={`--reveal-delay: ${120 + (i % 6) * 80}ms`}>
            <PostCard item={post} href={post.path} />
          </div>
        ))}
      </div>
    </section>

    <section class="navigation-grid" aria-label="快速导航">
      <article class="liquid-panel reveal" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Index</p>
            <h2>分类</h2>
          </div>
          <a href="/categories" class="panel-link magnetic">全部</a>
        </div>
        <CategoryList categories={categories} />
      </article>

      <article class="liquid-panel reveal reveal-delay-1" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Tags</p>
            <h2>标签</h2>
          </div>
          <a href="/tags" class="panel-link magnetic">全部</a>
        </div>
        <TagList tags={tags} />
      </article>
    </section>
  </div>
</BaseLayout>

<style is:global>
  .home-stage {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.2rem;
    min-width: 0;
  }

  .home-command {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(19rem, 0.82fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    min-height: min(680px, calc(100vh - 7rem));
    padding: clamp(1.2rem, 4vw, 3.6rem) 0;
  }

  .hero-bg-decoration {
    position: absolute;
    right: -4rem;
    top: 0;
    width: 55%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: visible;
  }
  .hero-bg-decoration canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
    object-fit: contain;
  }

  .hero-core {
    min-width: 0;
  }

  .hero-core h1 {
    margin: 0.72rem 0 0;
    color: rgb(9 13 18);
    font-size: clamp(3.1rem, 7vw, 6.35rem);
    font-weight: 950;
    line-height: 0.9;
    letter-spacing: 0;
  }

  .hero-core h1 span {
    display: block;
  }

  .hero-core h1 span + span {
    color: transparent;
    -webkit-text-stroke: 1px rgb(15 23 42 / 0.55);
  }

  .dark .hero-core h1 {
    color: rgb(248 250 252);
  }

  .dark .hero-core h1 span + span {
    -webkit-text-stroke-color: rgb(226 232 240 / 0.48);
  }

  .hero-intro {
    max-width: 49rem;
    margin: 1.25rem 0 0;
    color: rgb(51 65 85);
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .dark .hero-intro {
    color: rgb(203 213 225);
  }

  .home-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.45rem;
    width: min(100%, 47rem);
    margin-top: 1.5rem;
    padding: 0.45rem;
  }

  .home-search input {
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0 0.75rem;
    color: rgb(15 23 42);
    font-size: 0.95rem;
    outline: none;
  }

  .home-search input::placeholder {
    color: rgb(100 116 139);
  }

  .dark .home-search input {
    color: rgb(241 245 249);
  }

  .dark .home-search input::placeholder {
    color: rgb(148 163 184);
  }

  .hero-actions,
  .hero-focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    min-width: 0;
    max-width: 100%;
    margin-top: 0.9rem;
  }

  .hero-focus {
    margin-top: 1rem;
  }

  .hero-focus span {
    display: inline-flex;
    align-items: center;
    min-height: 2.15rem;
    border: 1px solid rgb(15 23 42 / 0.08);
    border-radius: 8px;
    padding: 0.45rem 0.7rem;
    color: rgb(51 65 85);
    background: rgb(255 255 255 / 0.28);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .dark .hero-focus span {
    border-color: rgb(255 255 255 / 0.1);
    color: rgb(203 213 225);
    background: rgb(15 23 42 / 0.28);
  }

  .command-panel {
    padding: clamp(1rem, 2.5vw, 1.35rem);
  }

  .metric-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55rem;
    margin-bottom: 1rem;
  }

  .metric-cell {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(15 23 42 / 0.08);
    border-radius: 8px;
    padding: 0.72rem 0.62rem;
    background:
      radial-gradient(150px circle at 28% 12%, var(--tone-glow, rgb(20 184 166 / 0.16)), transparent 66%),
      rgb(255 255 255 / 0.22);
  }

  .metric-cell[data-tone='cyan'] {
    --tone-glow: rgb(6 182 212 / 0.2);
  }

  .metric-cell[data-tone='green'] {
    --tone-glow: rgb(34 197 94 / 0.18);
  }

  .metric-cell[data-tone='amber'] {
    --tone-glow: rgb(245 158 11 / 0.2);
  }

  .metric-cell[data-tone='rose'] {
    --tone-glow: rgb(244 63 94 / 0.16);
  }

  .dark .metric-cell {
    border-color: rgb(255 255 255 / 0.08);
    background:
      radial-gradient(150px circle at 28% 12%, var(--tone-glow, rgb(45 212 191 / 0.12)), transparent 66%),
      rgb(15 23 42 / 0.22);
  }

  .metric-value {
    display: block;
    color: rgb(9 13 18);
    font-size: 1.82rem;
    font-weight: 950;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .metric-label {
    display: block;
    margin-top: 0.45rem;
    color: rgb(71 85 105);
    font-size: 0.72rem;
    font-weight: 780;
  }

  .dark .metric-value {
    color: rgb(248 250 252);
  }

  .dark .metric-label {
    color: rgb(148 163 184);
  }

  .console-feed {
    display: grid;
    gap: 0.45rem;
  }

  .feed-row {
    display: grid;
    grid-template-columns: 7.6rem minmax(0, 1fr);
    gap: 0.72rem;
    align-items: center;
    border-radius: 8px;
    padding: 0.62rem 0.66rem;
    text-decoration: none;
  }

  .feed-row:hover {
    background: rgb(255 255 255 / 0.24);
  }

  .dark .feed-row:hover {
    background: rgb(255 255 255 / 0.06);
  }

  .feed-date {
    color: rgb(100 116 139);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }

  .feed-title {
    overflow: hidden;
    color: rgb(15 23 42);
    font-size: 0.92rem;
    font-weight: 820;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dark .feed-date {
    color: rgb(148 163 184);
  }

  .dark .feed-title {
    color: rgb(226 232 240);
  }

  .lane-grid,
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    min-width: 0;
  }

  .lane-card {
    display: grid;
    gap: 0.65rem;
    min-height: 13rem;
    padding: 1.2rem;
    color: inherit;
    text-decoration: none;
  }

  .lane-card strong {
    color: rgb(15 23 42);
    font-size: 1.35rem;
    font-weight: 930;
    line-height: 1.12;
  }

  .lane-card p {
    margin: 0;
    color: rgb(71 85 105);
    font-size: 0.92rem;
    line-height: 1.72;
  }

  .lane-count {
    align-self: end;
    color: rgb(15 118 110);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .dark .lane-card strong {
    color: rgb(248 250 252);
  }

  .dark .lane-card p {
    color: rgb(148 163 184);
  }

  .dark .lane-count {
    color: rgb(94 234 212);
  }

  .workbench-grid,
  .navigation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    min-width: 0;
  }

  .timeline-list,
  .todo-list {
    display: grid;
    gap: 0.9rem;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .timeline-dot {
    position: relative;
    top: 0.2rem;
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid rgb(20 184 166);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.8);
    box-shadow: 0 0 0 5px rgb(20 184 166 / 0.12);
  }

  .timeline-dot::after {
    content: '';
    position: absolute;
    top: 0.75rem;
    left: 50%;
    width: 1px;
    height: calc(100% + 3.1rem);
    background: linear-gradient(rgb(20 184 166 / 0.28), rgb(245 158 11 / 0.18));
    transform: translateX(-50%);
  }

  .timeline-item:last-child .timeline-dot::after {
    display: none;
  }

  .timeline-dot.done {
    border-color: rgb(34 197 94);
    box-shadow: 0 0 0 5px rgb(34 197 94 / 0.12);
  }

  .timeline-dot.active {
    border-color: rgb(245 158 11);
    box-shadow: 0 0 0 5px rgb(245 158 11 / 0.14);
  }

  .dark .timeline-dot {
    background: rgb(15 23 42 / 0.82);
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .timeline-head h3 {
    margin: 0;
    color: rgb(15 23 42);
    font-size: 0.95rem;
    font-weight: 850;
  }

  .timeline-item p {
    margin: 0.35rem 0 0;
    color: rgb(71 85 105);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .dark .timeline-head h3 {
    color: rgb(241 245 249);
  }

  .dark .timeline-item p {
    color: rgb(148 163 184);
  }

  .status-pill {
    border-radius: 999px;
    padding: 0.13rem 0.45rem;
    font-size: 0.68rem;
    font-weight: 850;
  }

  .status-pill.done {
    color: rgb(22 101 52);
    background: rgb(220 252 231 / 0.78);
  }

  .status-pill.active {
    color: rgb(146 64 14);
    background: rgb(254 243 199 / 0.82);
  }

  .status-pill.planned {
    color: rgb(71 85 105);
    background: rgb(226 232 240 / 0.78);
  }

  .dark .status-pill.done {
    color: rgb(134 239 172);
    background: rgb(22 101 52 / 0.28);
  }

  .dark .status-pill.active {
    color: rgb(253 186 116);
    background: rgb(154 52 18 / 0.26);
  }

  .dark .status-pill.planned {
    color: rgb(203 213 225);
    background: rgb(71 85 105 / 0.28);
  }

  .todo-item {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    border-radius: 8px;
    padding: 0.62rem 0.65rem;
    color: rgb(51 65 85);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .todo-item:hover {
    background: rgb(255 255 255 / 0.22);
  }

  .dark .todo-item {
    color: rgb(203 213 225);
  }

  .dark .todo-item:hover {
    background: rgb(255 255 255 / 0.06);
  }

  .todo-check {
    position: relative;
    top: 0.22rem;
    width: 1rem;
    height: 1rem;
    border: 1px solid rgb(100 116 139 / 0.6);
    border-radius: 4px;
    background: rgb(255 255 255 / 0.36);
  }

  .todo-check.done {
    border-color: rgb(20 184 166);
    background: rgb(20 184 166);
  }

  .todo-check.done::after {
    content: '';
    position: absolute;
    top: 0.16rem;
    left: 0.29rem;
    width: 0.32rem;
    height: 0.55rem;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .todo-item .is-done {
    color: rgb(100 116 139);
    text-decoration: line-through;
  }

  .content-section {
    display: grid;
    gap: 1rem;
  }

  .post-card-wrapper {
    perspective: 900px;
  }

  .post-card-wrapper.reveal {
    transition-delay: var(--reveal-delay, 0ms);
  }

  @media (max-width: 1080px) {
    .home-command {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-bg-decoration {
      right: -2rem;
      width: 70%;
      opacity: 0.5;
    }

    .command-panel {
      max-width: 100%;
    }
  }

  @media (max-width: 900px) {
    .lane-grid,
    .recent-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .hero-bg-decoration {
      display: none;
    }

    .home-stage {
      gap: 1rem;
    }

    .home-command {
      padding-top: 1.6rem;
    }

    .hero-core h1 {
      font-size: 2.62rem;
      line-height: 0.98;
    }

    .hero-intro {
      font-size: 0.96rem;
    }

    .home-search {
      grid-template-columns: 1fr;
    }

    .home-search input {
      min-height: 2.7rem;
    }

    .hero-actions,
    .hero-focus {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }

    .hero-focus span {
      justify-content: center;
      text-align: center;
    }

    .metric-strip,
    .lane-grid,
    .workbench-grid,
    .navigation-grid,
    .recent-grid {
      grid-template-columns: 1fr;
    }

    .feed-row {
      grid-template-columns: 1fr;
      gap: 0.18rem;
    }

    .feed-title {
      white-space: normal;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Sphere Cluster Background (Three.js) ──
  (async function initSphereBg() {
    const container = document.getElementById('hero-bg');
    if (!container || window.matchMedia('(max-width: 720px)').matches || reducedMotion) return;

    const THREE = await import('three');

    function isDark() { return document.documentElement.classList.contains('dark'); }

    const rect = container.getBoundingClientRect();
    if (rect.width < 50 || rect.height < 50) return;

    // ── Scene ──
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, rect.width / rect.height, 0.1, 30);
    camera.position.set(1, 0.5, 5.5);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(rect.width, rect.height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;
    container.appendChild(renderer.domElement);

    // ── Lights ──
    scene.add(new THREE.AmbientLight('#ffffff', 0.5));
    const dir = new THREE.DirectionalLight('#ffffff', 0.7);
    dir.position.set(3, 4, 5); scene.add(dir);
    const fill = new THREE.DirectionalLight('#38bdf8', 0.3);
    fill.position.set(-2, -1, -3); scene.add(fill);

    // ── Sphere cluster (Fibonacci distribution) ──
    const count = 120;
    const clusterR = 2.2;
    const sphereGeo = new THREE.SphereGeometry(0.1, 8, 6);
    const spheres: THREE.Mesh[] = [];
    const basePositions: { x: number; y: number; z: number }[] = [];

    const phi = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < count; i++) {
      const y = 1 - (i / (count - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const theta = phi * i;
      const p = { x: clusterR * r * Math.cos(theta), y: clusterR * y, z: clusterR * r * Math.sin(theta) };
      basePositions.push(p);

      const mat = new THREE.MeshStandardMaterial({
        color: isDark() ? '#4b5563' : '#7dd3fc',
        emissive: isDark() ? '#1e293b' : '#0369a1',
        emissiveIntensity: 0.15,
        roughness: 0.2,
        metalness: 0.1,
        transparent: true,
        opacity: isDark() ? 0.6 : 0.55,
      });
      const m = new THREE.Mesh(sphereGeo, mat);
      m.position.set(p.x, p.y, p.z);
      spheres.push(m);
    }

    const group = new THREE.Group();
    spheres.forEach((s) => group.add(s));
    scene.add(group);

    // ── Outer glow ring (subtle) ──
    const ringGeo = new THREE.RingGeometry(2.3, 2.8, 48);
    const ringMat = new THREE.MeshBasicMaterial({
      color: isDark() ? '#14b8a6' : '#38bdf8',
      transparent: true, opacity: 0.06,
      side: THREE.DoubleSide,
      depthWrite: false,
    });
    const ring = new THREE.Mesh(ringGeo, ringMat);
    ring.rotation.x = -0.3;
    ring.position.z = -0.2;
    group.add(ring);

    // ── Mouse tracking (document-level) ──
    let mx = 0, my = 0;
    document.addEventListener('pointermove', (e) => {
      mx = (e.clientX / window.innerWidth) * 2 - 1;
      my = -(e.clientY / window.innerHeight) * 2 + 1;
    }, { passive: true });

    // ── Hover-like interaction ──
    let hoverIndex = -1;
    let hoverSmooth = 0;

    // ── Observers ──
    const themeObs = new MutationObserver(() => {
      const dk = isDark();
      const c = dk ? '#4b5563' : '#7dd3fc';
      const e = dk ? '#1e293b' : '#0369a1';
      spheres.forEach((s, i) => {
        if (i !== hoverIndex) {
          const m = s.material as THREE.MeshStandardMaterial;
          m.color.set(c); m.emissive.set(e);
        }
      });
      ringMat.color.set(dk ? '#14b8a6' : '#38bdf8');
    });
    themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    const resizeObs = new ResizeObserver(() => {
      const r = container.getBoundingClientRect();
      if (r.width < 50 || r.height < 50) return;
      camera.aspect = r.width / r.height; camera.updateProjectionMatrix();
      renderer.setSize(r.width, r.height);
    });
    resizeObs.observe(container);

    let sceneActive = true;
    const visObs = new IntersectionObserver(([e]) => { sceneActive = e.isIntersecting; }, { threshold: 0.1 });
    visObs.observe(container);

    // ── Animation ──
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      if (!sceneActive) { renderer.render(scene, camera); return; }

      const t = clock.getElapsedTime();

      // Stable slow rotation + subtle mouse tilt
      group.rotation.y += 0.003;
      group.rotation.x += (mx * 0.05 - group.rotation.x) * 0.015;
      group.rotation.z += (-my * 0.03 - group.rotation.z) * 0.015;

      // Ring pulsing
      ring.scale.setScalar(1 + Math.sin(t * 0.5) * 0.03);

      // Project mouse to 3D to find nearest sphere
      const mouse3D = new THREE.Vector3(mx * 3, my * 2 + 0.5, 0);
      let minDist = Infinity;
      let closest = -1;
      spheres.forEach((s, i) => {
        const wp = new THREE.Vector3();
        s.getWorldPosition(wp);
        const d = wp.distanceTo(mouse3D);
        if (d < minDist) { minDist = d; closest = i; }
      });

      hoverIndex = minDist < 2.5 ? closest : -1;
      hoverSmooth += ((hoverIndex >= 0 ? 1 : 0) - hoverSmooth) * 0.05;

      const normalC = isDark() ? '#4b5563' : '#7dd3fc';
      const normalE = isDark() ? '#1e293b' : '#0369a1';
      spheres.forEach((s, i) => {
        const isHover = i === hoverIndex && hoverSmooth > 0.1;
        const targetScale = isHover ? 2.8 : 1;
        const sc = s.scale.x + (targetScale - s.scale.x) * 0.06;
        s.scale.set(sc, sc, sc);
        const m = s.material as THREE.MeshStandardMaterial;
        if (isHover) {
          m.color.set('#14b8a6');
          m.emissive.set('#0d9488');
          m.emissiveIntensity = 0.4;
          m.opacity = 0.9;
        } else {
          const fade = hoverSmooth;
          // Nearby spheres get a hint of glow
          const dist = i === hoverIndex ? 0 : Infinity;
          m.color.set(normalC);
          m.emissive.set(normalE);
          m.emissiveIntensity = 0.15;
          m.opacity = isDark() ? 0.6 : 0.55;
        }
      });

      renderer.render(scene, camera);
    }
    animate();
  })();

  // ── Scroll Reveal ──
  // Handled by BaseLayout globally.

  (function initCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.counter');
    if (!counters.length) return;

    const runCounter = (element: HTMLElement) => {
      const target = Number.parseInt(element.dataset.target || '0', 10);
      if (!Number.isFinite(target)) return;
      if (reducedMotion) {
        element.textContent = String(target);
        return;
      }

      const duration = 1050;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        element.textContent = String(Math.round(eased * target));
        if (progress < 1) requestAnimationFrame(tick);
        else element.textContent = String(target);
      };
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        runCounter(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.5 });

    counters.forEach((counter) => observer.observe(counter));
  })();

</script>
