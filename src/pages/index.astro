---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryList from '../components/CategoryList.astro';
import PostCard from '../components/PostCard.astro';
import TagList from '../components/TagList.astro';
import TiltedCard from '../components/TiltedCard';
import HeroScene from '../components/HeroScene';
import { getCollection } from 'astro:content';

const allPosts = [
  ...(await getCollection('blog')).map((p) => ({ ...p, path: `/blog/${p.slug}` })),
  ...(await getCollection('notes')).map((p) => ({ ...p, path: `/notes/${p.slug}` })),
  ...(await getCollection('important')).map((p) => ({ ...p, path: `/important/${p.slug}` })),
];

const published = allPosts.filter((p) => !p.data.draft);
const sorted = published.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recent = sorted.slice(0, 6);

const blogCount = published.filter((p) => p.data.type === 'blog').length;
const noteCount = published.filter((p) => p.data.type === 'note').length;
const importantCount = published.filter((p) => p.data.type === 'important').length;

const tags = Array.from(
  new Set(published.flatMap((p) => p.data.tags).map((t) => t.toLowerCase()))
).sort();

const categories = Array.from(
  new Set(published.map((p) => p.data.category.toLowerCase()).filter(Boolean))
).sort();

const planPost = (await getCollection('important')).find((p) => p.slug === 'long-term-plan');
const todoPost = (await getCollection('important')).find((p) => p.slug === 'short-term-todo');
const longTermPlan = planPost?.data.plan ?? [];
const shortTermTodos = todoPost?.data.todos ?? [];

const totalCount = published.length;

const primaryActions = [
  { label: '博客', href: '/blog', style: 'btn-secondary' },
  { label: '笔记', href: '/notes', style: 'btn-secondary' },
  { label: '重要记录', href: '/important', style: 'btn-secondary' },
  { label: '写作入口', href: '/editor', style: 'btn-primary' },
];

const contentLanes = [
  {
    title: '长文系统',
    eyebrow: 'Blog',
    href: '/blog',
    count: blogCount,
    summary: '放系统设计、技术复盘和完整研究脉络，适合需要反复回看的内容。',
  },
  {
    title: '短笔记流',
    eyebrow: 'Notes',
    href: '/notes',
    count: noteCount,
    summary: '记录命令、坑点、片段和临时灵感，保持轻量、可检索。',
  },
  {
    title: '重要记录',
    eyebrow: 'Important',
    href: '/important',
    count: importantCount,
    summary: '沉淀配置、计划、决策和关键变更，方便长期追踪。',
  },
];

const focusAreas = ['Computer Vision', 'SLAM / 3DGS', 'Tooling', 'Research Notes'];
---

<BaseLayout title="山不见我" description="技术笔记 · 长期写作 · 可迁移的个人站点">
  <div class="home-stage" transition:animate="slide">
    <div class="hero-bg-wrap">
    <HeroScene client:only="react" />
    <section class="hero-section reveal" aria-labelledby="home-title">
      <p class="hero-eyebrow">Personal Knowledge OS — 共 {totalCount} 篇内容</p>
      <h1 id="home-title">山不见我</h1>
      <p class="hero-intro">
        技术长文、短笔记和重要记录统一沉淀在静态内容库里。第一屏直接服务于检索、进入内容和继续写作。
      </p>

      <form class="home-search" action="/search" method="get" role="search">
        <label for="home-q" class="sr-only">搜索站内内容</label>
        <input
          id="home-q"
          name="q"
          type="search"
          placeholder="搜索标题、摘要、标签或分类"
          autocomplete="off"
        />
        <button type="submit" class="btn-primary">搜索</button>
      </form>

      <div class="hero-actions">
        {primaryActions.map((action) => (
          <a href={action.href} class={action.style}>{action.label}</a>
        ))}
      </div>

      <div class="hero-focus" aria-label="关注方向">
        {focusAreas.map((area) => (
          <span>{area}</span>
        ))}
      </div>
    </section>
    </div>

    <section class="lane-grid" aria-label="内容入口">
      {contentLanes.map((lane, index) => (
        <TiltedCard tiltDegree={6} client:load>
          <a
            href={lane.href}
            class={`lane-card card reveal reveal-delay-${Math.min(index + 1, 3)}`}
          >
            <span class="lane-eyebrow">{lane.eyebrow}</span>
            <strong>{lane.title}</strong>
            <p>{lane.summary}</p>
            <span class="lane-count">{lane.count} 条内容</span>
          </a>
        </TiltedCard>
      ))}
    </section>

    <section class="workbench-grid" aria-label="计划与待办">
      <article class="card reveal">
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Roadmap</p>
            <h2>长期计划</h2>
          </div>
          <a
            href="https://github.com/Djl1n/blogs/edit/main/src/content/important/long-term-plan.md"
            target="_blank"
            class="btn-secondary"
          >编辑</a>
        </div>

        {longTermPlan.length > 0 ? (
          <div class="timeline-list">
            {longTermPlan.map((item) => (
              <div class="timeline-item">
                <span class={`timeline-dot ${item.status}`}></span>
                <div>
                  <div class="timeline-head">
                    <h3>{item.title}</h3>
                    <span class={`status-pill ${item.status}`}>
                      {item.status === 'done' ? '已完成' : item.status === 'active' ? '进行中' : '计划中'}
                    </span>
                  </div>
                  <p>{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-copy">暂无计划。在 long-term-plan.md 中添加 plan 条目即可。</p>
        )}
      </article>

      <article class="card reveal reveal-delay-1">
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Now</p>
            <h2>短期待办</h2>
          </div>
          <a
            href="https://github.com/Djl1n/blogs/edit/main/src/content/important/short-term-todo.md"
            target="_blank"
            class="btn-secondary"
          >编辑</a>
        </div>

        {shortTermTodos.length > 0 ? (
          <div class="todo-list">
            {shortTermTodos.map((item) => (
              <div class="todo-item">
                <span class={`todo-check ${item.done ? 'done' : ''}`} aria-hidden="true"></span>
                <span class={item.done ? 'is-done' : ''}>{item.text}</span>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-copy">暂无待办。在 short-term-todo.md 中添加 todos 条目即可。</p>
        )}
      </article>
    </section>

    <section class="content-section">
      <div class="section-heading">
        <div>
          <p class="panel-eyebrow">Recent</p>
          <h2>最近更新</h2>
        </div>
        {published.length > 6 && (
          <a href="/blog" class="btn-secondary">查看全部 {published.length} 篇</a>
        )}
      </div>

      <div class="recent-grid">
        {recent.map((post, i) => (
          <div class="post-card-wrapper reveal" style={`--reveal-delay: ${120 + (i % 6) * 80}ms`}>
            <PostCard item={post} href={post.path} />
          </div>
        ))}
      </div>
    </section>

    <section class="navigation-grid" aria-label="快速导航">
      <article class="card reveal">
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Index</p>
            <h2>分类</h2>
          </div>
          <a href="/categories" class="btn-secondary">全部</a>
        </div>
        <CategoryList categories={categories} />
      </article>

      <article class="card reveal reveal-delay-1">
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Tags</p>
            <h2>标签</h2>
          </div>
          <a href="/tags" class="btn-secondary">全部</a>
        </div>
        <TagList tags={tags} />
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .home-stage {
    display: grid;
    gap: 1.2rem;
    min-width: 0;
  }

  /* ── Hero background wrapper ── */
  .hero-bg-wrap {
    position: relative;
    overflow: hidden;
  }

  /* ── Hero section ── */
  .hero-section {
    min-height: min(480px, calc(100vh - 9rem));
    padding: clamp(2rem, 5vw, 4rem) 0 1.5rem;
  }

  .hero-eyebrow {
    margin: 0;
    color: #8E9B8E;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dark .hero-eyebrow {
    color: #7A8B7A;
  }

  .hero-section h1 {
    margin: 0.65rem 0 0;
    color: #3D404A;
    font-family: 'Noto Serif SC', 'Source Han Serif SC', serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.05em;
  }

  .dark .hero-section h1 {
    color: #E5E5E5;
  }

  .hero-intro {
    max-width: 42rem;
    margin: 0.85rem 0 0;
    color: #8A8F99;
    font-size: 1rem;
    line-height: 1.75;
  }

  .dark .hero-intro {
    color: #8A8F99;
  }

  .home-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.45rem;
    width: min(100%, 36rem);
    margin-top: 1.5rem;
    border: 1px solid #E0DDD5;
    border-radius: 0.75rem;
    background: #FFFFFF;
    padding: 0.4rem;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }
  .home-search:focus-within {
    border-color: #8E9B8E;
    box-shadow: 0 0 0 2px rgba(142, 155, 142, 0.2);
  }

  .home-search input {
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0 0.75rem;
    color: #3D404A;
    font-size: 0.9rem;
    outline: none;
  }
  .home-search input::placeholder {
    color: #8A8F99;
  }

  .dark .home-search {
    border-color: #33353B;
    background: #25272D;
  }
  .dark .home-search:focus-within {
    border-color: #7A8B7A;
    box-shadow: 0 0 0 2px rgba(122, 139, 122, 0.2);
  }
  .dark .home-search input {
    color: #E5E5E5;
  }
  .dark .home-search input::placeholder {
    color: #8A8F99;
  }

  .hero-actions,
  .hero-focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.85rem;
  }

  .hero-focus {
    margin-top: 1rem;
  }

  .hero-focus span {
    display: inline-flex;
    align-items: center;
    border: 1px solid #E0DDD5;
    border-radius: 6px;
    padding: 0.35rem 0.65rem;
    color: #8A8F99;
    background: #FFFFFF;
    font-size: 0.78rem;
    font-weight: 550;
  }

  .dark .hero-focus span {
    border-color: #33353B;
    color: #8A8F99;
    background: #25272D;
  }

  /* ── Content lane cards ── */
  .lane-grid,
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    min-width: 0;
  }

  .lane-card {
    display: grid;
    gap: 0.5rem;
    min-height: 11rem;
    color: inherit;
    text-decoration: none;
  }

  .lane-eyebrow {
    margin: 0;
    color: #8E9B8E;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dark .lane-eyebrow {
    color: #7A8B7A;
  }

  .lane-card strong {
    color: #3D404A;
    font-size: 1.2rem;
    font-weight: 750;
    line-height: 1.15;
  }

  .lane-card p {
    margin: 0;
    color: #8A8F99;
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .lane-count {
    align-self: end;
    color: #8E9B8E;
    font-size: 0.78rem;
    font-weight: 650;
  }

  .dark .lane-card strong {
    color: #E5E5E5;
  }
  .dark .lane-card p {
    color: #8A8F99;
  }
  .dark .lane-count {
    color: #7A8B7A;
  }

  /* ── Workbench & navigation grids ── */
  .workbench-grid,
  .navigation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    min-width: 0;
  }

  .panel-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .panel-heading h2 {
    margin: 0.15rem 0 0;
    color: #3D404A;
    font-family: 'Noto Serif SC', 'Source Han Serif SC', serif;
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .dark .panel-heading h2 {
    color: #E5E5E5;
  }

  .panel-eyebrow {
    margin: 0;
    color: #8E9B8E;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dark .panel-eyebrow {
    color: #7A8B7A;
  }

  /* ── Timeline ── */
  .timeline-list,
  .todo-list {
    display: grid;
    gap: 0.8rem;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.65rem;
  }

  .timeline-dot {
    position: relative;
    top: 0.2rem;
    width: 0.6rem;
    height: 0.6rem;
    border: 2px solid #8E9B8E;
    border-radius: 999px;
    background: #FFFFFF;
    box-shadow: 0 0 0 4px rgba(142, 155, 142, 0.1);
  }

  .timeline-dot::after {
    content: '';
    position: absolute;
    top: 0.65rem;
    left: 50%;
    width: 1px;
    height: calc(100% + 2.8rem);
    background: #E0DDD5;
    transform: translateX(-50%);
  }

  .timeline-item:last-child .timeline-dot::after {
    display: none;
  }

  .timeline-dot.done {
    border-color: rgb(34 197 94);
    box-shadow: 0 0 0 4px rgb(34 197 94 / 0.1);
  }
  .timeline-dot.active {
    border-color: rgb(245 158 11);
    box-shadow: 0 0 0 4px rgb(245 158 11 / 0.12);
  }

  .dark .timeline-dot {
    background: #25272D;
  }
  .dark .timeline-dot::after {
    background: #33353B;
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .timeline-head h3 {
    margin: 0;
    color: #3D404A;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .timeline-item p {
    margin: 0.3rem 0 0;
    color: #8A8F99;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .dark .timeline-head h3 {
    color: #E5E5E5;
  }
  .dark .timeline-item p {
    color: #8A8F99;
  }

  .status-pill {
    border-radius: 999px;
    padding: 0.1rem 0.4rem;
    font-size: 0.65rem;
    font-weight: 700;
  }
  .status-pill.done {
    color: rgb(22 101 52);
    background: rgb(220 252 231);
  }
  .status-pill.active {
    color: rgb(146 64 14);
    background: rgb(254 243 199);
  }
  .status-pill.planned {
    color: #3D404A;
    background: #EAE8E1;
  }

  .dark .status-pill.done {
    color: rgb(134 239 172);
    background: rgb(22 101 52 / 0.25);
  }
  .dark .status-pill.active {
    color: rgb(253 186 116);
    background: rgb(154 52 18 / 0.25);
  }
  .dark .status-pill.planned {
    color: #E5E5E5;
    background: #2D2F35;
  }

  /* ── Todo ── */
  .todo-item {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: start;
    border-radius: 6px;
    padding: 0.55rem 0.6rem;
    color: #8A8F99;
    font-size: 0.88rem;
    line-height: 1.6;
    transition: background 150ms ease;
  }
  .todo-item:hover {
    background: #F4F3EF;
  }

  .dark .todo-item {
    color: #8A8F99;
  }
  .dark .todo-item:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .todo-check {
    position: relative;
    top: 0.2rem;
    width: 0.9rem;
    height: 0.9rem;
    border: 1px solid rgba(138, 143, 153, 0.5);
    border-radius: 3px;
    background: #FFFFFF;
  }
  .todo-check.done {
    border-color: #8E9B8E;
    background: #8E9B8E;
  }
  .todo-check.done::after {
    content: '';
    position: absolute;
    top: 0.12rem;
    left: 0.25rem;
    width: 0.28rem;
    height: 0.48rem;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .todo-item .is-done {
    color: #8A8F99;
    text-decoration: line-through;
  }

  .dark .todo-check {
    background: #25272D;
    border-color: rgba(138, 143, 153, 0.4);
  }

  /* ── Content section ── */
  .content-section {
    display: grid;
    gap: 1rem;
  }

  .section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.2rem;
  }

  .section-heading h2 {
    margin: 0.15rem 0 0;
    color: #3D404A;
    font-family: 'Noto Serif SC', 'Source Han Serif SC', serif;
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .dark .section-heading h2 {
    color: #E5E5E5;
  }

  .post-card-wrapper.reveal {
    transition-delay: var(--reveal-delay, 0ms);
  }

  @media (max-width: 1080px) {
    .hero-section {
      min-height: auto;
    }
  }

  @media (max-width: 900px) {
    .lane-grid,
    .recent-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .hero-section h1 {
      font-size: 2rem;
    }
    .hero-intro {
      font-size: 0.92rem;
    }
    .home-search {
      grid-template-columns: 1fr;
    }
    .home-search input {
      min-height: 2.5rem;
    }
    .hero-actions,
    .hero-focus {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }
    .hero-focus span {
      justify-content: center;
      text-align: center;
    }
    .lane-grid,
    .workbench-grid,
    .navigation-grid,
    .recent-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
