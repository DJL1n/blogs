---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagList from '../components/TagList.astro';
import CategoryList from '../components/CategoryList.astro';
import { getCollection } from 'astro:content';

const rawPosts = [
  ...(await getCollection('blog')).map((post) => ({ ...post, path: `/blog/${post.slug}` })),
  ...(await getCollection('notes')).map((post) => ({ ...post, path: `/notes/${post.slug}` })),
  ...(await getCollection('important')).map((post) => ({ ...post, path: `/important/${post.slug}` }))
];

const posts = rawPosts
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 8);

const tags = Array.from(
  new Set(rawPosts.flatMap((p) => p.data.tags).map((tag) => tag.toLowerCase()))
).sort();

const categories = Array.from(new Set(rawPosts.map((post) => post.data.category.toLowerCase()))).sort();
---

<BaseLayout title="个人知识库博客" description="技巧/短笔记/重要记录">
  <section class="space-y-10">
    <header class="surface-card">
      <p class="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700 dark:bg-slate-800 dark:text-blue-200">知识管理系统 v1</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-slate-900 dark:text-slate-100">个人知识库博客</h1>
      <p class="mt-3 text-slate-600 dark:text-slate-300">
        聚合技术技巧、短笔记和重要记录，支持分类、标签、搜索，适合长期维护和持续写作。
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href="/blog" class="inline-flex rounded-md border border-blue-200 bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500">查看博客</a>
        <a href="/notes" class="inline-flex rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">查看笔记</a>
        <a href="/important" class="inline-flex rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-100 dark:border-emerald-800 dark:bg-slate-900 dark:text-emerald-200">查看重要事项</a>
      </div>
    </header>

    <section>
      <h2 class="mb-4 text-2xl font-semibold">最近更新</h2>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {posts.map((post) => <PostCard item={post} href={post.path} />)}
      </div>
    </section>

    <section>
      <h2 class="mb-4 text-2xl font-semibold">分类</h2>
      <div class="surface-card">
        <CategoryList categories={categories} />
      </div>
    </section>

    <section>
      <h2 class="mb-4 text-2xl font-semibold">标签</h2>
      <div class="surface-card">
        <TagList tags={tags} />
      </div>
    </section>
  </section>
</BaseLayout>
