---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="关于 · 山不见我" description="关于我和这个站点">
  <div class="page-stack">
    <PageHeader
      eyebrow="About"
      title="关于我"
      description="一个写代码的人，目前在计算机视觉、SLAM、三维重建方向摸索。这个站点是长期知识管理空间，不追求流量，只追求清晰、稳定和可迁移。"
      meta={['Computer Vision', 'SLAM', '3D Reconstruction']}
      actions={[
        { label: 'GitHub', href: 'https://github.com/Djl1n', primary: true },
        { label: 'RSS', href: '/rss.xml' },
      ]}
    />

    <section class="about-grid">
      <article class="liquid-panel reveal" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Focus</p>
            <h2>技术方向</h2>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <span class="chip-active">Computer Vision</span>
          <span class="chip-active">SLAM</span>
          <span class="chip-active">3D Reconstruction</span>
          <span class="chip-active">3DGS / NeRF</span>
          <span class="chip-emerald">Python</span>
          <span class="chip-emerald">C++</span>
          <span class="chip">Git</span>
          <span class="chip">Astro</span>
          <span class="chip">Tailwind CSS</span>
        </div>
      </article>

      <article class="liquid-panel reveal reveal-delay-1" data-liquid-panel data-tilt>
        <div class="panel-heading">
          <div>
            <p class="panel-eyebrow">Site</p>
            <h2>站点结构</h2>
          </div>
        </div>
        <div class="about-copy">
          <p>
            基于 <a href="https://astro.build">Astro</a> 构建，所有内容以 Markdown 文件存储在
            <code>src/content/</code> 下。
          </p>
          <p>
            内容分为博客、短笔记和重要记录三类，站点保持静态架构，方便迁移和长期维护。
          </p>
          <p>
            托管在 <a href="https://github.com/Djl1n/blogs">GitHub</a>，通过 Cloudflare Pages 自动部署。
          </p>
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 1rem;
  }

  .about-copy {
    display: grid;
    gap: 0.85rem;
    color: rgb(71 85 105);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .about-copy p {
    margin: 0;
  }

  .about-copy a {
    color: rgb(15 118 110);
    font-weight: 800;
    text-decoration: none;
  }

  .about-copy a:hover {
    text-decoration: underline;
  }

  .about-copy code {
    border-radius: 6px;
    background: rgb(15 23 42 / 0.07);
    padding: 0.12rem 0.36rem;
    font-size: 0.84em;
  }

  :global(.dark) .about-copy {
    color: rgb(203 213 225);
  }

  :global(.dark) .about-copy a {
    color: rgb(94 234 212);
  }

  :global(.dark) .about-copy code {
    background: rgb(255 255 255 / 0.08);
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
