---
const { autofocus = false } = Astro.props as { autofocus?: boolean };
const currentQuery = Astro.url.searchParams.get('q') ?? '';
---

<form class="search-form liquid-control" role="search" action="/search" method="get">
  <label for="q" class="sr-only">搜索</label>
  <input
    id="q"
    name="q"
    type="search"
    value={currentQuery}
    placeholder="搜索标题、摘要、标签"
    autocomplete="off"
    class="search-input"
    {autofocus}
  />
  <button type="submit" class="search-submit" aria-label="执行搜索">
    <span aria-hidden="true">⌕</span>
  </button>
</form>
