<button
  id="theme-toggle"
  type="button"
  class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs transition hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:hover:bg-slate-700"
  aria-label="切换亮暗色"
>
  主题
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const root = document.documentElement;
    const updateButton = () => {
      const isDark = root.classList.contains('dark');
      btn.textContent = isDark ? '浅色' : '深色';
    };

    btn.addEventListener('click', () => {
      const isDark = root.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateButton();
    });

    updateButton();
  })();
</script>
