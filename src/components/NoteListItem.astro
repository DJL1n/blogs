---
const { item, href } = Astro.props as {
  item: {
    data: {
      title: string;
      date: Date;
      tags: string[];
      category: string;
    };
  };
  href: string;
};
---

<a href={href} class="note-list-item group card magnetic">
  <div class="row-main">
    <span class="chip">{item.data.category}</span>
    <span class="title">{item.data.title}</span>
    <span class="date">{item.data.date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
  </div>
  {item.data.tags.length > 0 && (
    <div class="row-tags">
      {item.data.tags.slice(0, 5).map((tag) => (
        <span class="tag">#{tag}</span>
      ))}
    </div>
  )}
</a>

<style>
  .note-list-item {
    display: block;
    position: relative;
    text-decoration: none;
    color: inherit;
    border-left: 3px solid transparent;
    transition:
      background 180ms ease,
      border-left-color 180ms ease;
    margin-bottom: 0;
  }

  .note-list-item:hover {
    border-left-color: #8E9B8E;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .note-list-item:focus-visible {
    border-left-color: #8E9B8E;
    outline: none;
  }

  .row-main {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .row-main .title {
    flex: 1;
    min-width: 0;
    font-weight: 600;
    font-size: 0.925rem;
    color: #3D404A;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .note-list-item:hover .row-main .title {
    color: #737D73;
  }

  .row-main .date {
    flex-shrink: 0;
    font-size: 0.72rem;
    color: #8A8F99;
    white-space: nowrap;
    margin-left: auto;
  }

  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.2rem;
    padding-left: 0;
  }

  .row-tags .tag {
    display: inline-flex;
    align-items: center;
    font-size: 0.68rem;
    color: #8A8F99;
    font-weight: 500;
    line-height: 1.3;
  }

  .row-tags .tag:not(:last-child)::after {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #E0DDD5;
    margin: 0 0.2rem 0 0.35rem;
    vertical-align: middle;
  }

  /* ── Dark mode ── */

  .dark .note-list-item:hover {
    border-left-color: #7A8B7A;
  }

  .dark .row-main .title {
    color: #E5E5E5;
  }

  .dark .note-list-item:hover .row-main .title {
    color: #7A8B7A;
  }

  .dark .row-main .date {
    color: #8A8F99;
  }

  .dark .row-tags .tag {
    color: #8A8F99;
  }

  .dark .row-tags .tag:not(:last-child)::after {
    background: #33353B;
  }

  /* ── Mobile ── */

  @media (max-width: 620px) {
    .note-list-item {
      padding: 0.5rem;
    }

    .row-main {
      flex-wrap: wrap;
      gap: 0.3rem;
    }

    .row-main .chip {
      display: none;
    }

    .row-main .title {
      font-size: 0.875rem;
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .row-main .date {
      font-size: 0.65rem;
    }

    .row-tags {
      display: none;
    }
  }
</style>
