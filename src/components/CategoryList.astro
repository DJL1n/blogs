---
const { categories } = Astro.props as { categories: string[] };
---

<div class="flex flex-wrap gap-2">
  {categories.map((category) => (
    <a
      href={`/categories/${encodeURIComponent(category)}`}
      class="chip border-emerald-200/80 bg-emerald-50 text-emerald-700 dark:border-emerald-700 dark:bg-slate-800 dark:text-emerald-200"
    >
      {category}
    </a>
  ))}
</div>
