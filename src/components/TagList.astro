---
const { tags } = Astro.props as { tags: string[] };
---

<div class="flex flex-wrap gap-2">
  {tags.map((tag) => (
    <a
      href={`/tags/${encodeURIComponent(tag)}`}
      class="rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-sm text-blue-700 transition hover:bg-blue-100 dark:border-blue-800 dark:bg-slate-800 dark:text-blue-200"
    >
      #{tag}
    </a>
  ))}
</div>
