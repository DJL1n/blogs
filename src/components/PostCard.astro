---
const { item, href } = Astro.props as {
  item: {
    data: {
      title: string;
      date: Date;
      summary: string;
      tags: string[];
      category: string;
    };
  };
  href: string;
};
---

<article class="surface-card post-card reveal" data-liquid-panel data-tilt>
  <a href={href} class="no-underline">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <span class="chip">{item.data.category}</span>
      <span>{item.data.date.toLocaleDateString('zh-CN')}</span>
    </div>
    <h3 class="text-xl font-black leading-tight tracking-tight text-slate-950 dark:text-slate-50">{item.data.title}</h3>
    <p class="mt-3 leading-relaxed text-slate-700 dark:text-slate-300">{item.data.summary}</p>
    <p class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-300">
      {item.data.tags.map((tag) => (
        <span class="chip">#{tag}</span>
      ))}
    </p>
  </a>
</article>
