---
const { item, href } = Astro.props as {
  item: {
    data: {
      title: string;
      date: Date;
      summary: string;
      tags: string[];
      category: string;
    };
  };
  href: string;
};
---

<article class="card reveal magnetic">
  <a href={href} class="no-underline">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs" style="color: #8A8F99">
      <span class="chip">{item.data.category}</span>
      <span>{item.data.date.toLocaleDateString('zh-CN')}</span>
    </div>
    <h3 class="text-xl font-black leading-tight tracking-tight" style="color: #3D404A">{item.data.title}</h3>
    <p class="mt-3 leading-relaxed" style="color: #8A8F99">{item.data.summary}</p>
    <p class="mt-4 flex flex-wrap gap-2 text-xs" style="color: #8A8F99">
      {item.data.tags.map((tag) => (
        <span class="chip">#{tag}</span>
      ))}
    </p>
  </a>
</article>
