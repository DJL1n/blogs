---
const { item, href } = Astro.props as {
  item: {
    data: {
      title: string;
      date: Date;
      summary: string;
      tags: string[];
      category: string;
    };
  };
  href: string;
};
---

<article class="surface-card">
  <a href={href} class="no-underline">
    <div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <span class="inline-flex rounded-full bg-slate-100 px-2 py-1 dark:bg-slate-800">{item.data.category}</span>
      <span>{item.data.date.toLocaleDateString('zh-CN')}</span>
    </div>
    <h3 class="text-xl font-bold leading-tight text-slate-900 dark:text-slate-100">{item.data.title}</h3>
    <p class="mt-3 text-slate-700 dark:text-slate-200">{item.data.summary}</p>
    <p class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-300">
      {item.data.tags.map((tag) => (
        <span class="chip">#{tag}</span>
      ))}
    </p>
  </a>
</article>
