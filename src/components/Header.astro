---
import ThemeToggle from './ThemeToggle.astro';
import SearchBox from './SearchBox.astro';
---

<header class="sticky top-0 z-20 border-b border-slate-200/60 bg-white/75 backdrop-blur-xl supports-[backdrop-filter]:bg-white/60 dark:border-slate-700/60 dark:bg-slate-900/75 dark:supports-[backdrop-filter]:bg-slate-900/60">
  <div class="content-shell flex flex-wrap items-center justify-between gap-3 py-3.5">
    <a href="/" class="flex items-center gap-2.5 text-lg font-bold tracking-tight transition-colors hover:text-blue-600 dark:hover:text-blue-400">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-blue-500 to-violet-600 text-sm font-black text-white shadow-sm">K</span>
      山不见我
    </a>
    <nav class="flex flex-wrap items-center gap-1.5 text-sm">
      <a href="/blog" class="rounded-lg px-3 py-1.5 font-medium transition-colors hover:bg-slate-100 hover:text-blue-600 dark:hover:bg-slate-800 dark:hover:text-blue-300">博客</a>
      <a href="/notes" class="rounded-lg px-3 py-1.5 font-medium transition-colors hover:bg-slate-100 hover:text-blue-600 dark:hover:bg-slate-800 dark:hover:text-blue-300">笔记</a>
      <a href="/important" class="rounded-lg px-3 py-1.5 font-medium transition-colors hover:bg-slate-100 hover:text-blue-600 dark:hover:bg-slate-800 dark:hover:text-blue-300">重要</a>
      <a href="/categories" class="rounded-lg px-3 py-1.5 font-medium transition-colors hover:bg-slate-100 hover:text-blue-600 dark:hover:bg-slate-800 dark:hover:text-blue-300">分类</a>
      <a href="/tags" class="rounded-lg px-3 py-1.5 font-medium transition-colors hover:bg-slate-100 hover:text-blue-600 dark:hover:bg-slate-800 dark:hover:text-blue-300">标签</a>
      <a href="/editor" class="rounded-lg px-3 py-1.5 font-medium transition-colors hover:bg-slate-100 hover:text-blue-600 dark:hover:bg-slate-800 dark:hover:text-blue-300">写作</a>
      <a href="/search" class="rounded-lg px-3 py-1.5 font-medium transition-colors hover:bg-slate-100 hover:text-blue-600 dark:hover:bg-slate-800 dark:hover:text-blue-300">搜索</a>
      <a href="/about" class="rounded-lg px-3 py-1.5 font-medium transition-colors hover:bg-slate-100 hover:text-blue-600 dark:hover:bg-slate-800 dark:hover:text-blue-300">关于</a>
      <div class="ml-2 flex items-center gap-2">
        <SearchBox autofocus={false} />
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>
