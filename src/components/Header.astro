---
import ThemeToggle from './ThemeToggle.astro';
import SearchBox from './SearchBox.astro';
---

<header class="border-b border-slate-200 bg-white/70 backdrop-blur-sm dark:bg-slate-800/70 dark:border-slate-700">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="text-lg font-bold">知识库博客</a>
    <nav class="flex items-center gap-5 text-sm">
      <a href="/blog" class="hover:text-blue-600 dark:hover:text-blue-300">博客</a>
      <a href="/notes" class="hover:text-blue-600 dark:hover:text-blue-300">笔记</a>
      <a href="/important" class="hover:text-blue-600 dark:hover:text-blue-300">重要事项</a>
      <a href="/categories" class="hover:text-blue-600 dark:hover:text-blue-300">分类</a>
      <a href="/tags" class="hover:text-blue-600 dark:hover:text-blue-300">标签</a>
      <a href="/about" class="hover:text-blue-600 dark:hover:text-blue-300">关于</a>
      <a href="/search" class="hover:text-blue-600 dark:hover:text-blue-300">搜索</a>
      <SearchBox />
      <ThemeToggle />
    </nav>
  </div>
</header>
