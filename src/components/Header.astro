---
import ThemeToggle from './ThemeToggle.astro';
import SearchBox from './SearchBox.astro';
---

<header class="sticky top-0 z-20 border-b border-slate-200/70 bg-white/80 backdrop-blur-md dark:border-slate-700/80 dark:bg-slate-900/80">
  <div class="content-shell flex flex-wrap items-center justify-between gap-3 py-4">
    <a href="/" class="text-lg font-bold tracking-tight">知识库博客</a>
    <nav class="flex flex-wrap items-center gap-2 text-sm">
      <a href="/blog" class="rounded-md px-2 py-1 transition hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-slate-800/70 dark:hover:text-blue-300">博客</a>
      <a href="/notes" class="rounded-md px-2 py-1 transition hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-slate-800/70 dark:hover:text-blue-300">笔记</a>
      <a href="/important" class="rounded-md px-2 py-1 transition hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-slate-800/70 dark:hover:text-blue-300">重要事项</a>
      <a href="/categories" class="rounded-md px-2 py-1 transition hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-slate-800/70 dark:hover:text-blue-300">分类</a>
      <a href="/tags" class="rounded-md px-2 py-1 transition hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-slate-800/70 dark:hover:text-blue-300">标签</a>
      <a href="/editor" class="rounded-md px-2 py-1 transition hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-slate-800/70 dark:hover:text-blue-300">写作</a>
      <a href="/about" class="rounded-md px-2 py-1 transition hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-slate-800/70 dark:hover:text-blue-300">关于</a>
      <a href="/search" class="rounded-md px-2 py-1 transition hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-slate-800/70 dark:hover:text-blue-300">搜索</a>
      <SearchBox autofocus={false} />
      <ThemeToggle />
    </nav>
  </div>
</header>
